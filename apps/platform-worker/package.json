{
	"name": "@agent-infra/platform-worker",
	"private": true,
	"type": "module",
	"main": "dist/index.mjs",
	"files": [
		"dist"
	],
	"dependencies": {
		"@agent-infra/contracts": "workspace:*",
		"@agent-infra/platform-core": "workspace:*",
		"@agent-infra/platform-store": "workspace:*",
		"@agent-infra/secret-store": "workspace:*"
	},
	"scripts": {
		"build": "tsdown",
		"check-types": "pnpm --filter @agent-infra/platform-core build && pnpm --filter @agent-infra/platform-store build && tsc --noEmit",
		"dev": "tsx watch src/index.ts",
		"start": "node dist/index.mjs",
		"test": "vitest run src"
	},
	"devDependencies": {
		"@agent-infra/config": "workspace:*",
		"@types/node": "catalog:",
		"tsdown": "^0.22.14",
		"tsx": "^4.23.1",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
