{
	"name": "@agent-infra/connection-store",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./migrations": "./src/migrations.ts"
	},
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit",
		"test": "vitest run src --no-file-parallelism",
		"test:bitbucket:e2e": "tsx scripts/bitbucket-connection-e2e.ts",
		"test:confluence:e2e": "tsx scripts/confluence-connection-e2e.ts",
		"test:jira:e2e": "tsx scripts/jira-connection-e2e.ts"
	},
	"dependencies": {
		"@agent-infra/connection-core": "workspace:*",
		"drizzle-orm": "0.45.2",
		"postgres": "3.4.9"
	},
	"devDependencies": {
		"@agent-infra/config": "workspace:*",
		"@agent-infra/openconnector-adapter": "workspace:*",
		"@agent-infra/openconnector-kernel": "workspace:*",
		"tsdown": "^0.22.14",
		"tsx": "^4.23.1",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
