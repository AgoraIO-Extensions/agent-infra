{
  "components": {
    "schemas": {
      "EnterpriseDirectorySnapshotV1": {
        "additionalProperties": false,
        "properties": {
          "complete": {
            "const": true,
            "type": "boolean"
          },
          "departments": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                "name": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "type": "string"
                },
                "parentId": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "id",
                "name",
                "parentId"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "fetchedAt": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "members": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "active": {
                  "type": "boolean"
                },
                "departmentIds": {
                  "items": {
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer"
                  },
                  "minItems": 1,
                  "type": "array"
                },
                "email": {
                  "type": "string"
                },
                "userId": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "type": "string"
                }
              },
              "required": [
                "userId",
                "email",
                "active",
                "departmentIds"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "revision": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string"
          },
          "rootDepartmentId": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "schemaVersion": {
            "const": 1,
            "type": "number"
          },
          "source": {
            "const": "wecom",
            "type": "string"
          },
          "validUntil": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          }
        },
        "required": [
          "schemaVersion",
          "revision",
          "source",
          "rootDepartmentId",
          "fetchedAt",
          "validUntil",
          "complete",
          "departments",
          "members"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "DirectoryServiceBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Enterprise Directory Snapshot API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/internal/directory/snapshot": {
      "get": {
        "operationId": "readEnterpriseDirectorySnapshotV1",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnterpriseDirectorySnapshotV1"
                }
              }
            },
            "description": "Current complete snapshot"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "const": "unauthorized",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Service authentication failed"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "const": "directory_unavailable",
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "No current complete snapshot is available"
          }
        },
        "summary": "Read the current complete WeCom directory snapshot"
      }
    }
  },
  "security": [
    {
      "DirectoryServiceBearer": []
    }
  ]
}
