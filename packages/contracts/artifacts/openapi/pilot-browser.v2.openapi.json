{
  "components": {
    "schemas": {
      "PilotInternalErrorV1": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "const": "INTERNAL_ERROR",
            "type": "string"
          },
          "message": {
            "minLength": 1,
            "type": "string"
          },
          "retryable": {
            "const": true,
            "type": "boolean"
          },
          "schemaVersion": {
            "const": 1,
            "type": "number"
          },
          "traceId": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "schemaVersion",
          "message",
          "traceId",
          "code",
          "retryable"
        ],
        "type": "object"
      },
      "PilotProtocolErrorV1": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "code": {
                "enum": [
                  "AGENT_BUSY",
                  "AGENT_STARTING",
                  "AGENT_UPDATING",
                  "RUNTIME_UNAVAILABLE",
                  "CONNECTION_UNAVAILABLE",
                  "PROVIDER_RATE_LIMITED",
                  "DEPENDENCY_UNAVAILABLE",
                  "INTERNAL_ERROR"
                ],
                "type": "string"
              },
              "message": {
                "minLength": 1,
                "type": "string"
              },
              "retryable": {
                "const": true,
                "type": "boolean"
              },
              "schemaVersion": {
                "const": 1,
                "type": "number"
              },
              "traceId": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "schemaVersion",
              "message",
              "traceId",
              "code",
              "retryable"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "code": {
                "enum": [
                  "INVALID_REQUEST",
                  "AUTHENTICATION_REQUIRED",
                  "RESOURCE_UNAVAILABLE",
                  "AUTHORIZATION_REVOKED",
                  "CONVERSATION_UNAVAILABLE",
                  "EXECUTION_FAILED",
                  "MODEL_SELECTION_INVALID",
                  "CONNECTION_AUTHORIZATION_REQUIRED",
                  "ACTION_UNAVAILABLE",
                  "PROVIDER_REJECTED",
                  "DELEGATED_RESULT_REJECTED",
                  "ORIGINAL_RESPONSE_NOT_STARTED",
                  "ORIGINAL_RESPONSE_ALREADY_FINISHED"
                ],
                "type": "string"
              },
              "message": {
                "minLength": 1,
                "type": "string"
              },
              "retryable": {
                "const": false,
                "type": "boolean"
              },
              "schemaVersion": {
                "const": 1,
                "type": "number"
              },
              "traceId": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "schemaVersion",
              "message",
              "traceId",
              "code",
              "retryable"
            ],
            "type": "object"
          }
        ]
      },
      "PlatformAuditProjectionV2": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "minLength": 1,
            "type": "string"
          },
          "actor": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "displayName": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "roles": {
                    "items": {
                      "enum": [
                        "employee",
                        "system_admin"
                      ],
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "userId": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "userId",
                  "displayName",
                  "roles"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "actorId": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "kind": {
                    "const": "system",
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "actorId"
                ],
                "type": "object"
              }
            ]
          },
          "auditId": {
            "minLength": 1,
            "type": "string"
          },
          "occurredAt": {
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))[Tt](?:[01]\\d|2[0-3]):[0-5]\\d:(?:[0-5]\\d|60)(?:\\.\\d+)?(?:[Zz]|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
            "type": "string"
          },
          "result": {
            "enum": [
              "succeeded",
              "failed"
            ],
            "type": "string"
          },
          "schemaVersion": {
            "const": 2,
            "type": "number"
          },
          "subjectId": {
            "minLength": 1,
            "type": "string"
          },
          "subjectType": {
            "enum": [
              "agent_application",
              "agent",
              "configuration",
              "grant"
            ],
            "type": "string"
          },
          "summary": {
            "minLength": 1,
            "type": "string"
          },
          "traceId": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "schemaVersion",
          "auditId",
          "action",
          "actor",
          "subjectType",
          "subjectId",
          "result",
          "summary",
          "occurredAt",
          "traceId"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Agent Infra Pilot Browser Audit API",
    "version": "2.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v2/admin/audit": {
      "get": {
        "operationId": "listPlatformAuditV2",
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "items": {
                      "items": {
                        "$ref": "#/components/schemas/PlatformAuditProjectionV2"
                      },
                      "type": "array"
                    },
                    "nextCursor": {
                      "anyOf": [
                        {
                          "minLength": 1,
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "items",
                    "nextCursor"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Platform audit"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PilotProtocolErrorV1"
                }
              }
            },
            "description": "Invalid request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PilotProtocolErrorV1"
                }
              }
            },
            "description": "Authentication required"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PilotProtocolErrorV1"
                }
              }
            },
            "description": "Request is not authorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PilotProtocolErrorV1"
                }
              }
            },
            "description": "Resource is unavailable"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PilotProtocolErrorV1"
                }
              }
            },
            "description": "Request conflicts with current state"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PilotInternalErrorV1"
                }
              }
            },
            "description": "Internal error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PilotProtocolErrorV1"
                }
              }
            },
            "description": "Dependency is temporarily unavailable"
          }
        }
      }
    }
  }
}
