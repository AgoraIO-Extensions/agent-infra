                          "attempt": {
                            "maximum": 2147483647,
                            "minimum": 1,
                            "type": "integer"
                          },
                          "batchRef": {
                            "maxLength": 128,
                            "minLength": 1,
                            "pattern": "^[A-Za-z0-9._~:-]+$",
                            "type": "string"
                          },
                          "configurationRevision": {
                            "anyOf": [
                              {
                                "maximum": 9007199254740991,
                                "minimum": 1,
                                "type": "integer"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
