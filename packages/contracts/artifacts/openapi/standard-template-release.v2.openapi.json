{
  "info": {
    "title": "Standard template deployment upgrade",
    "version": "2.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/internal/ops/standard-template-releases/{releaseId}/apply-all": {
      "post": {
        "description": "Discovers all current Agents bound to the deployment-owned template and applies each with its own configuration CAS and idempotency record. A partial response identifies failed Agents for retry; it does not establish Workload readiness.",
        "operationId": "applyStandardTemplateReleaseV2",
        "parameters": [
          {
            "in": "path",
            "name": "releaseId",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9._~-]{1,128}$",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._~-]+$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "schemaVersion": {
                    "const": 2,
                    "type": "number"
                  }
                },
                "required": [
                  "schemaVersion"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "releaseId": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "schemaVersion": {
                      "const": 2,
                      "type": "number"
                    },
                    "status": {
                      "enum": [
                        "completed",
                        "partial"
                      ],
                      "type": "string"
                    },
                    "targets": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "agentId": {
                            "minLength": 1,
                            "type": "string"
                          },
                          "configurationRevision": {
                            "anyOf": [
                              {
                                "maximum": 9007199254740991,
                                "minimum": 1,
                                "type": "integer"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "errorCode": {
                            "anyOf": [
                              {
                                "maxLength": 128,
                                "minLength": 1,
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "status": {
                            "enum": [
                              "applied",
                              "failed"
                            ],
                            "type": "string"
                          }
                        },
                        "required": [
                          "agentId",
                          "status",
                          "configurationRevision",
                          "errorCode"
                        ],
                        "type": "object"
                      },
                      "maxItems": 256,
                      "type": "array"
                    },
                    "templateId": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "schemaVersion",
                    "releaseId",
                    "templateId",
                    "status",
                    "targets"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "All discovered Agent revisions accepted"
          },
