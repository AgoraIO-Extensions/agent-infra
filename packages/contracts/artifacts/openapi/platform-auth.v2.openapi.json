{
  "components": {
    "securitySchemes": {
      "PlatformSession": {
        "in": "cookie",
        "name": "__Host-platform-session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "Platform Browser Authentication API",
    "version": "2.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/logout": {
      "post": {
        "operationId": "logoutPlatformEmployeeV1",
        "parameters": [
          {
            "in": "header",
            "name": "X-Platform-CSRF",
            "required": true,
            "schema": {
              "const": "1",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Session revoked and cookie cleared"
          },
          "400": {
            "description": "Malformed logout request"
          },
          "403": {
            "description": "Origin or CSRF check rejected"
          },
          "503": {
            "description": "Session authority unavailable"
          }
        },
        "security": [
          {
            "PlatformSession": []
          }
        ],
        "summary": "Revoke the current Platform browser session"
      }
    },
    "/auth/oidc/backchannel-logout": {
      "post": {
        "operationId": "receivePlatformOidcLogout",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "properties": {
                  "logout_token": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "logout_token"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Notification processed"
          },
          "400": {
            "description": "Invalid logout token or form"
          },
          "503": {
            "description": "Verification or revocation unavailable"
          }
        },
        "summary": "Revoke sessions for a signed OIDC logout notification"
      }
    },
    "/auth/oidc/callback": {
      "get": {
        "operationId": "completePlatformOidcLogin",
        "parameters": [
          {
            "in": "query",
            "name": "code",
            "required": true,
            "schema": {
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "state",
            "required": true,
            "schema": {
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Session established; redirect to the workspace"
          },
          "400": {
            "description": "Missing or invalid browser transaction"
          },
          "401": {
            "description": "Identity rejected"
          },
          "503": {
            "description": "Identity or session authority unavailable"
          }
        },
        "summary": "Complete the browser-bound OIDC transaction"
      }
    },
    "/auth/oidc/login": {
      "get": {
        "operationId": "beginPlatformOidcLogin",
        "responses": {
          "303": {
            "description": "Redirect to the configured identity provider"
          },
          "400": {
            "description": "Invalid login request"
          },
          "503": {
            "description": "Identity provider unavailable"
          }
        },
        "summary": "Start company sign-in"
      }
    }
  }
}
