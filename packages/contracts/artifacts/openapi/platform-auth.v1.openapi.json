{
  "components": {
    "securitySchemes": {
      "PlatformSession": {
        "in": "cookie",
        "name": "__Host-platform-session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "Platform Browser Authentication API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "loginPlatformEmployeeV1",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "login": {
                    "maxLength": 256,
                    "minLength": 1,
                    "type": "string"
                  },
                  "password": {
                    "maxLength": 4096,
                    "minLength": 1,
                    "type": "string",
                    "writeOnly": true
                  }
                },
                "required": [
                  "login",
                  "password"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Session issued in a secure cookie"
          },
          "400": {
            "description": "Malformed login request"
          },
          "401": {
            "description": "Credentials or current account rejected"
          },
          "403": {
            "description": "Request origin rejected"
          },
          "503": {
            "description": "Identity or session authority unavailable"
          }
        },
        "summary": "Bind an employee password and issue a Platform browser session"
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logoutPlatformEmployeeV1",
        "parameters": [
          {
            "in": "header",
            "name": "X-Platform-CSRF",
            "required": true,
            "schema": {
              "const": "1",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Session revoked and cookie cleared"
          },
          "400": {
            "description": "Malformed logout request"
          },
          "403": {
            "description": "Origin or CSRF check rejected"
          },
          "503": {
            "description": "Session authority unavailable"
          }
        },
        "security": [
          {
            "PlatformSession": []
          }
        ],
        "summary": "Revoke the current Platform browser session"
      }
    }
  }
}
