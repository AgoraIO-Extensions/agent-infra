{
  "components": {
    "schemas": {
      "ProtocolErrorV1": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "minLength": 1,
            "type": "string"
          },
          "message": {
            "minLength": 1,
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "schemaVersion": {
            "const": 1,
            "type": "number"
          },
          "traceId": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "schemaVersion",
          "code",
          "message",
          "retryable",
          "traceId"
        ],
        "type": "object"
      },
      "RuntimeOperationResponseV2": {
        "additionalProperties": false,
        "properties": {
          "hostSessionRef": {
            "minLength": 1,
            "type": "string"
          },
          "operationId": {
            "minLength": 1,
            "type": "string"
          },
          "result": {
            "$ref": "#/components/schemas/RuntimeOperationResultV2"
          },
          "schemaVersion": {
            "const": 2,
            "type": "number"
          }
        },
        "required": [
          "schemaVersion",
          "hostSessionRef",
          "operationId",
          "result"
        ],
        "type": "object"
      },
      "RuntimeOperationResultV2": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "outcome": {
                "const": "accepted",
                "type": "string"
              },
              "status": {
                "enum": [
                  "idle",
                  "running",
                  "completed",
                  "failed",
                  "cancelled",
                  "unavailable",
                  "unknown"
                ],
                "type": "string"
              }
            },
            "required": [
              "outcome",
              "status"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "outcome": {
                "const": "busy",
                "type": "string"
              }
            },
            "required": [
              "outcome"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "code": {
                "const": "RUNTIME_TURN_NOT_ACTIVE",
                "type": "string"
              },
              "message": {
                "const": "Runtime turn is no longer active",
                "type": "string"
              },
              "outcome": {
                "const": "rejected",
                "type": "string"
              },
              "retryable": {
                "const": false,
                "type": "boolean"
              }
            },
            "required": [
              "outcome",
              "code",
              "message",
              "retryable"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "code": {
                "const": "RUNTIME_MODEL_SELECTION_UNSUPPORTED",
                "type": "string"
              },
              "message": {
                "const": "Runtime model selection is unsupported",
                "type": "string"
              },
              "outcome": {
                "const": "rejected",
                "type": "string"
              },
              "retryable": {
                "const": false,
                "type": "boolean"
              }
            },
            "required": [
              "outcome",
              "code",
              "message",
              "retryable"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "code": {
                "const": "RUNTIME_ACCEPTANCE_UNKNOWN",
                "type": "string"
              },
              "message": {
                "const": "Runtime command acceptance could not be confirmed",
                "type": "string"
              },
              "outcome": {
                "const": "unknown",
                "type": "string"
              }
            },
            "required": [
              "outcome",
              "code",
              "message"
            ],
            "type": "object"
          }
        ]
      },
      "RuntimeSelectionV1": {
        "additionalProperties": false,
        "properties": {
          "modelOptionId": {
            "minLength": 1,
            "type": "string"
          },
          "reasoningLevel": {
            "minLength": 1,
            "type": "string"
          },
          "schemaVersion": {
            "const": 1,
            "type": "number"
          }
        },
        "required": [
          "schemaVersion",
          "modelOptionId",
          "reasoningLevel"
        ],
        "type": "object"
      },
      "RuntimeSubmitTurnRequestV2": {
        "additionalProperties": false,
        "properties": {
          "actorId": {
            "minLength": 1,
            "type": "string"
          },
          "agentId": {
            "minLength": 1,
            "type": "string"
          },
          "channelId": {
            "minLength": 1,
            "type": "string"
          },
          "conversationId": {
            "minLength": 1,
            "type": "string"
          },
          "deliveryFence": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "executionId": {
            "minLength": 1,
            "type": "string"
          },
          "grant": {
            "additionalProperties": false,
            "properties": {
              "format": {
                "const": "compact-jws",
                "type": "string"
              },
              "schemaVersion": {
                "const": 1,
                "type": "number"
              },
              "token": {
                "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
                "type": "string"
              }
            },
            "required": [
              "schemaVersion",
              "format",
              "token"
            ],
            "type": "object"
          },
          "hostSessionRef": {
            "minLength": 1,
            "type": "string"
          },
          "input": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "attachments": {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "text": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "text",
                  "attachments"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "attachments": {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "required": [
                  "attachments"
                ],
                "type": "object"
              }
            ]
          },
          "requestId": {
            "minLength": 1,
            "type": "string"
          },
          "schemaVersion": {
            "const": 2,
            "type": "number"
          },
          "selection": {
            "$ref": "#/components/schemas/RuntimeSelectionV1"
          },
          "sessionGeneration": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "traceId": {
            "minLength": 1,
            "type": "string"
          },
          "turnId": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "schemaVersion",
          "requestId",
          "traceId",
          "actorId",
          "channelId",
          "agentId",
          "conversationId",
          "executionId",
          "turnId",
          "sessionGeneration",
          "deliveryFence",
          "grant",
          "input",
          "selection"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "RuntimeServiceBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Agent Infra RuntimeHost Contract",
    "version": "2.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/internal/runtime/v2/turns": {
      "post": {
        "operationId": "submitRuntimeTurnV2",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RuntimeSubmitTurnRequestV2"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeOperationResponseV2"
                }
              }
            },
            "description": "RuntimeHost response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProtocolErrorV1"
                }
              }
            },
            "description": "Invalid RuntimeHost request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProtocolErrorV1"
                }
              }
            },
            "description": "RuntimeHost authentication required"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProtocolErrorV1"
                }
              }
            },
            "description": "Execution Grant is not authorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProtocolErrorV1"
                }
              }
            },
            "description": "Runtime session or operation is unavailable"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProtocolErrorV1"
                }
              }
            },
            "description": "Generation, fence, or operation conflict"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProtocolErrorV1"
                }
              }
            },
            "description": "RuntimeHost operation failed"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProtocolErrorV1"
                }
              }
            },
            "description": "Runtime or Driver is unavailable"
          }
        }
      }
    }
  },
  "security": [
    {
      "RuntimeServiceBearer": []
    }
  ]
}
