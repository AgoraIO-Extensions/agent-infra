{
  "components": {
    "securitySchemes": {
      "ConnectionOwnerReader": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Connection registration current Owner",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/internal/connection-registration/v1/owners/{sourceNamespace}/{platformAgentId}": {
      "get": {
        "operationId": "readConnectionRegistrationOwnerV1",
        "parameters": [
          {
            "in": "path",
            "name": "sourceNamespace",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "platformAgentId",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "purpose",
            "required": true,
            "schema": {
              "enum": [
                "create",
                "read",
                "disable",
                "delete"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "directorySource": {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
                      "type": "string"
                    },
                    "email": {
                      "format": "email",
                      "maxLength": 320,
                      "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
                      "type": "string"
                    },
                    "expiresAt": {
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991,
                      "type": "integer"
                    },
                    "ownerRevision": {
                      "maxLength": 200,
                      "minLength": 1,
                      "pattern": "^[^\\p{Cc}]+$",
                      "type": "string"
                    },
                    "platformAgentId": {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
                      "type": "string"
                    },
                    "platformOwnerId": {
                      "maxLength": 200,
                      "minLength": 1,
                      "pattern": "^[^\\p{Cc}]+$",
                      "type": "string"
                    },
                    "policyRevision": {
                      "maxLength": 200,
                      "minLength": 1,
                      "pattern": "^[^\\p{Cc}]+$",
                      "type": "string"
                    },
                    "schemaVersion": {
                      "const": 1,
                      "type": "number"
                    },
                    "sourceNamespace": {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$",
                      "type": "string"
                    },
                    "wechatUserId": {
                      "maxLength": 256,
                      "minLength": 1,
                      "pattern": "^[^\\p{Cc}]+$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "schemaVersion",
                    "sourceNamespace",
                    "platformAgentId",
                    "platformOwnerId",
                    "policyRevision",
                    "directorySource",
                    "wechatUserId",
                    "email",
                    "ownerRevision",
                    "expiresAt"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Current nonsecret facts, no-store, expires within 20 seconds"
          },
          "400": {
            "description": "Invalid selector, body or query"
          },
          "401": {
            "description": "Dedicated machine authentication required; Cookie and Origin rejected"
          },
          "404": {
            "description": "Source, Agent or current Owner unavailable"
          },
          "503": {
            "description": "Current authority unavailable"
          }
        },
        "security": [
          {
            "ConnectionOwnerReader": []
          }
        ],
        "summary": "Read the current selected Owner of an approved registration source and Agent"
      }
    }
  }
}
