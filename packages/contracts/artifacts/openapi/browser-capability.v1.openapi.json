              "maxViewportHeight": {
                "maximum": 4320,
                "minimum": 240,
                "type": "integer"
              },
              "maxViewportWidth": {
                "maximum": 7680,
                "minimum": 320,
                "type": "integer"
              },
              "navigationTimeoutMs": {
                "maximum": 300000,
                "minimum": 100,
                "type": "integer"
              },
              "requireSideEffectConfirmation": {
                "type": "boolean"
              }
            },
            "required": [
              "allowedOrigins",
              "maxContexts",
              "maxTabs",
              "maxPages",
              "maxViewportWidth",
              "maxViewportHeight",
              "maxConcurrentActions",
              "maxDownloads",
              "maxDownloadBytes",
              "maxUploadBytes",
              "maxScreenshotBytes",
              "maxBrowserDurationMs",
              "maxRetainedProfileBytes",
              "navigationTimeoutMs",
