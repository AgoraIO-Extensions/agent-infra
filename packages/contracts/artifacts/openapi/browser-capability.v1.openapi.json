  "info": {
    "title": "Agent Infra Browser Capability",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/internal/runtime/v1/browser-capability": {
      "get": {
        "operationId": "discoverBrowserCapabilityV1",
        "parameters": [
          {
            "in": "query",
            "name": "schemaVersion",
            "required": true,
            "schema": {
              "const": 1,
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "minimumCapabilityVersion",
            "schema": {
              "exclusiveMinimum": 0,
              "maximum": 100,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrowserCapabilityProjectionV1"
                }
              }
            },
            "description": "Browser Capability projection"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrowserCapabilityErrorV1"
                }
              }
            },
            "description": "Invalid Browser Capability request"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrowserCapabilityErrorV1"
                }
              }
            },
            "description": "Browser Capability version conflict"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "message": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "retryable": {
                      "type": "boolean"
                    },
                    "schemaVersion": {
                      "const": 1,
                      "type": "number"
                    },
                    "traceId": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "schemaVersion",
                    "code",
                    "message",
                    "retryable",
                    "traceId"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Browser Runtime is unavailable"
          }
        }
      }
