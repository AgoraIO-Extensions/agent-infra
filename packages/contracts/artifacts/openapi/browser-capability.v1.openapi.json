                "maximum": 256,
                "minimum": 0,
                "type": "integer"
              },
              "maxPages": {
                "maximum": 64,
                "minimum": 1,
                "type": "integer"
              },
              "maxRetainedProfileBytes": {
                "maximum": 10000000000,
                "minimum": 0,
                "type": "integer"
              },
              "maxScreenshotBytes": {
                "maximum": 100000000,
                "minimum": 0,
                "type": "integer"
              },
              "maxTabs": {
                "maximum": 32,
                "minimum": 1,
                "type": "integer"
