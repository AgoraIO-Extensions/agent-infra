{
  "$defs": {
    "RuntimeOriginalAdmissionCheckProofClaimsV1": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "const": "runtime_host.original_admission_check",
          "type": "string"
        },
        "challenge": {
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "type": "string"
        },
        "checkId": {
          "minLength": 1,
          "type": "string"
        },
        "expiresAt": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "issuedAt": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "issuer": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "keyVersion": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "platform": {
          "additionalProperties": false,
          "properties": {
            "resourceFence": {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            "sessionGeneration": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            }
          },
          "required": [
            "sessionGeneration",
            "resourceFence"
          ],
          "type": "object"
        },
        "purpose": {
          "const": "original_admission_check",
          "type": "string"
        },
        "requestDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "type": "number"
        },
        "scope": {
          "additionalProperties": false,
          "properties": {
            "agentId": {
              "minLength": 1,
              "type": "string"
            },
            "authorizationRecordId": {
              "minLength": 1,
              "type": "string"
            },
            "conversationId": {
              "minLength": 1,
              "type": "string"
            },
            "executionDeliveryFence": {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            "executionId": {
              "minLength": 1,
              "type": "string"
            },
            "originalOperationId": {
              "minLength": 1,
              "type": "string"
            },
            "podUid": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            "principal": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "minLength": 1,
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "user",
                    "application"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "id"
              ],
              "type": "object"
            },
            "sessionGeneration": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            }
          },
          "required": [
            "principal",
            "agentId",
            "conversationId",
            "executionId",
            "originalOperationId",
            "authorizationRecordId",
            "sessionGeneration",
            "executionDeliveryFence",
            "podUid"
          ],
          "type": "object"
        },
        "workerId": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "checkId",
        "challenge",
        "issuedAt",
        "expiresAt",
        "scope",
        "platform",
        "purpose",
        "audience",
        "issuer",
        "workerId",
        "keyVersion",
        "requestDigest"
      ],
      "type": "object"
    },
    "RuntimeOriginalAdmissionCheckRequestV1": {
      "additionalProperties": false,
      "properties": {
        "challenge": {
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "type": "string"
        },
        "checkId": {
          "minLength": 1,
          "type": "string"
        },
        "expiresAt": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "issuedAt": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "platform": {
          "additionalProperties": false,
          "properties": {
            "resourceFence": {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            "sessionGeneration": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            }
          },
