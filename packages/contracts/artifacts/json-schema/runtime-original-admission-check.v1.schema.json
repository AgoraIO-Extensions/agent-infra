            "resourceFence"
          ],
          "type": "object"
        },
        "proof": {
          "additionalProperties": false,
          "properties": {
            "format": {
              "const": "original-admission-check-jws",
              "type": "string"
            },
            "schemaVersion": {
              "const": 1,
              "type": "number"
            },
            "token": {
              "maxLength": 16384,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "schemaVersion",
            "format",
            "token"
          ],
          "type": "object"
        },
        "schemaVersion": {
          "const": 1,
          "type": "number"
        },
        "scope": {
          "additionalProperties": false,
          "properties": {
            "agentId": {
              "minLength": 1,
              "type": "string"
            },
            "authorizationRecordId": {
              "minLength": 1,
              "type": "string"
            },
            "conversationId": {
              "minLength": 1,
              "type": "string"
            },
            "executionDeliveryFence": {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            "executionId": {
              "minLength": 1,
              "type": "string"
            },
            "originalOperationId": {
              "minLength": 1,
              "type": "string"
            },
            "podUid": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            "principal": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "minLength": 1,
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "user",
                    "application"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "id"
              ],
              "type": "object"
            },
            "sessionGeneration": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            }
          },
          "required": [
            "principal",
            "agentId",
            "conversationId",
            "executionId",
            "originalOperationId",
            "authorizationRecordId",
            "sessionGeneration",
