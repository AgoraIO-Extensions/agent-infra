            "podUid"
          ],
          "type": "object"
        }
      },
      "required": [
        "schemaVersion",
        "checkId",
        "challenge",
        "issuedAt",
        "expiresAt",
        "scope",
        "platform",
        "proof"
      ],
      "type": "object"
    },
    "RuntimeOriginalAdmissionCheckResponseV1": {
      "additionalProperties": false,
      "properties": {
        "challenge": {
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "type": "string"
        },
        "checkId": {
          "minLength": 1,
          "type": "string"
        },
        "checkedAt": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "checkedSurface": {
          "const": "original_call_admission_predicate",
          "type": "string"
        },
        "clockId": {
          "pattern": "^[A-Za-z0-9_-]{22}$",
          "type": "string"
        },
        "current": {
          "additionalProperties": false,
          "properties": {
            "hostBarrier": {
              "enum": [
                "none",
                "active",
                "confirmed",
                "unavailable"
              ],
              "type": "string"
            },
            "hostExecutionFence": {
              "anyOf": [
                {
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "platformResourceFence": {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            "platformSessionGeneration": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            }
          },
          "required": [
            "platformSessionGeneration",
            "platformResourceFence",
            "hostBarrier",
            "hostExecutionFence"
          ],
          "type": "object"
        },
        "decision": {
          "enum": [
            "admissible",
            "denied",
            "unproven"
          ],
          "type": "string"
        },
        "dispatchAttempted": {
          "const": false,
          "type": "boolean"
        },
        "original": {
          "additionalProperties": false,
          "properties": {
            "executionDeliveryFence": {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            "sessionGeneration": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            }
          },
          "required": [
            "sessionGeneration",
            "executionDeliveryFence"
          ],
          "type": "object"
        },
        "reason": {
          "enum": [
            "stale_generation",
            "stale_fence",
            "expired",
            "revoked",
            "scope_mismatch",
            "original_binding_unavailable",
            "unknown"
          ],
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "type": "number"
        }
      },
      "required": [
        "schemaVersion",
        "checkId",
        "challenge",
        "decision",
        "checkedSurface",
        "original",
        "current",
        "checkedAt",
        "clockId",
        "dispatchAttempted"
      ],
      "type": "object"
    }
