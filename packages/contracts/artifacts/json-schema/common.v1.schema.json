{
  "$defs": {
    "IdempotencyKeyV1": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._~-]+$",
      "type": "string"
    },
    "OpaqueCursorV1": {
      "minLength": 1,
      "type": "string"
    },
    "OpaqueIdV1": {
      "minLength": 1,
      "type": "string"
    },
    "ProtocolErrorV1": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "schemaVersion": {
          "const": 1,
          "type": "number"
        },
        "traceId": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "code",
        "message",
        "retryable",
        "traceId"
      ],
      "type": "object"
    },
    "RequestIdV1": {
      "minLength": 1,
      "type": "string"
    },
    "RetryableV1": {
      "type": "boolean"
    },
    "Rfc3339TimestampV1": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))[Tt](?:[01]\\d|2[0-3]):[0-5]\\d:(?:[0-5]\\d|60)(?:\\.\\d+)?(?:[Zz]|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
      "type": "string"
    },
    "SchemaVersionV1": {
      "const": 1,
      "type": "number"
    },
    "TraceIdV1": {
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "https://github.com/AgoraIO-Extensions/agent-infra/schemas/common.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Infra Common Contracts V1"
}
