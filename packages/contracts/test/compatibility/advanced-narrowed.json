{
	"$defs": {
		"AliasV1": {
			"$ref": "#/$defs/RequestIdV1"
		},
		"ArrayV1": {
			"items": {
				"type": "string"
			},
			"prefixItems": [
				{
					"type": "string"
				}
			],
			"type": "array",
			"uniqueItems": true
		},
		"BooleanSchemaV1": false,
		"ChoiceV1": {
			"oneOf": [
				{
					"const": "a"
				}
			]
		},
		"ConjunctionV1": {
			"allOf": [
				{
					"type": "string"
				},
				{
					"minLength": 1
				}
			]
		},
		"ContainsV1": {
			"contains": {
				"type": "string"
			},
			"maxContains": 3,
			"minContains": 2,
			"type": "array"
		},
		"ExcludedV1": {
			"not": {
				"const": "forbidden"
			},
			"type": "string"
		},
		"ExclusiveChoiceV1": {
			"oneOf": [
				{
					"type": "string"
				},
				{
					"minLength": 1
				}
			]
		},
		"IntegerV1": {
			"type": "integer"
		},
		"ModeV1": {
			"enum": ["safe"],
			"type": "string"
		},
		"NumberV1": {
			"exclusiveMaximum": 10,
			"exclusiveMinimum": 0,
			"multipleOf": 2,
			"type": "number"
		},
		"OpaqueIdV1": {
			"type": "string"
		},
		"OpenObjectV1": {
			"properties": {
				"foo": {
					"type": "string"
				}
			},
			"type": "object"
		},
		"RequestIdV1": {
			"type": "string"
		},
		"RecordV1": {
			"additionalProperties": {
				"type": "string"
			},
			"propertyNames": {
				"pattern": "^[a-z]+$"
			},
			"type": "object"
		},
		"ToggleV1": {
			"const": true,
			"type": "boolean"
		},
		"TupleV1": {
			"items": false,
			"prefixItems": [],
			"type": "array"
		},
		"UntypedV1": {
			"type": "string"
		}
	},
	"$schema": "https://json-schema.org/draft/2020-12/schema"
}
