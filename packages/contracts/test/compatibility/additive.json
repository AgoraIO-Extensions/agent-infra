{
	"$defs": {
		"ChoiceV1": {
			"oneOf": [
				{
					"const": "a"
				},
				{
					"const": "b"
				},
				{
					"const": "c"
				}
			]
		},
		"DiscriminatedChoiceV1": {
			"oneOf": [
				{
					"properties": {
						"kind": { "const": "a" }
					},
					"required": ["kind"],
					"type": "object"
				},
				{
					"properties": {
						"kind": { "const": "b" }
					},
					"required": ["kind"],
					"type": "object"
				},
				{
					"properties": {
						"kind": { "const": "c" }
					},
					"required": ["kind"],
					"type": "object"
				}
			]
		},
		"OpaqueIdV1": {
			"minLength": 1,
			"type": "string"
		},
		"ProtocolErrorV1": {
			"additionalProperties": false,
			"properties": {
				"code": {
					"type": "string"
				},
				"detail": {
					"type": "string"
				},
				"message": {
					"type": "string"
				}
			},
			"required": ["code", "message"],
			"type": "object"
		},
		"RequestIdV1": {
			"type": "string"
		}
	},
	"$schema": "https://json-schema.org/draft/2020-12/schema"
}
