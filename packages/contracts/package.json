{
	"name": "@agent-infra/contracts",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./pilot": {
			"types": "./dist/pilot/index.d.mts",
			"import": "./dist/pilot/index.mjs"
		},
		"./json-schema/common.v1": "./artifacts/json-schema/common.v1.schema.json",
		"./json-schema/pilot-delegated.v1": "./artifacts/json-schema/pilot-delegated.v1.schema.json",
		"./json-schema/pilot-sse.v1": "./artifacts/json-schema/pilot-sse.v1.schema.json",
		"./json-schema/registry-manifest.v1": "./artifacts/json-schema/registry-manifest.v1.schema.json",
		"./openapi/common.v1": "./artifacts/openapi/common.v1.openapi.json",
		"./openapi/pilot-browser.v1": "./artifacts/openapi/pilot-browser.v1.openapi.json",
		"./openapi/pilot-delegated.v1": "./artifacts/openapi/pilot-delegated.v1.openapi.json",
		"./workload": {
			"types": "./dist/workload/index.d.mts",
			"import": "./dist/workload/index.mjs"
		}
	},
	"files": [
		"dist",
		"artifacts"
	],
	"scripts": {
		"build": "tsdown",
		"check-compatibility": "node src/compatibility.mjs",
		"check-types": "tsc --noEmit",
		"client-smoke": "node src/client-smoke.mjs",
		"generate": "node src/generate.mjs --write && node src/pilot-client.mjs --write",
		"check-generated": "node src/generate.mjs --check && node src/pilot-client.mjs --check",
		"test": "pnpm build && vitest run src test && pnpm check-generated && pnpm check-compatibility"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@agent-infra/config": "workspace:*",
		"@hey-api/openapi-ts": "catalog:",
		"@types/node": "catalog:",
		"ajv": "catalog:",
		"tsdown": "0.22.14",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"zod-openapi": "catalog:"
	}
}
