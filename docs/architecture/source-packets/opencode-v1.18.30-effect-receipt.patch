+/**
+ * Private Driver/native effect receipt boundary.
+ *
+ * This module is intentionally transport agnostic. The Runtime Driver owns
+ * persistence, permit validation, ACK replay, and the process boundary.
+ */
+export const EFFECT_RECEIPT_SCHEMA = 1 as const
+
+export const effectReceiptPhases = [
+  "intent",
+  "permit",
+  "started",
+  "completed",
+  "failed",
+  "cancelled",
+  "unknown",
+] as const
+
+export type EffectReceiptPhase = (typeof effectReceiptPhases)[number]
+
+export type EffectReceiptTarget =
+  | "file.read"
+  | "file.write"
+  | "file.remove"
+  | "process.dispatch"
+  | "client.dispatch"
+
+export const effectReceiptTargets = [
+  "file.read",
+  "file.write",
+  "file.remove",
+  "process.dispatch",
+  "client.dispatch",
+] as const
+
+export type EffectReceipt = {
+  readonly schema: typeof EFFECT_RECEIPT_SCHEMA
+  readonly sessionID: string
+  readonly turnID: string
+  readonly callID: string
+  readonly executionID: string
+  readonly generation: number
+  readonly fence: string
+  readonly operationRef: string
+  readonly attemptRef: string
+  readonly leafNonce: string
+  readonly sequence: number
+  readonly phase: EffectReceiptPhase
+  readonly target: EffectReceiptTarget
+  readonly targetRef: string
+  readonly ackID: string
+  readonly startedAt?: number
+  readonly resultDigest?: string
+  readonly errorCode?: string
+}
+
+export type EffectReceiptRequest = Omit<EffectReceipt, "phase" | "ackID" | "startedAt" | "resultDigest" | "errorCode"> & {
+  readonly phase: "intent" | "permit"
+}
+
+export type EffectReceiptResult =
+  | (EffectReceipt & { readonly phase: "started" | "completed" })
+  | (EffectReceipt & { readonly phase: "failed" | "cancelled" | "unknown"; readonly errorCode: string })
+
+const boundedString = (value: unknown, max = 256): value is string =>
+  typeof value === "string" && value.length > 0 && value.length <= max
+
+export function isEffectReceipt(value: unknown): value is EffectReceipt {
+  if (!value || typeof value !== "object") return false
+  const receipt = value as Partial<EffectReceipt>
+  return (
+    receipt.schema === EFFECT_RECEIPT_SCHEMA &&
+    boundedString(receipt.sessionID) &&
+    boundedString(receipt.turnID) &&
+    boundedString(receipt.callID) &&
+    boundedString(receipt.executionID) &&
+    Number.isSafeInteger(receipt.generation) &&
+    receipt.generation >= 0 &&
+    boundedString(receipt.fence) &&
+    boundedString(receipt.operationRef) &&
+    boundedString(receipt.attemptRef) &&
+    boundedString(receipt.leafNonce) &&
+    Number.isSafeInteger(receipt.sequence) &&
+    receipt.sequence >= 0 &&
+    typeof receipt.phase === "string" &&
+    effectReceiptPhases.includes(receipt.phase as EffectReceiptPhase) &&
+    typeof receipt.target === "string" &&
+    effectReceiptTargets.includes(receipt.target as EffectReceiptTarget) &&
+    boundedString(receipt.targetRef) &&
+    boundedString(receipt.ackID) &&
+    (receipt.phase === "failed" || receipt.phase === "cancelled" || receipt.phase === "unknown"
+      ? typeof receipt.errorCode === "string" && /^[A-Z][A-Z0-9_]{0,63}$/.test(receipt.errorCode)
+      : receipt.errorCode === undefined)
+  )
+}
