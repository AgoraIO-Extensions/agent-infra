{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Worker hostname route configuration V1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "enabled"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "enabled": {
          "const": false
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "enabled",
        "namespace",
        "hostnameRoutes"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "enabled": {
          "const": true
        },
        "namespace": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?$"
        },
        "hostnameRoutes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hostSuffix",
            "platformOrigin",
            "clusterIssuerName",
            "agentIds"
          ],
          "properties": {
            "hostSuffix": {
              "type": "string",
              "maxLength": 214,
              "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$",
              "allOf": [
                {
                  "pattern": "\\."
                },
                {
                  "not": {
                    "pattern": "^[0-9.]+$"
                  }
                },
                {
                  "not": {
                    "pattern": "\\.[0-9]+$"
                  }
                }
              ]
            },
            "platformOrigin": {
              "type": "string",
              "maxLength": 261,
              "pattern": "^https://[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$",
              "allOf": [
                {
                  "pattern": "\\."
                },
                {
                  "not": {
                    "pattern": "^https://[0-9.]+$"
                  }
                },
                {
                  "not": {
                    "pattern": "\\.[0-9]+$"
                  }
                }
              ]
            },
            "clusterIssuerName": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$"
            },
            "agentIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 512,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[\\x21-\\x7e]{1,160}$"
              }
            }
          }
        }
      }
    }
  ]
}
