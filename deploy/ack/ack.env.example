# Copy to a private file and source it before deploy.sh.
# Keep kubeconfig, registry credentials, passwords, and tokens outside Git.
export ACK_KUBECONFIG=/absolute/path/to/ack-kubeconfig
export ACK_NAMESPACE=agent-infra
export ACK_RELEASE=agent-infra-ack
export ACK_VALUES_FILE=/absolute/path/to/ack-values.yaml
export ACK_HELM_TIMEOUT=15m
