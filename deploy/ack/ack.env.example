# Copy to a private file and source it before deploy.sh.
# Keep kubeconfig, registry credentials, passwords, and tokens outside Git.
ACK_KUBECONFIG=/absolute/path/to/ack-kubeconfig
ACK_NAMESPACE=agent-infra
ACK_RELEASE=agent-infra-ack
ACK_VALUES_FILE=/absolute/path/to/ack-values.yaml
ACK_HELM_TIMEOUT=15m
