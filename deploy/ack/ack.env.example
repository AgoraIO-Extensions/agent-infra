# Copy to a private file and source it before deploy.sh.
# Keep kubeconfig, registry credentials, passwords, and tokens outside Git.
export ACK_KUBECONFIG=/absolute/path/to/ack-kubeconfig
export ACK_NAMESPACE=agent-infra
export ACK_RELEASE=agent-infra-ack
export ACK_VALUES_FILE=/absolute/path/to/ack-values.yaml
export ACK_HELM_TIMEOUT=15m

# Immutable source and real acceptance inputs. Keep every path outside Git.
export ACK_SOURCE_SHA=0123456789abcdef0123456789abcdef01234567
export ACK_IMAGE_MANIFEST=/absolute/path/to/platform-images.json
export ACK_RUNTIME_IMAGE_MANIFEST=/absolute/path/to/runtime-host-manifest.json
export ACK_PUBLIC_ORIGIN=https://ack.example.test
export ACK_CA_CERT_FILE=/absolute/path/to/ack-ca.pem
# provision/all generate current IDs into this external private directory.
export ACK_AGENT_STATE_DIR=/absolute/path/to/private-agent-state
export ACK_BROWSER_BLUEPRINT_DIR=/absolute/path/to/browser-blueprints
# Standalone validation of manually prepared configs only:
# export ACK_TEMPLATE_CONFIG_DIR=/absolute/path/to/template-configs
export ACK_CUSTOM_AGENT_PROBE=platform-auth
export ACK_CUSTOM_AGENT_CONFIGS=$'/absolute/path/to/custom-agent-a.json\n/absolute/path/to/custom-agent-b.json'
export ACK_AGENT_REQUESTS_FILE=/absolute/path/to/agent-requests.json
export ACK_EVIDENCE_DIR=/absolute/path/to/ack-evidence/run-1

# Optional separate private-input initialization (not database initialization):
# export ACK_BOOTSTRAP_INPUTS_FILE=/absolute/path/to/bootstrap-inputs.json

# clean/destroy remain disabled until inventory and restore verification are implemented.
