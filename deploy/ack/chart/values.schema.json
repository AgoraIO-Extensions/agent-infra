          "key": {"type": "string", "pattern": "^[a-zA-Z0-9._-]+$"}
        }}
      }
    },
    "sigCoreSdkTrialImage": {"type": "string", "pattern": "^(|ghcr[.]io/agoraio-extensions/agent-infra/agent-runtime-codex@sha256:[a-f0-9]{64})$"},
    "sigCorePilot": {"type": "string", "enum": ["off", "new", "drain"]},
    "applicationCredentialMaterialDelivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "enabled",
        "recipients"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "recipients": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "applicationId",
              "principalType",
              "principalId"
            ],
            "properties": {
              "applicationId": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S+$"
              },
              "principalType": {
                "const": "user"
              },
              "principalId": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S+$"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "recipients": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "clusterReads", "configurationSecret"],
      "properties": {
        "enabled": {"type": "boolean"},
        "clusterReads": {"type": "boolean"},
        "configurationSecret": {"type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"},
        "prometheusCredentialsSecret": {"type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"},
        "prometheusTLSSecretPrefix": {"type": "string", "maxLength": 245, "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"}
      },
      "allOf": [
        {"if": {"properties": {"enabled": {"const": true}}}, "then": {"properties": {"configurationSecret": {"minLength": 1}}}},
        {"if": {"properties": {"clusterReads": {"const": true}}}, "then": {"properties": {"enabled": {"const": true}}}}
      ]
    },
    "images": {
      "type": "object",
      "additionalProperties": true,
      "required": ["web", "api", "worker", "directory", "postgres", "runtimeHost", "pullSecrets"],
      "properties": {
        "runtimeHost": {
          "type": "object",
