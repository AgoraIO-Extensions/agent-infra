    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "api": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$"}},
        "worker": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$"}},
        "operations": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$"}}
      }
    },
    "directorySource": {"type": "object", "additionalProperties": false, "properties": {"files": {"type": "object", "additionalProperties": {"type": "string"}}}},
    "smokeTest": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}}},
    "certificates": {"type": "array", "maxItems": 4, "items": {"type": "object", "additionalProperties": false,
      "required": ["name", "secretName", "dnsNames", "clusterIssuer"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "secretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "dnsNames": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"}},
        "clusterIssuer": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"}
      }}},
    "web": {"type": "object", "additionalProperties": false, "properties": {"preStopSleepSeconds": {"type": "integer", "minimum": 0, "maximum": 60}}},
    "imageCaches": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "sizeGiB": {"type": "integer", "minimum": 20, "maximum": 100},
        "pullSecret": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"},
        "images": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9./_-]+@sha256:[a-f0-9]{64}$"}},
        "retainedGroups": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/properties/imageCaches/properties/groups/items"}},
        "extraImages": {"type": "array", "maxItems": 25, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9./_-]+@sha256:[a-f0-9]{64}$"}},
        "groups": {"type": "array", "maxItems": 86, "items": {"type": "array", "minItems": 2, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9./_-]+@sha256:[a-f0-9]{64}$"}}}
      }
    }
  }
}
