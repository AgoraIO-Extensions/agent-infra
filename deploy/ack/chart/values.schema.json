{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["images", "secrets", "publicOrigin", "directory", "scheduling", "resources", "quota", "postgres", "ingress", "migrations", "encryption", "worker"],
  "allOf": [{"if": {"properties": {"operations": {"properties": {"enabled": {"const": true}}}, "configuration": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]}}, "required": ["configuration"]}, "then": {"required": ["configuration"], "properties": {"configuration": {"required": ["operations"], "properties": {"operations": {"required": ["configuration.json"]}}}}}}],
  "properties": {
    "automaticTemplatePublication": {
      "type": "object", "additionalProperties": false, "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "origin": {"type": "string", "pattern": "^https://[a-z0-9]([a-z0-9.-]*[a-z0-9])?(:[1-9][0-9]{0,4})?/?$"},
        "secretRef": {
          "type": "object", "additionalProperties": false, "required": ["name", "key"],
          "properties": {
            "name": {"type": "string", "maxLength": 253, "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"},
            "key": {"type": "string", "maxLength": 253, "pattern": "^[A-Za-z0-9._-]+$"}
          }
        },
        "bootstrapPrepareIds": {
          "type": "object", "minProperties": 1, "maxProperties": 4, "propertyNames": {"enum": ["claude", "codex", "opencode", "pi"]},
          "additionalProperties": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9._~-]+$"}
        },
        "publicationIds": {
          "type": "object", "propertyNames": {"enum": ["claude", "codex", "opencode", "pi"]},
          "additionalProperties": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9._~-]+$"}
        }
      },
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {"required": ["origin", "secretRef"]},
      "allOf": [{"if": {"required": ["bootstrapPrepareIds"]}, "then": {"properties": {"enabled": {"const": true}, "publicationIds": {"maxProperties": 0}}}}]
    },
    "maintenanceTerminal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "publicOrigin": {
          "type": "string"
        },
        "tokenSecretName": {
          "type": "string"
        },
        "consumerImage": {"type":"string"},
        "consumerImages": {"type":"array","items":{"type":"string","minLength":1}},
        "sshHost": {"type":"string"},
        "sshPublicPort": {"type":"integer","minimum":1,"maximum":65535},
        "sshHostKeySecretName": {"type":"string"}
      },
      "required": [
        "enabled",
        "image",
        "storageClass",
        "publicOrigin",
        "tokenSecretName"
      ]
    },
    "standardTemplateRegistry": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [{"maxProperties": 0}, {"required": ["endpoint", "imageReferencePrefix", "repositories", "authentication", "credentialsSecretRef"]}],
      "properties": {
        "endpoint": {"type": "string", "pattern": "^https://[^/?#]+$"},
        "imageReferencePrefix": {"type": "string", "pattern": "^[a-z0-9.-]+(:[0-9]+)?$"},
        "repositories": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9._/-]+$"}},
        "authentication": {"type": "object", "additionalProperties": false, "required": ["realm", "service"], "properties": {
          "realm": {"type": "string", "pattern": "^https://[^?#]+$"},
          "service": {"type": "string", "minLength": 1}
