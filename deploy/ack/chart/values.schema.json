          }
        },
        "executorInstanceStartupApprovals": {"type": "array", "maxItems": 128, "items": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "imageDigest", "verificationRef"], "properties": {"schemaVersion": {"const": 2}, "imageDigest": {"type": "string", "pattern": "^ghcr\\.io/agoraio-extensions/agent-infra/agent-runtime-(codex|claude|opencode|pi)@sha256:[a-f0-9]{64}$"}, "verificationRef": {"type": "string", "minLength": 1, "maxLength": 256}}}},
        "readinessProbe": {"type": "object"},
        "fileBridge": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}}},
        "certificateReconciliationWrites": {"type": "boolean"}, "hostnameCertificates": {"type": "object", "additionalProperties": false, "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}}, "nativeMetadataGateway": {"type": "object", "additionalProperties": false, "required": ["enabled", "port", "platformApiOrigin"], "properties": {"enabled": {"type": "boolean"}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}, "platformApiOrigin": {"type": "string", "maxLength": 256, "pattern": "^(?:|http://[a-zA-Z0-9.-]+(?::[1-9][0-9]{0,4})?/?)$"}, "agentCallbacks": {"type": "boolean"}}}}
    },
    "replicas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"api": {"type": "integer", "minimum": 2, "maximum": 10}}
    },
    "publicOrigin": {"type": "string", "pattern": "^https://"},
    "agentVersion": {"type": "string", "pattern": "^([A-Za-z0-9][A-Za-z0-9._:-]{0,127})?$"},
    "skillHub": {
      "type": "object", "additionalProperties": false, "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "scannerImage": {"type": "string", "pattern": "^(?:|[a-z0-9./:_-]+@sha256:[0-9a-f]{64})$"},
        "objectStorage": {
          "type": "object", "additionalProperties": false, "required": ["enabled", "image", "secretName", "accessKeyKey", "secretKeyKey", "bucket", "storageClass", "storageSize"],
          "properties": {
            "enabled": {"type": "boolean"},
            "image": {"type": "string", "pattern": "^(?:|[a-z0-9./:_-]+@sha256:[0-9a-f]{64})$"},
            "secretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
            "accessKeyKey": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
            "secretKeyKey": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
            "bucket": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,62}$"},
            "storageClass": {"type": "string", "minLength": 1},
            "storageSize": {"type": "string", "pattern": "^[1-9][0-9]*(?:Mi|Gi|Ti)$"}
          }
        }
      }
    },
    "directory": {"type": "object", "required": ["corpId", "sourceConfigMap", "sourceModule", "runtimeDatabaseRole"]},
    "scheduling": {"type": "object"},
    "agentWorkloadScheduling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "architecture", "legacyUnplaced"],
      "properties": {
        "enabled": {"type": "boolean"},
        "architecture": {"type": "string", "enum": ["amd64", "arm64"]},
        "legacyUnplaced": {"type": "string", "enum": ["retain-until-lifecycle", "reject"]}
      }
    },
    "sessionRuntimeScheduling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "architecture"],
      "properties": {
        "enabled": {"type": "boolean"},
        "architecture": {"type": "string", "enum": ["amd64", "arm64"]},
