        "executorInstanceStartupApprovedImages": {"type": "array", "uniqueItems": true, "maxItems": 128, "items": {"type": "string", "pattern": "^ghcr\\.io/agoraio-extensions/agent-infra/agent-runtime-(codex|claude|opencode|pi)@sha256:[a-f0-9]{64}$"}},
