{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["images", "secrets", "publicOrigin", "directory", "scheduling", "resources", "quota", "postgres", "ingress", "migrations", "encryption", "worker"],
  "properties": {
    "images": {
      "type": "object",
      "additionalProperties": true,
      "required": ["web", "api", "worker", "directory", "postgres", "runtimeHost", "pullSecrets"],
      "properties": {
        "runtimeHost": {
          "type": "object",
          "required": ["repository", "digest"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        }
      }
    },
    "secrets": {"type": "object", "additionalProperties": {"type": "string"}},
    "platformApi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connectionWebPath": {"type": "string", "maxLength": 2048, "pattern": "^(|/|/[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*/?)$"},
        "connectionCallbackAuthSecretRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "key"],
          "properties": {
            "name": {"type": "string", "maxLength": 253, "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"},
            "key": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*$"}
          }
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "configurationFile": {"type": "string", "pattern": "^/"}
      }
    },
    "wecom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    },
    "encryption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyVersion"],
      "properties": {"keyVersion": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}}
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyVersions"],
      "properties": {"keyVersions": {"type": "string", "pattern": "^[A-Za-z0-9._-]+(,[A-Za-z0-9._-]+)*$"}}
    },
    "replicas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"api": {"type": "integer", "minimum": 2, "maximum": 10}}
    },
    "publicOrigin": {"type": "string", "pattern": "^https://"},
    "agentVersion": {"type": "string", "pattern": "^([A-Za-z0-9][A-Za-z0-9._:-]{0,127})?$"},
    "skillHub": {
      "type": "object", "additionalProperties": false, "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "scannerImage": {"type": "string", "pattern": "^(?:|[a-z0-9./:_-]+@sha256:[0-9a-f]{64})$"},
        "objectStorage": {
          "type": "object", "additionalProperties": false, "required": ["enabled", "image", "secretName", "accessKeyKey", "secretKeyKey", "bucket", "storageClass", "storageSize"],
          "properties": {
            "enabled": {"type": "boolean"},
            "image": {"type": "string", "pattern": "^(?:|[a-z0-9./:_-]+@sha256:[0-9a-f]{64})$"},
            "secretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
            "accessKeyKey": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
            "secretKeyKey": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
            "bucket": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,62}$"},
            "storageClass": {"type": "string", "minLength": 1},
            "storageSize": {"type": "string", "pattern": "^[1-9][0-9]*(?:Mi|Gi|Ti)$"}
          }
        }
      }
    },
    "directory": {"type": "object", "required": ["corpId", "sourceConfigMap", "sourceModule", "runtimeDatabaseRole"]},
    "scheduling": {"type": "object"},
    "sessionRuntimeScheduling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "architecture"],
      "properties": {
        "enabled": {"type": "boolean"},
        "architecture": {"type": "string", "enum": ["amd64", "arm64"]},
        "runtimeClassName": {"type": "string", "pattern": "^(|[a-z0-9]([-a-z0-9.]*[a-z0-9])?)$", "maxLength": 253},
        "protectedRuntime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "yamaPtraceScope"],
          "properties": {
            "enabled": {"type": "boolean"},
            "yamaPtraceScope": {"type": "string", "enum": ["2", "3"]}
          }
        },
        "imageCache": {
          "type": "object", "additionalProperties": false,
          "required": ["required", "entries"],
          "properties": {
            "required": {"type": "boolean"},
            "entries": {"type": "array", "maxItems": 24, "items": {
              "type": "object", "additionalProperties": false, "required": ["images", "cacheId"],
              "properties": {
                "images": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^ghcr\\.io/agoraio-extensions/agent-infra/[a-z0-9][a-z0-9._-]*@sha256:[a-f0-9]{64}$"}},
                "cacheId": {"type": "string", "pattern": "^imc-[a-z0-9]+$"}
              }
            }}
          }
        }
      }
    },
    "resources": {"type": "object"},
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "hard"],
      "properties": {
        "enabled": {"type": "boolean"},
        "hard": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["databaseOnly"],
      "properties": {"databaseOnly": {"type": "boolean"}}
    },
    "postgres": {
      "type": "object",
      "properties": {
        "adminUser": {"type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$"},
        "initialDatabase": {"type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$"},
        "adminSecret": {"type": "string"},
        "initializationSecret": {"type": "string"},
        "bootstrapInstallationId": {"type": "string", "pattern": "^([a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12})?$"}
      }
    },
    "ingress": {"type": "object"},
    "migrations": {"type": "object"}
  }
}
