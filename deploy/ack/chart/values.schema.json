          "items": {"type": "string", "pattern": "^[0-9a-f]{8}-([0-9a-f]{4}-){3}[0-9a-f]{12}$"}
        }
      }
    },
    "platformWeb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loginMode"],
      "properties": {
        "loginMode": {"type": "string", "enum": ["build", "oidc"]}
      }
    },
    "platformApi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connectionWebPath": {"type": "string", "maxLength": 2048, "pattern": "^(|/|/[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*/?)$"},
        "oidcClientSecretRef": {"$ref": "#/properties/platformApi/properties/connectionCallbackAuthSecretRef"},
        "connectionCallbackAuthSecretRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "key"],
          "properties": {
            "name": {"type": "string", "maxLength": 253, "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"},
            "key": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*$"}
          }
        },
        "connectionSystemAccess": {
          "type": "object",
          "additionalProperties": false,
          "oneOf": [
            {"properties": {"enabled": {"const": false}}},
            {"required": ["enabled", "publicOrigin", "mcpPath", "audience", "issuer", "oauthCallbackUrl", "egressProfile", "approval"], "properties": {"enabled": {"const": true}}}
          ],
          "properties": {
            "enabled": {"type": "boolean"},
            "publicOrigin": {"type": "string", "maxLength": 2048, "pattern": "^https://[a-z0-9.-]+(:[0-9]{1,5})?$"},
            "mcpPath": {"type": "string", "maxLength": 2048, "pattern": "^/(?:[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*)(?:/(?:[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*))*$"},
            "audience": {"type": "string", "minLength": 1, "maxLength": 512},
            "issuer": {"type": "string", "maxLength": 2048, "pattern": "^https://[^?#\\s\\\\]+$"},
            "oauthCallbackUrl": {"type": "string", "maxLength": 2048, "pattern": "^https://[^?#\\s\\\\]+$"},
            "egressProfile": {"type": "object", "additionalProperties": false, "required": ["ref", "revision"], "properties": {"ref": {"type": "string", "minLength": 1, "maxLength": 2048}, "revision": {"type": "string", "minLength": 1, "maxLength": 128}}},
            "approval": {"type": "object", "additionalProperties": false, "required": ["configFingerprint", "egressEnforced", "source"], "properties": {"configFingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "egressEnforced": {"const": true}, "source": {"type": "object", "additionalProperties": false, "required": ["ref", "revision"], "properties": {"ref": {"type": "string", "minLength": 1, "maxLength": 2048}, "revision": {"type": "string", "minLength": 1, "maxLength": 128}}}}}
          }
        }
      }
    },
    "connectionManualInstallation": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {"properties": {"enabled": {"const": false}}},
        {
          "required": ["enabled", "exceptionApproval", "receiverPort", "readbackPort", "hostCaSecretRef", "readbackTlsSecretRef", "hostTlsSecretRef", "workerCaSecretRef"],
          "properties": {
            "enabled": {"const": true},
            "exceptionApproval": {"required": ["schemaVersion", "kind", "policy", "notAfter", "maximumPinnedPrincipals", "verificationWindowHours", "connectionRelease", "systemAccessFingerprint", "approvalSource"]},
            "hostCaSecretRef": {"required": ["name", "key"]},
            "readbackTlsSecretRef": {"required": ["name", "certKey", "keyKey"]},
            "hostTlsSecretRef": {"required": ["name", "certKey", "keyKey"]},
            "workerCaSecretRef": {"required": ["name", "key"]}
          }
        }
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "exceptionApproval": {"type": "object"},
        "clientName": {"type": "string", "maxLength": 100, "pattern": "^[ -~]*$"},
        "receiverPort": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "readbackPort": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "hostCaSecretRef": {"type": "object", "additionalProperties": false, "properties": {"name": {"type": "string", "maxLength": 253, "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"}, "key": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*$"}}},
        "readbackTlsSecretRef": {"type": "object", "additionalProperties": false, "properties": {"name": {"type": "string", "maxLength": 253, "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"}, "certKey": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*$"}, "keyKey": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*$"}}},
        "hostTlsSecretRef": {"type": "object", "additionalProperties": false, "properties": {"name": {"type": "string", "maxLength": 253, "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"}, "certKey": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*$"}, "keyKey": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*$"}}},
        "workerCaSecretRef": {"type": "object", "additionalProperties": false, "properties": {"name": {"type": "string", "maxLength": 253, "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"}, "key": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*$"}}},
        "keyringSecretRef": {"type": "object", "additionalProperties": false, "dependencies": {"name": ["key"], "key": ["name"]}, "properties": {"name": {"type": "string", "maxLength": 253, "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"}, "key": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*$"}}},
        "publication": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "contract": {"type": "object"}
          }
        }
      }
    },
    "certManager": {"type": "object", "additionalProperties": false, "required": ["enabled", "renewalOwner", "renewalMechanism", "issuer", "certificate"], "properties": {"enabled": {"type": "boolean"}, "renewalOwner": {"type": "string", "maxLength": 256}, "renewalMechanism": {"const": "cert-manager"}, "issuer": {"type": "object", "additionalProperties": false, "required": ["name", "acmeServer", "accountSecretName", "acmeAuthorizationRef", "ingressClassName", "nodeSelector"], "properties": {"create": {"type": "boolean"}, "name": {"type": "string", "pattern": "^(|[a-z0-9]([-a-z0-9.]*[a-z0-9])?)$"}, "acmeServer": {"type": "string", "pattern": "^(|https://[^\\s]+)$"}, "accountSecretName": {"type": "string", "maxLength": 253, "pattern": "^(?:|[a-z0-9]([-a-z0-9]*[a-z0-9])?)$"}, "acmeAuthorizationRef": {"type": "string", "maxLength": 512}, "ingressClassName": {"type": "string", "pattern": "^(|[a-z0-9]([-a-z0-9.]*[a-z0-9])?)$"}, "nodeSelector": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}}}, "certificate": {"type": "object", "additionalProperties": false, "required": ["name", "secretName", "dnsNames"], "properties": {"name": {"type": "string", "pattern": "^(|[a-z0-9]([-a-z0-9.]*[a-z0-9])?)$"}, "secretName": {"type": "string", "pattern": "^(|[a-z0-9]([-a-z0-9.]*[a-z0-9])?)$"}, "dnsNames": {"type": "array", "maxItems": 1, "items": {"type": "string", "minLength": 1}}}}}, "allOf": [{"if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]}, "then": {"required": ["renewalOwner"], "properties": {"renewalOwner": {"minLength": 1}, "issuer": {"required": ["name", "acmeServer", "accountSecretName", "acmeAuthorizationRef", "ingressClassName"], "properties": {"name": {"minLength": 1}, "acmeAuthorizationRef": {"minLength": 1}}}, "certificate": {"required": ["name", "secretName", "dnsNames"], "properties": {"name": {"minLength": 1}, "secretName": {"minLength": 1}, "dnsNames": {"minItems": 1, "maxItems": 1}}}}}}]},
    "files": {
      "type": "object",
