# Use a fresh private state directory outside the repository for each run.
# The kubeconfig must address an isolated local kind cluster with a working CNI.
export PLATFORM_RELAY_PROBE_KUBECONFIG=/absolute/private/path/kind-kubeconfig
export PLATFORM_RELAY_PROBE_CONTEXT=kind-agent-infra-local
export PLATFORM_RELAY_PROBE_NAMESPACE=agent-infra-local
export PLATFORM_RELAY_PROBE_STATE_DIRECTORY=/absolute/private/path/relay-probe-run-001
# Use the existing pinned Node base image; load it into kind if the cluster
# cannot pull this digest. No new image build is required by the probe.
export PLATFORM_RELAY_PROBE_IMAGE=node:24-alpine@sha256:50c8e8ca1d27439048670df5883f32d57cf81cff6233222c893fd0d9884cbd81
