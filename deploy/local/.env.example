# Load only this reviewed local file; do not commit actual deployment material.
export PLATFORM_LOCAL_DOCKER_CONTEXT=colima
export PLATFORM_LOCAL_PROJECT=agent-infra-e2e
# Pick unused loopback ports when another local project is running.
export PLATFORM_LOCAL_POSTGRES_PORT=54329
export PLATFORM_LOCAL_OBJECT_STORAGE_PORT=9000
export PLATFORM_LOCAL_OBJECT_STORAGE_CONSOLE_PORT=9001
export PLATFORM_LOCAL_API_PORT=3000
export PLATFORM_LOCAL_WEB_PORT=3001
export PLATFORM_LOCAL_CONNECTION_API_PORT=3002
# The container DNS in Colima may not resolve the enterprise LDAP/source hosts.
# Keep these host mappings private and verify them before each run.
export PLATFORM_LOCAL_LDAP_HOST=ldap.example.invalid
export PLATFORM_LOCAL_LDAP_HOST_IP=REPLACE_WITH_LDAP_HOST_IP
export PLATFORM_LOCAL_DIRECTORY_SOURCE_HOST=directory-source.example.invalid
export PLATFORM_LOCAL_DIRECTORY_SOURCE_HOST_IP=REPLACE_WITH_DIRECTORY_SOURCE_HOST_IP
# The directory image is built from the current source for local E2E. Its
# source directory contains only private runtime files (token, TLS and source adapter).
export PLATFORM_LOCAL_DIRECTORY_IMAGE=agent-infra-e2e-enterprise-directory-sync
export PLATFORM_LOCAL_DIRECTORY_SOURCE_DIR=/absolute/private/path/enterprise-directory
export PLATFORM_LOCAL_DIRECTORY_CORP_ID=REPLACE_WITH_PRIVATE_CORP_ID
export PLATFORM_LOCAL_DIRECTORY_MIGRATION_DATABASE_URL=postgresql://agent_infra:REPLACE_WITH_PASSWORD@postgres:5432/agent_infra
export PLATFORM_LOCAL_DIRECTORY_DATABASE_URL=postgresql://directory_runtime:REPLACE_WITH_PASSWORD@postgres:5432/agent_infra
export PLATFORM_LOCAL_DIRECTORY_RUNTIME_DATABASE_ROLE=directory_runtime
# This directory contains the reviewed API-only configuration.mjs and its imports.
# Never place a Worker private key or Kubernetes credential in this directory.
export PLATFORM_LOCAL_API_DIRECTORY=/absolute/private/path/platform-api
export PLATFORM_PUBLIC_ORIGIN=https://localhost:3001
# Generate one Base64URL token from at least 32 random bytes in a file owned by
# your user with mode 0600. Keep it outside the repository.
# API reads it from /run/secrets/platform_proxy_token; local nginx uses the same value.
export PLATFORM_LOCAL_PROXY_TOKEN_FILE=/absolute/private/path/platform-proxy-token
export PLATFORM_WEB_TLS_CERT_FILE=/absolute/private/path/localhost.crt
export PLATFORM_WEB_TLS_KEY_FILE=/absolute/private/path/localhost.key
# Optional private host directory for generated nginx configuration.
# export PLATFORM_LOCAL_STATE_DIRECTORY=/absolute/private/path/agent-infra-local-state
# Worker Helm release uses PLATFORM_LOCAL_PROJECT as its release name.
# Use a private kind kubeconfig whose loopback API port matches the control-plane
# container in PLATFORM_LOCAL_DOCKER_CONTEXT. Namespace must match the project.
export PLATFORM_LOCAL_KUBECONFIG=/absolute/private/path/kind-kubeconfig
export PLATFORM_LOCAL_KUBE_CONTEXT=kind-agent-infra-e2e
export PLATFORM_LOCAL_NAMESPACE=agent-infra-e2e
# This file pins the final Worker image digest, reviewed configurationModuleSecretRef
# and Worker-only runtimeAuthSecretRef. The script derives the Worker database
# Secret from the Compose API URL and binds the first-party module path.
export PLATFORM_LOCAL_WORKER_VALUES=/absolute/private/path/platform-worker.values.yaml
# The Harness publishes this private Worker configuration.mjs into
# platformWorker.configurationModuleSecretRef.
export PLATFORM_LOCAL_WORKER_CONFIGURATION=/absolute/private/path/platform-worker/configuration.mjs
# Colon-separated CA files the Worker must trust (for example the directory
# service and local Registry CAs). Worker -> Runtime is in-cluster HTTP.
export E2E_WORKER_TRUSTED_CA_FILES=/absolute/private/path/directory/tls.crt
# Optional colon-separated private read-only Worker inputs (for example
# directory identity bindings); each file name becomes a key under
# /var/run/agent-infra/deployment/ in the Worker module Secret.
# export E2E_WORKER_DEPLOYMENT_FILES=/absolute/private/path/directory-identity-bindings.json
# Optional private cluster DNS forward zones when the Colima resolver cannot
# resolve external model endpoints: zone=ip,ip;zone=ip
# export E2E_CLUSTER_DNS_FORWARD=example.com=192.0.2.1,198.51.100.1
# Optional comma-separated PVC names for an explicitly owned Agent reset.
# Each name is checked against the canonical Agent name, namespace and
# matching live StatefulSet metadata; leave unset to preserve all Agent PVCs.
# export PLATFORM_LOCAL_AGENT_PVC_NAMES=agent-runtime-data
# GHCR is public for reusable Runtime/infrastructure images. Platform business
# images remain local for E2E and are only published by release/tag Actions.
export AGENT_INFRA_GHCR_PREFIX=ghcr.io/agoraio-extensions/agent-infra
