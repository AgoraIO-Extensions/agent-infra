# Load only this reviewed local file; do not commit actual deployment material.
export PLATFORM_LOCAL_DOCKER_CONTEXT=colima
export PLATFORM_LOCAL_PROJECT=agent-infra-local
# Pick unused loopback ports when another local project is running.
export PLATFORM_LOCAL_POSTGRES_PORT=54329
export PLATFORM_LOCAL_OBJECT_STORAGE_PORT=9000
export PLATFORM_LOCAL_OBJECT_STORAGE_CONSOLE_PORT=9001
export PLATFORM_LOCAL_API_PORT=3000
export PLATFORM_LOCAL_WEB_PORT=3001
# This directory contains the reviewed API-only configuration.mjs and its imports.
# Never place a Worker private key or Kubernetes credential in this directory.
export PLATFORM_LOCAL_API_DIRECTORY=/absolute/private/path/platform-api
# Generate one Base64URL token from at least 32 random bytes in a file owned by
# your user with mode 0600. Keep it outside the repository.
# API reads it from /run/secrets/platform_proxy_token; local nginx uses the same value.
export PLATFORM_LOCAL_PROXY_TOKEN_FILE=/absolute/private/path/platform-proxy-token
export PLATFORM_WEB_TLS_CERT_FILE=/absolute/private/path/localhost.crt
export PLATFORM_WEB_TLS_KEY_FILE=/absolute/private/path/localhost.key
# Optional private host directory for generated nginx configuration.
# export PLATFORM_LOCAL_STATE_DIRECTORY=/absolute/private/path/agent-infra-local-state
# Worker Helm release uses PLATFORM_LOCAL_PROJECT as its release name.
# Use a private kind kubeconfig whose loopback API port matches the control-plane
# container in PLATFORM_LOCAL_DOCKER_CONTEXT. Namespace must match the project.
export PLATFORM_LOCAL_KUBECONFIG=/absolute/private/path/kind-kubeconfig
export PLATFORM_LOCAL_KUBE_CONTEXT=kind-agent-infra-local
export PLATFORM_LOCAL_NAMESPACE=agent-infra-local
# This file pins the final Worker image digest, reviewed configurationModuleSecretRef
# and Worker-only runtimeAuthSecretRef. The script derives the Worker database
# Secret from the Compose API URL and binds the first-party module path.
export PLATFORM_LOCAL_WORKER_VALUES=/absolute/private/path/platform-worker.values.yaml
# Optional comma-separated PVC names for an explicitly owned Agent reset.
# Each name is checked against the canonical Agent name, namespace and
# matching live StatefulSet metadata; leave unset to preserve all Agent PVCs.
# export PLATFORM_LOCAL_AGENT_PVC_NAMES=agent-runtime-data
