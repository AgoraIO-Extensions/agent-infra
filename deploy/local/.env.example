# Load only this reviewed local file; do not commit actual deployment material.
export PLATFORM_LOCAL_DOCKER_CONTEXT=colima
export PLATFORM_LOCAL_PROJECT=agent-infra-local-development
# This directory contains platform-api.mjs, its identity integration and API-only configuration.
# Never place a Worker private key or Kubernetes credential in this directory.
export PLATFORM_LOCAL_API_DIRECTORY=/absolute/private/path/platform-api
export PLATFORM_WEB_TLS_CERT_FILE=/absolute/private/path/localhost.crt
export PLATFORM_WEB_TLS_KEY_FILE=/absolute/private/path/localhost.key
# Worker Helm release uses PLATFORM_LOCAL_PROJECT as its release name.
# Use a private kind kubeconfig with a loopback API server and an existing namespace.
export PLATFORM_LOCAL_KUBECONFIG=/absolute/private/path/kind-kubeconfig
export PLATFORM_LOCAL_KUBE_CONTEXT=kind-agent-infra-local
export PLATFORM_LOCAL_NAMESPACE=agent-infra-local
# This file pins the final Worker image digest, module path and Worker-only Secret refs.
export PLATFORM_LOCAL_WORKER_VALUES=/absolute/private/path/platform-worker.values.yaml
