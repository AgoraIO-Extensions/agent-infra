{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "version",
    "source",
    "runtime",
    "extraRoot",
    "packageRoot",
    "entryPath",
    "files",
    "packageDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "const": "workspace-summary"
    },
    "version": {
      "const": "0.1.0-candidate.1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "path"
      ],
      "properties": {
        "repository": {
          "const": "AgoraIO-Extensions/agent-infra"
        },
        "path": {
          "const": "deploy/runtime/skills/workspace-summary"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "version",
        "upstreamCommit"
      ],
      "properties": {
        "kind": {
          "const": "codex"
        },
        "version": {
          "const": "0.153.0"
        },
        "upstreamCommit": {
          "const": "41e22fee981a63b3698df7ed36bad393cda24715"
        }
      }
    },
    "extraRoot": {
      "const": "/opt/codex/agent-infra-skills"
    },
    "packageRoot": {
      "const": "/opt/codex/agent-infra-skills/workspace-summary"
    },
    "entryPath": {
      "const": "/opt/codex/agent-infra-skills/workspace-summary/SKILL.md"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sizeBytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "const": "SKILL.md"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "packageDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "sha256"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256-json-file-inventory-v1"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
