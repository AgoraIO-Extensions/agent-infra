+    let factory = Arc::new(Recorder {
+        allow: true,
+        facts: Arc::clone(&facts),
+        finish_gate: Some(Arc::clone(&gate)),
+    });
+    with_native_mcp_factory(factory, async {
+        let mut message = request(1);
+        let _registration = bind(&mut message);
+        let (client, mut peer) = tokio::io::duplex(4096);
+        let (read, write) = tokio::io::split(client);
+        let mut transport = NativeTransport {
+            inner: AsyncRwTransport::new_client(read, write),
+            http: false,
+            routes: Arc::new(Mutex::new(HashMap::new())),
+            pending_message: None,
+        };
+        transport.send(message).await.unwrap();
+        peer.write_all(b"{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"content\":[]}}\n")
+            .await
