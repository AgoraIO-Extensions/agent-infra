+#[test]
+fn wire_rejects_null_noncanonical_uuid_and_extra_response_fields() {
+    let request = request();
+    let base = serde_json::json!({
+        "schemaVersion": 1,
+        "requestId": request.request_id,
+        "phase": "intent",
+        "identity": request.identity,
+        "decision": "permit",
+        "permitId": "00000000-0000-4000-8000-abcdef000001",
+        "expiresAt": 5001,
+    });
+    assert!(serde_json::from_value::<Response>(base.clone()).is_ok());
+    for field in ["reason", "permitId", "expiresAt"] {
+        let mut invalid = base.clone();
+        invalid[field] = serde_json::Value::Null;
+        assert!(serde_json::from_value::<Response>(invalid).is_err());
+    }
+    let mut invalid = base.clone();
+    invalid["permitId"] = serde_json::json!("00000000-0000-4000-8000-ABCDEF000001");
+    assert!(serde_json::from_value::<Response>(invalid).is_err());
+    let mut invalid = base.clone();
+    invalid["identity"]["parentAttemptRef"] = serde_json::Value::Null;
+    assert!(serde_json::from_value::<Response>(invalid).is_err());
+    let mut invalid = base;
+    invalid["ignored"] = serde_json::json!(true);
