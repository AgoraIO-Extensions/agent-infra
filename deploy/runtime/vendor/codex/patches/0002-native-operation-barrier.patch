diff --git a/codex-rs/rmcp-client/src/native_dispatch.rs b/codex-rs/rmcp-client/src/native_dispatch.rs
new file mode 100644
index 0000000..a0b0ad3
--- /dev/null
+++ b/codex-rs/rmcp-client/src/native_dispatch.rs
@@ -0,0 +1,402 @@
+//! Private correlation through existing rmcp transports; no new MCP wire method.
+use rmcp::model::ClientRequest;
+use rmcp::model::JsonRpcMessage;
+use rmcp::model::RequestId;
+use rmcp::model::ServerResult;
+use rmcp::service::RoleClient;
+use rmcp::service::RxJsonRpcMessage;
+use rmcp::service::TxJsonRpcMessage;
+use rmcp::transport::IntoTransport;
+use rmcp::transport::Transport;
+use std::collections::HashMap;
+use std::future::Future;
+use std::io;
+use std::pin::Pin;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::OnceLock;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::Ordering;
+
+const TAG: &str = "_agentInfraNativeDispatch";
+type Callback<'a, T> = Pin<Box<dyn Future<Output = io::Result<T>> + Send + 'a>>;
+
+/// Core supplies immutable native identity. Transports request a fresh attempt
+/// for each actual write/HTTP dispatch, including existing SDK retries.
+pub trait NativeMcpFactory: Send + Sync {
+    fn begin(&self) -> Callback<'_, Arc<dyn NativeMcpAttempt>>;
+}
+/// Persistence callbacks contain no arguments, transport bytes, or credentials.
+pub trait NativeMcpAttempt: Send + Sync {
+    fn check_dispatch(&self) -> io::Result<()>;
+    fn started(&self) -> Callback<'_, ()>;
+    fn finish(&self, result: NativeMcpResult) -> Callback<'_, ()>;
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum NativeMcpResult {
+    Completed,
+    Failed,
+    UnconfirmedResponse,
+    Unknown,
+    CancelledBeforeDispatch,
+}
+
+tokio::task_local! { static FACTORY: Arc<dyn NativeMcpFactory>; }
+pub async fn with_native_mcp_factory<T>(
+    factory: Arc<dyn NativeMcpFactory>,
+    work: impl Future<Output = T>,
+) -> T {
+    FACTORY.scope(factory, work).await
+}
+
+struct Call {
+    factory: Arc<dyn NativeMcpFactory>,
+    active: AtomicBool,
+    attempts: Mutex<HashMap<RequestId, Arc<dyn NativeMcpAttempt>>>,
+}
+fn calls() -> &'static Mutex<HashMap<String, Arc<Call>>> {
+    static CALLS: OnceLock<Mutex<HashMap<String, Arc<Call>>>> = OnceLock::new();
+    CALLS.get_or_init(Mutex::default)
+}
+fn unavailable() -> io::Error {
+    io::Error::other("NATIVE_OPERATION_BARRIER_UNAVAILABLE")
+}
+
+pub(crate) struct Registration {
+    token: String,
+    call: Arc<Call>,
+}
+impl Registration {
+    pub(crate) fn bind(meta: &mut Option<rmcp::model::RequestMetaObject>) -> io::Result<Self> {
+        let factory = FACTORY.try_with(Arc::clone).map_err(|_| unavailable())?;
+        static NEXT_TOKEN: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(1);
+        let token = NEXT_TOKEN
+            .fetch_update(Ordering::SeqCst, Ordering::SeqCst, |value| {
+                value.checked_add(1)
+            })
+            .map_err(|_| unavailable())?
+            .to_string();
+        let call = Arc::new(Call {
+            factory,
+            active: AtomicBool::new(true),
+            attempts: Mutex::default(),
+        });
+        let mut calls = calls().lock().map_err(|_| unavailable())?;
+        if calls.len() >= 1024 {
+            return Err(unavailable());
+        }
+        let meta = meta.get_or_insert_with(Default::default);
+        if meta.contains_key(TAG) {
+            return Err(unavailable());
+        }
+        meta.insert(TAG.to_owned(), serde_json::Value::String(token.clone()));
+        calls.insert(token.clone(), Arc::clone(&call));
+        Ok(Self { token, call })
+    }
+    pub(crate) async fn finish_pending(&self) -> io::Result<()> {
+        let attempts = self
+            .call
+            .attempts
+            .lock()
+            .map_err(|_| unavailable())?
+            .iter()
+            .map(|(id, attempt)| (id.clone(), Arc::clone(attempt)))
+            .collect::<Vec<_>>();
+        let mut result = Ok(());
+        for (id, attempt) in attempts {
+            if let Err(error) = attempt.finish(NativeMcpResult::Unknown).await {
+                result = Err(error);
+            } else {
+                self.call
+                    .attempts
+                    .lock()
+                    .map_err(|_| unavailable())?
+                    .remove(&id);
+            }
+        }
+        result
+    }
+}
+impl Drop for Registration {
+    fn drop(&mut self) {
+        self.call.active.store(false, Ordering::Release);
+        if let Ok(mut calls) = calls().lock() {
+            calls.remove(&self.token);
+        }
+        let attempts = self
+            .call
+            .attempts
+            .lock()
+            .map(|mut a| a.drain().map(|(_, a)| a).collect::<Vec<_>>())
+            .unwrap_or_default();
+        if !attempts.is_empty()
+            && let Ok(runtime) = tokio::runtime::Handle::try_current()
+        {
+            // Drain facts after a cancelled caller; never retry the business action.
+            runtime.spawn(async move {
+                for attempt in attempts {
+                    let _ = attempt.finish(NativeMcpResult::Unknown).await;
+                }
+            });
+        }
+    }
+}
+
+#[derive(Clone)]
+pub(crate) struct Dispatch {
+    call: Arc<Call>,
+    id: RequestId,
+}
+impl Dispatch {
+    pub(crate) fn from_message(
+        message: &mut TxJsonRpcMessage<RoleClient>,
+        strip_tag: bool,
+    ) -> io::Result<Option<Self>> {
+        let JsonRpcMessage::Request(envelope) = message else {
+            return Ok(None);
+        };
+        let ClientRequest::CallToolRequest(request) = &mut envelope.request else {
+            return Ok(None);
+        };
+        let meta = request.params.meta.as_mut().ok_or_else(unavailable)?;
+        let token = meta
+            .get(TAG)
+            .and_then(serde_json::Value::as_str)
+            .ok_or_else(unavailable)?
+            .to_owned();
+        let call = calls()
+            .lock()
+            .map_err(|_| unavailable())?
+            .get(&token)
+            .cloned()
+            .ok_or_else(unavailable)?;
+        if strip_tag {
+            meta.remove(TAG);
+            if let Some(meta) = request
+                .extensions
+                .get_mut::<rmcp::model::RequestMetaObject>()
+            {
+                meta.remove(TAG);
+            }
+        }
+        Ok(Some(Self {
+            call,
+            id: envelope.id.clone(),
+        }))
+    }
+    pub(crate) async fn begin(&self) -> io::Result<()> {
+        if !self.call.active.load(Ordering::Acquire) {
+            return Err(unavailable());
+        }
+        // A retry cannot overwrite an unconfirmed earlier side effect.
+        if self
+            .call
+            .attempts
+            .lock()
+            .map_err(|_| unavailable())?
+            .contains_key(&self.id)
+        {
+            return Err(unavailable());
+        }
+        let attempt = self.call.factory.begin().await?;
+        if !self.call.active.load(Ordering::Acquire) {
+            attempt
+                .finish(NativeMcpResult::CancelledBeforeDispatch)
+                .await?;
+            return Err(unavailable());
+        }
+        if attempt.check_dispatch().is_err() {
+            attempt
+                .finish(NativeMcpResult::CancelledBeforeDispatch)
+                .await?;
+            return Err(unavailable());
+        }
+        self.call
+            .attempts
+            .lock()
+            .map_err(|_| unavailable())?
+            .insert(self.id.clone(), attempt);
+        Ok(())
+    }
+    pub(crate) async fn started(&self) -> io::Result<()> {
+        let attempt = self
+            .call
+            .attempts
+            .lock()
+            .map_err(|_| unavailable())?
+            .get(&self.id)
+            .cloned()
+            .ok_or_else(unavailable)?;
+        attempt.started().await
+    }
+    pub(crate) async fn finish(&self, result: NativeMcpResult) -> io::Result<()> {
+        let attempt = self
+            .call
+            .attempts
+            .lock()
+            .map_err(|_| unavailable())?
+            .get(&self.id)
+            .cloned();
+        if let Some(attempt) = attempt {
+            attempt.finish(result).await?;
+            self.call
+                .attempts
+                .lock()
+                .map_err(|_| unavailable())?
+                .remove(&self.id);
+        }
+        Ok(())
+    }
+}
+
+tokio::task_local! { static HTTP_DISPATCH: Dispatch; }
+pub(crate) fn current_http_dispatch() -> Option<Dispatch> {
+    HTTP_DISPATCH.try_with(Clone::clone).ok()
+}
+impl Dispatch {
+    pub(crate) async fn scope_http<T>(&self, work: impl Future<Output = T>) -> T {
+        HTTP_DISPATCH.scope(self.clone(), work).await
+    }
+}
+
+/// Wraps the existing transport; HTTP waits for its adapter's actual HTTP receipt.
+pub(crate) fn transport<T, E, A>(
+    inner: T,
+    http: bool,
+) -> impl Transport<RoleClient, Error = io::Error> + 'static
+where
+    T: IntoTransport<RoleClient, E, A>,
+    E: std::error::Error + Send + Sync + 'static,
+{
+    NativeTransport {
+        inner: inner.into_transport(),
+        http,
+        routes: Arc::new(Mutex::new(HashMap::new())),
+        pending_message: None,
+    }
+}
+struct NativeTransport<T> {
+    inner: T,
+    http: bool,
+    routes: Arc<Mutex<HashMap<RequestId, Dispatch>>>,
+    pending_message: Option<RxJsonRpcMessage<RoleClient>>,
+}
+impl<T> NativeTransport<T> {
+    async fn finish_routes(&mut self) -> io::Result<()> {
+        let routes = self
+            .routes
+            .lock()
+            .map_err(|_| unavailable())?
+            .values()
+            .cloned()
+            .collect::<Vec<_>>();
+        let mut result = Ok(());
+        for dispatch in routes {
+            if let Err(error) = dispatch.finish(NativeMcpResult::Unknown).await {
+                result = Err(error);
+            } else {
+                self.routes
+                    .lock()
+                    .map_err(|_| unavailable())?
+                    .remove(&dispatch.id);
+            }
+        }
+        result
+    }
+}
+impl<T: Transport<RoleClient> + 'static> Transport<RoleClient> for NativeTransport<T> {
+    type Error = io::Error;
+    fn send(
+        &mut self,
+        mut message: TxJsonRpcMessage<RoleClient>,
+    ) -> impl Future<Output = io::Result<()>> + Send + 'static {
+        let dispatch = Dispatch::from_message(&mut message, !self.http).and_then(|dispatch| {
+            if let Some(dispatch) = &dispatch {
+                let mut routes = self.routes.lock().map_err(|_| unavailable())?;
+                routes.retain(|_, route| route.call.active.load(Ordering::Acquire));
+                if routes.len() >= 1024 || routes.contains_key(&dispatch.id) {
+                    return Err(unavailable());
+                }
+                routes.insert(dispatch.id.clone(), dispatch.clone());
+            }
+            Ok(dispatch)
+        });
+        let http = self.http;
+        // Even eager transport setup must not observe an invalid or duplicate call.
+        let send = dispatch.as_ref().ok().map(|_| self.inner.send(message));
+        let routes = Arc::clone(&self.routes);
+        async move {
+            let dispatch = dispatch?;
+            let result = async {
+                if !http && let Some(dispatch) = &dispatch {
+                    dispatch.begin().await?;
+                }
+                send.ok_or_else(unavailable)?
+                    .await
+                    .map_err(io::Error::other)?;
+                if !http && let Some(dispatch) = &dispatch {
+                    dispatch.started().await?;
+                }
+                Ok(())
+            }
+            .await;
+            if result.is_err()
+                && let Some(dispatch) = dispatch
+            {
+                routes
+                    .lock()
+                    .map_err(|_| unavailable())?
+                    .remove(&dispatch.id);
+                dispatch.finish(NativeMcpResult::Unknown).await?;
+            }
+            result
+        }
+    }
+    async fn receive(&mut self) -> Option<RxJsonRpcMessage<RoleClient>> {
+        if self.pending_message.is_none() {
+            self.pending_message = self.inner.receive().await;
+        }
+        let Some(message) = self.pending_message.as_ref() else {
+            let _ = self.finish_routes().await;
+            return None;
+        };
+        let (id, result) = match message {
+            JsonRpcMessage::Response(response) => (
+                Some(&response.id),
+                match &response.result {
+                    ServerResult::CallToolResult(result) if result.is_error.unwrap_or(false) => {
+                        NativeMcpResult::Failed
+                    }
+                    ServerResult::CallToolResult(_) => NativeMcpResult::Completed,
+                    // MRTR input_required, task acknowledgements and unrelated
+                    // result shapes do not establish tools/call completion.
+                    _ => NativeMcpResult::UnconfirmedResponse,
+                },
+            ),
+            JsonRpcMessage::Error(error) => (error.id.as_ref(), NativeMcpResult::Failed),
+            _ => (None, NativeMcpResult::Unknown),
+        };
+        let dispatch = match id {
+            Some(id) => self.routes.lock().ok()?.get(id).cloned(),
+            None => None,
+        };
+        if let Some(dispatch) = dispatch {
+            if dispatch.finish(result).await.is_err() {
+                return None;
+            }
+            self.routes.lock().ok()?.remove(&dispatch.id);
+        }
+        // rmcp polls receive inside select!: cancellation while saving a fact
+        // must preserve both this consumed response and its route for the next poll.
+        self.pending_message.take()
+    }
+    async fn close(&mut self) -> io::Result<()> {
+        let close = self.inner.close().await.map_err(io::Error::other);
+        self.finish_routes().await?;
+        close
+    }
+}
