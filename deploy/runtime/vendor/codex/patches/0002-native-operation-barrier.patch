+impl ThreadLifecycleContributor<crate::config::Config> for CleanupGate {
+    fn on_thread_idle<'a>(&'a self, _input: ThreadIdleInput<'a>) -> ExtensionFuture<'a, ()> {
+        Box::pin(async move {
+            self.entered.notify_one();
+            self.release.notified().await;
+        })
+    }
+}
