+#[tokio::test]
+async fn control_rechecks_target_owner_after_waiting_for_the_native_queue() {
+    use std::sync::atomic::AtomicBool;
+    use tokio::sync::Notify;
+
+    let attempt = attempt();
+    let mut target = attempt.identity().clone();
+    target.session_id = Uuid::new_v4().to_string();
+    crate::native_sources::remember_owner(&target, attempt.source_owner()).unwrap();
+    let entered = Arc::new(Notify::new());
+    let release = Arc::new(Notify::new());
+    let dispatched = Arc::new(AtomicBool::new(false));
+    let thread_id = target.session_id.clone();
+    let task_entered = Arc::clone(&entered);
+    let task_release = Arc::clone(&release);
+    let task_dispatched = Arc::clone(&dispatched);
+    let running = tokio::spawn(async move {
+        attempt
+            .scope(crate::native_sources::control_dispatch(
+                &thread_id,
+                async move {
+                    task_entered.notify_one();
+                    task_release.notified().await;
+                    task_dispatched.store(true, Ordering::Release);
+                    Ok::<(), ()>(())
+                },
+            ))
+            .await
+    });
+    entered.notified().await;
+    let source = crate::native_sources::NativeSource {
+        thread_id: target.session_id.clone(),
+        turn_id: target.turn_id.clone(),
+    };
+    crate::native_sources::finished(&source, crate::native_sources::NativeStatus::Completed)
+        .await
+        .unwrap();
+    crate::native_sources::remember_owner(
+        &target,
+        &SourceOwner {
+            root_thread_id: "another-root".into(),
+            root_turn_id: "another-turn".into(),
+        },
+    )
+    .unwrap();
+    release.notify_one();
+    assert_eq!(running.await.unwrap(), Err(BarrierError));
+    assert!(!dispatched.load(Ordering::Acquire));
+}
