+//! Frozen private source messages. These are lifecycle facts, never tool permits.
+use serde::Deserialize;
+use serde::Serialize;
+use uuid::Uuid;
+
+use crate::native_operation_barrier::BarrierError;
+use crate::native_operation_barrier::Identity;
+use crate::native_operation_barrier::canonical_uuid;
+use crate::native_operation_barrier::exchange_validated;
+use crate::native_operation_barrier::now_ms;
+use crate::native_operation_barrier::present;
+
+pub(super) fn valid_id(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 1024
+        && value.chars().count() <= 256
+        && !value.chars().any(char::is_control)
+}
+
+#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(crate) struct SourceOwner {
+    pub root_thread_id: String,
+    pub root_turn_id: String,
+}
+impl SourceOwner {
+    pub(crate) fn valid(&self) -> bool {
+        valid_id(&self.root_thread_id) && valid_id(&self.root_turn_id)
+    }
+}
+
+#[derive(Clone, Debug, Deserialize, Eq, Hash, PartialEq, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(crate) struct NativeSource {
+    pub thread_id: String,
+    pub turn_id: String,
+}
+
+#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(super) struct Reservation {
+    #[serde(deserialize_with = "canonical_uuid")]
+    pub reservation_id: Uuid,
+    pub parent: Identity,
+    #[serde(deserialize_with = "canonical_uuid")]
+    pub parent_permit_id: Uuid,
+    pub child_thread_id: String,
+    pub submission_id: String,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(rename_all = "kebab-case")]
+#[allow(
+    clippy::enum_variant_names,
+    reason = "Names mirror the frozen source-* protocol phases"
+)]
+pub(super) enum Phase {
+    SourceReserve,
+    SourceBind,
+    SourceNotStarted,
+    SourceTerminal,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub(super) enum Delivery {
+    Started,
+    Steered,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub(super) enum Stage {
+    NotQueued,
+    NotRouted,
+    GateRejected,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub(super) enum Reason {
+    QueueClosed,
+    RoutingRejected,
+    CancelledBeforeStart,
+    BindingDenied,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub(crate) enum NativeStatus {
+    Completed,
+    Failed,
+    Cancelled,
+}
+
+#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(super) struct Request {
+    pub schema_version: u8,
+    #[serde(deserialize_with = "canonical_uuid")]
+    pub request_id: Uuid,
+    pub phase: Phase,
+    pub occurred_at: u64,
+    pub reservation: Reservation,
+    #[serde(
+        default,
+        deserialize_with = "present",
+        skip_serializing_if = "Option::is_none"
+    )]
+    pub source: Option<NativeSource>,
+    #[serde(
+        default,
+        deserialize_with = "present",
+        skip_serializing_if = "Option::is_none"
+    )]
+    pub delivery: Option<Delivery>,
+    #[serde(
+        default,
+        deserialize_with = "present",
+        skip_serializing_if = "Option::is_none"
+    )]
+    pub stage: Option<Stage>,
+    #[serde(
+        default,
+        deserialize_with = "present",
+        skip_serializing_if = "Option::is_none"
+    )]
+    pub reason: Option<Reason>,
+    #[serde(
+        default,
+        deserialize_with = "present",
+        skip_serializing_if = "Option::is_none"
+    )]
+    pub native_status: Option<NativeStatus>,
+}
+
+impl Request {
+    pub(super) fn new(phase: Phase, reservation: &Reservation) -> Result<Self, BarrierError> {
+        Ok(Self {
+            schema_version: 1,
+            request_id: Uuid::new_v4(),
+            phase,
+            occurred_at: now_ms()?,
+            reservation: reservation.clone(),
+            source: None,
+            delivery: None,
+            stage: None,
+            reason: None,
+            native_status: None,
+        })
+    }
+
+    pub(super) async fn exchange(&self, owner: &SourceOwner) -> Result<bool, BarrierError> {
+        let response: Response = exchange_validated(self, |response: &Response, request, _now| {
+            response.validate(request, owner)
+        })
+        .await?;
+        Ok(response.decision == "ack")
+    }
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Response {
+    schema_version: u8,
+    #[serde(deserialize_with = "canonical_uuid")]
+    request_id: Uuid,
+    phase: Phase,
+    request: Request,
+    decision: String,
+    #[serde(default, deserialize_with = "present")]
+    source_owner: Option<SourceOwner>,
+    #[serde(default, deserialize_with = "present")]
+    reason: Option<String>,
+}
+
+impl Response {
+    fn validate(&self, request: &Request, owner: &SourceOwner) -> Result<(), BarrierError> {
+        if self.schema_version != 1
+            || self.request_id != request.request_id
+            || self.phase != request.phase
+            || self.request != *request
+        {
+            return Err(BarrierError);
+        }
+        let valid = match self.decision.as_str() {
+            "ack" => {
+                self.reason.is_none()
+                    && match request.phase {
+                        Phase::SourceReserve | Phase::SourceBind => {
+                            self.source_owner.as_ref() == Some(owner)
+                        }
+                        Phase::SourceNotStarted | Phase::SourceTerminal => {
+                            self.source_owner.is_none()
+                        }
+                    }
+            }
+            "deny" => {
+                self.source_owner.is_none()
+                    && (request.phase == Phase::SourceReserve
+                        || (request.phase == Phase::SourceBind
+                            && request.delivery == Some(Delivery::Started)))
+                    && matches!(
+                        self.reason.as_deref(),
+                        Some(
+                            "authorization_denied"
+                                | "authorization_unavailable"
+                                | "persistence_unavailable"
+                        )
+                    )
+            }
+            _ => false,
+        };
+        if valid { Ok(()) } else { Err(BarrierError) }
+    }
+}
+
