+//! In-process native hook ownership. No hook input or wire contract is extended.
+use std::future::Future;
+use std::io;
+use std::sync::Arc;
+
+use futures::future::BoxFuture;
+
+use crate::HookMcpCall;
+use crate::HookMcpExecutor;
+
+/// Core captures the original task identity and cancellation token before scheduling hooks.
+/// Implementations must obtain a fresh permit at each command or MCP transport dispatch.
+pub trait NativeHookFactory: Send + Sync {
+    /// Reserve original-task activity before spawning; dropping the guard releases it.
+    fn scheduled(&self) -> io::Result<Box<dyn NativeHookTask>>;
+    /// Wait until all scheduled work for the original task has finished.
+    fn drain(&self) -> BoxFuture<'_, io::Result<()>>;
+    /// Observe the original task's cancellation while waiting for session capacity.
+    fn cancelled(&self) -> BoxFuture<'_, ()>;
+
+    fn begin_command(
+        &self,
+        run_id: String,
+        event_name: &'static str,
+    ) -> BoxFuture<'_, io::Result<Arc<dyn NativeHookAttempt>>>;
+
+    fn execute_mcp<'a>(
+        &'a self,
+        run_id: String,
+        event_name: &'static str,
+        executor: &'a dyn HookMcpExecutor,
+        call: HookMcpCall,
+    ) -> BoxFuture<'a, anyhow::Result<String>>;
+}
+
+/// A scheduling reservation owned by the original native task. Implementations release
+/// their activity count in Drop; the guard must outlive queued and executing hook work.
+pub trait NativeHookTask: Send {}
+
+/// Receipts describe process lifecycle only; command input and output never enter facts.
+pub trait NativeHookAttempt: Send + Sync {
+    fn check_dispatch(&self) -> io::Result<()>;
+    fn started(&self) -> BoxFuture<'_, io::Result<()>>;
+    fn cancelled(&self) -> BoxFuture<'_, ()>;
+    fn finish(&self, result: NativeHookResult) -> BoxFuture<'_, io::Result<()>>;
+}
+
+#[derive(Clone, Copy)]
+pub enum NativeHookResult {
+    Completed,
+    Failed,
+    Unknown,
+}
+
+tokio::task_local! { static FACTORY: Arc<dyn NativeHookFactory>; }
+
+pub async fn with_native_hook_factory<T>(
+    factory: Arc<dyn NativeHookFactory>,
+    work: impl Future<Output = T>,
+) -> T {
+    FACTORY.scope(factory, work).await
+}
+
+pub async fn drain_native_hook_tasks() -> io::Result<()> {
+    current()?.drain().await
+}
+
+pub(crate) fn current() -> io::Result<Arc<dyn NativeHookFactory>> {
+    FACTORY
+        .try_with(Arc::clone)
+        .map_err(|_| io::Error::other("NATIVE_HOOK_EXECUTION_CONTEXT_UNAVAILABLE"))
+}
+
+pub(crate) struct CommandAttempt {
+    pub attempt: Arc<dyn NativeHookAttempt>,
+    pub dispatched: bool,
+    finished: bool,
+    task: Option<Box<dyn NativeHookTask>>,
+}
+
+impl CommandAttempt {
+    pub async fn begin(run_id: String, event_name: &'static str) -> io::Result<Self> {
+        let factory = current()?;
+        let task = factory.scheduled()?;
+        Ok(Self {
+            attempt: factory.begin_command(run_id, event_name).await?,
+            dispatched: false,
+            finished: false,
+            task: Some(task),
+        })
+    }
+    pub async fn finish(&mut self, result: NativeHookResult) -> io::Result<()> {
+        self.attempt.finish(result).await?;
+        self.finished = true;
+        Ok(())
+    }
+}
+
+impl Drop for CommandAttempt {
+    fn drop(&mut self) {
+        if !self.finished
+            && let Ok(runtime) = tokio::runtime::Handle::try_current()
+        {
+            let attempt = Arc::clone(&self.attempt);
+            let task = self.task.take();
+            let result = if self.dispatched {
+                NativeHookResult::Unknown
+            } else {
+                NativeHookResult::Failed
+            };
+            runtime.spawn(async move {
+                let _task = task;
+                let _ = attempt.finish(result).await;
+            });
+        }
+    }
+}
