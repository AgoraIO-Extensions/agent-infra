+
+#[derive(Debug, PartialEq, Eq)]
+enum Fact {
+    Intent,
+    Started,
+    Outcome(NativeMcpResult),
+}
+
+struct Recorder {
+    allow: bool,
+    facts: Arc<Mutex<Vec<Fact>>>,
+    finish_gate: Option<Arc<tokio::sync::Semaphore>>,
+}
+
+impl NativeMcpFactory for Recorder {
+    fn begin(&self) -> Callback<'_, Arc<dyn NativeMcpAttempt>> {
+        Box::pin(async {
+            self.facts.lock().unwrap().push(Fact::Intent);
+            Ok(Arc::new(Self {
+                allow: self.allow,
+                facts: Arc::clone(&self.facts),
+                finish_gate: self.finish_gate.clone(),
+            }) as Arc<dyn NativeMcpAttempt>)
+        })
+    }
+}
+
+impl NativeMcpAttempt for Recorder {
+    fn check_dispatch(&self) -> io::Result<()> {
+        if self.allow {
+            Ok(())
+        } else {
+            Err(unavailable())
+        }
+    }
+
+    fn started(&self) -> Callback<'_, ()> {
+        Box::pin(async {
+            self.facts.lock().unwrap().push(Fact::Started);
+            Ok(())
+        })
+    }
+
+    fn finish(&self, result: NativeMcpResult) -> Callback<'_, ()> {
+        Box::pin(async move {
+            if let Some(gate) = &self.finish_gate {
+                gate.acquire().await.map_err(|_| unavailable())?.forget();
+            }
+            self.facts.lock().unwrap().push(Fact::Outcome(result));
+            Ok(())
+        })
+    }
+}
+
+fn request(id: i64) -> TxJsonRpcMessage<RoleClient> {
+    serde_json::from_value(serde_json::json!({
+        "jsonrpc": "2.0", "id": id, "method": "tools/call",
+        "params": { "name": "test", "arguments": {} }
+    }))
+    .unwrap()
+}
+
+fn bind(message: &mut TxJsonRpcMessage<RoleClient>) -> Registration {
+    let JsonRpcMessage::Request(envelope) = message else {
+        panic!("expected request")
+    };
+    let ClientRequest::CallToolRequest(request) = &mut envelope.request else {
+        panic!("expected tools/call")
+    };
+    Registration::bind(&mut request.params.meta).unwrap()
+}
