+#[tokio::test]
+async fn stdio_waits_for_permit_and_strips_private_correlation_from_wire() {
+    let facts = Arc::new(Mutex::new(Vec::new()));
+    let factory = Arc::new(Recorder {
+        allow: true,
+        facts: Arc::clone(&facts),
+        finish_gate: None,
+    });
+    with_native_mcp_factory(factory, async {
+        let mut message = request(1);
+        let _registration = bind(&mut message);
+        let (client, peer) = tokio::io::duplex(4096);
+        let (read, write) = tokio::io::split(client);
+        let mut transport = transport(
+            AsyncRwTransport::new_client(read, write),
+            /*http*/ false,
+        );
+        let mut peer = BufReader::new(peer);
+        transport.send(message).await.unwrap();
+        let mut line = String::new();
+        peer.read_line(&mut line).await.unwrap();
+        assert!(!line.contains(TAG));
+        let value: serde_json::Value = serde_json::from_str(&line).unwrap();
+        assert_eq!(value["method"], "tools/call");
+        assert_eq!(*facts.lock().unwrap(), vec![Fact::Intent, Fact::Started]);
+        peer.get_mut()
+            .write_all(b"{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"content\":[]}}\n")
+            .await
+            .unwrap();
+        assert!(transport.receive().await.is_some());
+        assert_eq!(
+            *facts.lock().unwrap(),
+            vec![
+                Fact::Intent,
+                Fact::Started,
+                Fact::Outcome(NativeMcpResult::Completed)
+            ]
+        );
+    })
+    .await;
