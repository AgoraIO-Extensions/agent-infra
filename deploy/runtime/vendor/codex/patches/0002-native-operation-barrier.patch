+        assert!(transport.pending_message.is_none());
+        assert!(transport.routes.lock().unwrap().is_empty());
+        assert_eq!(
+            *facts.lock().unwrap(),
+            vec![
+                Fact::Intent,
+                Fact::Started,
+                Fact::Outcome(NativeMcpResult::Completed)
+            ]
+        );
+    })
+    .await;
