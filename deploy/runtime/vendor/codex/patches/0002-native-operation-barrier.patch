+    .await;
+    assert_eq!(factory.scheduled_count.load(Ordering::SeqCst), 1);
+    let drain = with_native_hook_factory(factory.clone(), drain_native_hook_tasks());
+    tokio::pin!(drain);
+    assert!(
+        tokio::time::timeout(std::time::Duration::from_millis(20), &mut drain)
+            .await
+            .is_err()
+    );
+    drop(held);
+    received.await.expect("queued task starts");
+    assert!(
+        tokio::time::timeout(std::time::Duration::from_millis(20), &mut drain)
+            .await
+            .is_err()
+    );
+    finish.send(()).expect("finish");
+    tokio::time::timeout(std::time::Duration::from_secs(2), drain)
+        .await
+        .expect("drained")
+        .expect("accounting");
+    assert_eq!(factory.scheduled_count.load(Ordering::SeqCst), 0);
+    runtime.shutdown().await;
+}
+
+#[tokio::test]
+async fn cancelled_queued_original_task_drains_without_session_capacity() {
+    let temp = tempdir().expect("tempdir");
+    let (runtime, _) = fixture(temp.path(), "");
+    let capacity = Arc::clone(&runtime.lock_state().concurrency_limit);
+    let held = capacity
+        .acquire_many_owned(super::MAX_CONCURRENT_ASYNC_HOOKS as u32)
+        .await
+        .expect("hold all session hook capacity");
+    let cancellation = Arc::new(Notify::new());
+    let factory = Arc::new(RecordingFactory {
+        cancellation: Some(cancellation.clone()),
+        ..Default::default()
+    });
+    let (started, received) = oneshot::channel();
+    with_native_hook_factory(factory.clone(), async {
+        runtime.schedule_async_task(async move {
+            let _ = started.send(());
+        });
+    })
+    .await;
+    assert_eq!(factory.scheduled_count.load(Ordering::SeqCst), 1);
+    cancellation.notify_one();
+    tokio::time::timeout(
+        std::time::Duration::from_secs(2),
+        with_native_hook_factory(factory.clone(), drain_native_hook_tasks()),
+    )
+    .await
+    .expect("cancelled queue must drain")
+    .expect("accounting");
+    assert!(received.await.is_err());
+    assert_eq!(factory.scheduled_count.load(Ordering::SeqCst), 0);
+    drop(held);
+    runtime.shutdown().await;
+}
