+#[tokio::test]
+async fn native_root_completion_waits_for_idle_cleanup() {
+    let (mut session, turn, events) = make_session_and_context_with_rx().await;
+    let gate = Arc::new(CleanupGate {
+        entered: tokio::sync::Notify::new(),
+        release: tokio::sync::Notify::new(),
+    });
+    let mut builder = codex_extension_api::ExtensionRegistryBuilder::<crate::config::Config>::new();
+    builder.thread_lifecycle_contributor(gate.clone());
+    Arc::get_mut(&mut session).unwrap().services.extensions = Arc::new(builder.build());
+    session
+        .spawn_task(turn, Vec::new(), FinishesImmediately)
+        .await;
+    timeout(StdDuration::from_secs(5), gate.entered.notified())
+        .await
+        .unwrap();
+    while let Ok(event) = events.try_recv() {
+        assert!(
+            !matches!(
+                event.msg,
+                EventMsg::TurnComplete(_) | EventMsg::TurnAborted(_)
+            ),
+            "terminal event preceded cleanup"
+        );
+    }
+    gate.release.notify_one();
+    timeout(StdDuration::from_secs(5), async {
+        loop {
+            if matches!(events.recv().await.unwrap().msg, EventMsg::TurnComplete(_)) {
+                break;
+            }
+        }
+    })
+    .await
+    .unwrap();
+}
