+use super::*;
+use pretty_assertions::assert_eq;
+
+fn owner() -> SourceOwner {
+    SourceOwner {
+        root_thread_id: "root-thread".into(),
+        root_turn_id: "root-turn".into(),
+    }
+}
+
+fn request(phase: Phase) -> Request {
+    let reservation = Reservation {
+        reservation_id: Uuid::new_v4(),
+        parent: Identity {
+            session_id: "parent-thread".into(),
+            turn_id: "parent-turn".into(),
+            call_id: "spawn-call".into(),
+            attempt_ref: Uuid::new_v4(),
+            tool_name: "spawn_agent".into(),
+            parent_attempt_ref: None,
+        },
+        parent_permit_id: Uuid::new_v4(),
+        child_thread_id: "child-thread".into(),
+        submission_id: "actual-submission".into(),
+    };
+    let mut request = Request::new(phase, &reservation).unwrap();
+    if phase != Phase::SourceReserve {
+        request.source = Some(NativeSource {
+            thread_id: "child-thread".into(),
+            turn_id: "actual-submission".into(),
+        });
+    }
+    match phase {
+        Phase::SourceBind => request.delivery = Some(Delivery::Started),
+        Phase::SourceTerminal => request.native_status = Some(NativeStatus::Completed),
+        Phase::SourceNotStarted => {
+            request.stage = Some(Stage::GateRejected);
+            request.reason = Some(Reason::BindingDenied);
+        }
+        Phase::SourceReserve => {}
+    }
+    request
+}
+
+fn response(request: &Request) -> Response {
+    Response {
+        schema_version: 1,
+        request_id: request.request_id,
+        phase: request.phase,
+        request: request.clone(),
+        decision: "ack".into(),
+        reason: None,
+        source_owner: matches!(request.phase, Phase::SourceReserve | Phase::SourceBind).then(owner),
+    }
+}
+
+#[test]
+fn source_reply_cannot_rebind_any_part_of_the_original_delivery() {
+    let request = request(Phase::SourceBind);
+    assert!(response(&request).validate(&request, &owner()).is_ok());
+    let mut mutations = Vec::new();
+    let mut changed = request.clone();
+    changed.reservation.parent.call_id = "different-call".into();
+    mutations.push(changed);
+    let mut changed = request.clone();
+    changed.reservation.parent_permit_id = Uuid::new_v4();
+    mutations.push(changed);
+    let mut changed = request.clone();
+    changed.reservation.submission_id = "different-submission".into();
+    mutations.push(changed);
+    let mut changed = request.clone();
+    changed.source.as_mut().unwrap().turn_id = "different-turn".into();
+    mutations.push(changed);
+    let mut changed = request.clone();
+    changed.delivery = Some(Delivery::Steered);
+    mutations.push(changed);
+    let mut changed = request.clone();
+    changed.occurred_at += 1;
+    mutations.push(changed);
+    for changed in mutations {
+        let mut reply = response(&request);
+        reply.request = changed;
+        assert_eq!(reply.validate(&request, &owner()), Err(BarrierError));
+    }
+    let mut reply = response(&request);
+    reply.source_owner.as_mut().unwrap().root_turn_id = "different-root".into();
+    assert_eq!(reply.validate(&request, &owner()), Err(BarrierError));
+}
+
+#[test]
+fn an_already_delivered_steer_cannot_be_retroactively_denied() {
+    let mut request = request(Phase::SourceBind);
+    let mut reply = response(&request);
+    reply.source_owner = None;
+    reply.decision = "deny".into();
+    reply.reason = Some("authorization_denied".into());
+    assert_eq!(reply.validate(&request, &owner()), Ok(()));
+    request.delivery = Some(Delivery::Steered);
+    reply.request = request.clone();
+    assert_eq!(reply.validate(&request, &owner()), Err(BarrierError));
+    assert_eq!(response(&request).validate(&request, &owner()), Ok(()));
+}
+
+#[test]
+fn terminal_receipts_cannot_grant_authority_or_erase_a_failure() {
+    for phase in [Phase::SourceNotStarted, Phase::SourceTerminal] {
+        let request = request(phase);
+        assert_eq!(response(&request).validate(&request, &owner()), Ok(()));
+        let mut reply = response(&request);
+        reply.source_owner = Some(owner());
+        assert_eq!(reply.validate(&request, &owner()), Err(BarrierError));
+        let mut reply = response(&request);
+        reply.decision = "deny".into();
+        reply.reason = Some("authorization_denied".into());
+        assert_eq!(reply.validate(&request, &owner()), Err(BarrierError));
+    }
+    let request = request(Phase::SourceTerminal);
+    let mut reply = response(&request);
+    reply.request.native_status = Some(NativeStatus::Failed);
+    assert_eq!(reply.validate(&request, &owner()), Err(BarrierError));
+}
+
+#[test]
+fn source_wire_rejects_extra_fields_null_and_noncanonical_ids() {
+    let request = request(Phase::SourceBind);
+    let value = serde_json::json!({
+        "schemaVersion": 1, "requestId": request.request_id, "phase": request.phase,
+        "request": request, "decision": "ack", "sourceOwner": owner(),
+    });
+    assert!(serde_json::from_value::<Response>(value.clone()).is_ok());
+    for pointer in [
+        "/sourceOwner",
+        "/request/source",
+        "/request/delivery",
+        "/request/reservation/parent/parentAttemptRef",
+    ] {
+        let mut invalid = value.clone();
+        if pointer.ends_with("parentAttemptRef") {
+            invalid["request"]["reservation"]["parent"]["parentAttemptRef"] =
+                serde_json::Value::Null;
+        } else {
+            *invalid.pointer_mut(pointer).unwrap() = serde_json::Value::Null;
+        }
+        assert!(serde_json::from_value::<Response>(invalid).is_err());
+    }
+    let mut invalid = value.clone();
+    invalid["request"]["reservation"]["reservationId"] =
+        serde_json::json!("00000000-0000-4000-8000-ABCDEF000001");
+    assert!(serde_json::from_value::<Response>(invalid).is_err());
+    for pointer in [
+        "",
+        "/request",
+        "/request/reservation",
+        "/request/source",
+        "/sourceOwner",
+    ] {
+        let mut invalid = value.clone();
+        invalid
+            .pointer_mut(pointer)
+            .unwrap()
+            .as_object_mut()
+            .unwrap()
+            .insert("ignored".into(), true.into());
+        assert!(serde_json::from_value::<Response>(invalid).is_err());
+    }
+}
