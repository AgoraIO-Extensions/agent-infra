+// Rama 0.3 defaults to OS DNS. Retain Hickory, system nameservers/options and
+// Cloudflare fallback. Old Rama marked every queried name as absolute, so do
+// not append system search domains to policy-approved hostnames.
+pub(crate) fn hickory_dns_resolver() -> Option<HickoryDnsResolver> {
+    static RESOLVER: LazyLock<Option<HickoryDnsResolver>> = LazyLock::new(|| {
+        let result = resolver::system_conf::read_system_conf()
+            .map_err(|err| -> BoxError { err.into() })
+            .and_then(|(config, options)| {
+                let (_, _, servers) = config.into_parts();
+                HickoryDnsResolver::builder()
+                    .with_config(resolver::config::ResolverConfig::from_name_servers(servers))
+                    .with_options(options)
+                    .try_build()
+            })
+            .or_else(|err| {
+                tracing::warn!("failed to create system Hickory resolver; using Cloudflare: {err}");
+                HickoryDnsResolver::builder()
+                    .with_options(resolver::config::ResolverOpts::default())
+                    .try_build()
+            });
+        match result {
+            Ok(resolver) => Some(resolver),
+            Err(err) => {
+                tracing::error!("failed to initialize Hickory DNS: {err}");
+                None
+            }
+        }
+    });
+    RESOLVER.clone()
+}
