-            id,
-            op: Op::TurnInput {
-                request: Box::new(request),
-                mode,
-                reply: reply_tx,
-            },
-            trace,
-            parent_turn_id: None,
-            root_turn_id: None,
-        })
-        .await?;
-        reply_rx.await.unwrap_or(Err(CodexErr::InternalAgentDied))
+        if let Some(handoff) = &native_handoff
+            && handoff.before_queue().await.is_err()
+        {
+            handoff
+                .queue_rejected(/*cancelled*/ true)
+                .await
+                .map_err(|error| CodexErr::InvalidRequest(error.to_string()))?;
+            return Err(CodexErr::TurnAborted);
+        }
+        let submitted = self
+            .submit_with_id(Submission {
+                id,
+                op: Op::TurnInput {
+                    request: Box::new(request),
+                    mode,
+                    reply: reply_tx,
+                },
+                trace,
+                parent_turn_id: None,
+                root_turn_id: None,
+            })
+            .await;
+        if let Some(handoff) = &native_handoff {
+            if submitted.is_err() {
+                handoff
+                    .queue_rejected(/*cancelled*/ false)
+                    .await
+                    .map_err(|error| CodexErr::InvalidRequest(error.to_string()))?;
+            } else {
+                handoff
+                    .queued()
+                    .await
+                    .map_err(|error| CodexErr::InvalidRequest(error.to_string()))?;
+            }
+        }
+        submitted?;
+        let result = reply_rx.await.unwrap_or(Err(CodexErr::InternalAgentDied));
+        if let Some(handoff) = native_handoff {
+            handoff
+                .await_routing_receipt()
+                .await
+                .map_err(|error| CodexErr::InvalidRequest(error.to_string()))?;
+        }
+        result
     }
 
     pub(crate) async fn submit_recover_turn(
diff --git a/codex-rs/core/src/session/native_source_tests.rs b/codex-rs/core/src/session/native_source_tests.rs
new file mode 100644
index 0000000..2fb41d3
--- /dev/null
+++ b/codex-rs/core/src/session/native_source_tests.rs
@@ -0,0 +1,196 @@
+use super::*;
+use codex_extension_api::ExtensionFuture;
+use codex_extension_api::ThreadIdleInput;
+use codex_extension_api::ThreadLifecycleContributor;
+use codex_extension_api::TurnAbortInput;
+use codex_extension_api::TurnErrorInput;
+use codex_extension_api::TurnLifecycleContributor;
+use codex_extension_api::TurnStartInput;
+use codex_extension_api::TurnStopInput;
+use codex_protocol::protocol::SubAgentSource;
+
+struct FinishesImmediately;
+impl SessionTask for FinishesImmediately {
+    fn kind(&self) -> TaskKind {
+        TaskKind::Regular
+    }
+    fn span_name(&self) -> &'static str {
+        "session_task.native_terminal_test"
+    }
+    async fn run(
+        self: Arc<Self>,
+        _session: Arc<Session>,
+        _ctx: Arc<TurnContext>,
+        _input: Vec<TurnInput>,
+        _cancellation_token: CancellationToken,
+    ) -> SessionTaskResult {
+        Ok(None)
+    }
+}
+
+struct CleanupGate {
+    entered: tokio::sync::Notify,
+    release: tokio::sync::Notify,
+}
+impl ThreadLifecycleContributor<crate::config::Config> for CleanupGate {
+    fn on_thread_idle<'a>(&'a self, _input: ThreadIdleInput<'a>) -> ExtensionFuture<'a, ()> {
+        Box::pin(async move {
+            self.entered.notify_one();
+            self.release.notified().await;
+        })
+    }
+}
+impl TurnLifecycleContributor for CleanupGate {
+    fn on_turn_abort<'a>(&'a self, _input: TurnAbortInput<'a>) -> ExtensionFuture<'a, ()> {
+        Box::pin(async move {
+            self.entered.notify_one();
+            self.release.notified().await;
+        })
+    }
+}
+
+#[tokio::test]
+async fn native_root_completion_waits_for_idle_cleanup() {
+    let (mut session, turn, events) = make_session_and_context_with_rx().await;
+    let gate = Arc::new(CleanupGate {
+        entered: tokio::sync::Notify::new(),
+        release: tokio::sync::Notify::new(),
+    });
+    let mut builder = codex_extension_api::ExtensionRegistryBuilder::<crate::config::Config>::new();
+    builder.thread_lifecycle_contributor(gate.clone());
+    Arc::get_mut(&mut session).unwrap().services.extensions = Arc::new(builder.build());
+    session
+        .spawn_task(turn, Vec::new(), FinishesImmediately)
+        .await;
+    timeout(StdDuration::from_secs(5), gate.entered.notified())
+        .await
+        .unwrap();
+    while let Ok(event) = events.try_recv() {
+        assert!(
+            !matches!(
+                event.msg,
+                EventMsg::TurnComplete(_) | EventMsg::TurnAborted(_)
+            ),
+            "terminal event preceded cleanup"
+        );
+    }
+    gate.release.notify_one();
+    timeout(StdDuration::from_secs(5), async {
+        loop {
+            if matches!(events.recv().await.unwrap().msg, EventMsg::TurnComplete(_)) {
+                break;
+            }
+        }
+    })
+    .await
+    .unwrap();
+}
+
+#[tokio::test]
+async fn native_root_abort_waits_for_abort_cleanup() {
+    let (mut session, turn, events) = make_session_and_context_with_rx().await;
+    let gate = Arc::new(CleanupGate {
+        entered: tokio::sync::Notify::new(),
+        release: tokio::sync::Notify::new(),
+    });
+    let mut builder = codex_extension_api::ExtensionRegistryBuilder::<crate::config::Config>::new();
+    builder.turn_lifecycle_contributor(gate.clone());
+    Arc::get_mut(&mut session).unwrap().services.extensions = Arc::new(builder.build());
+    session
+        .spawn_task(
+            turn,
+            Vec::new(),
+            NeverEndingTask {
+                kind: TaskKind::Regular,
+                listen_to_cancellation_token: true,
+            },
+        )
+        .await;
+    let aborting = tokio::spawn(async move {
+        session.abort_all_tasks(TurnAbortReason::Interrupted).await;
+    });
+    timeout(StdDuration::from_secs(5), gate.entered.notified())
+        .await
+        .unwrap();
+    while let Ok(event) = events.try_recv() {
+        assert!(
+            !matches!(
+                event.msg,
+                EventMsg::TurnComplete(_) | EventMsg::TurnAborted(_)
+            ),
+            "terminal event preceded cleanup"
+        );
+    }
+    gate.release.notify_one();
+    aborting.await.unwrap();
+    let terminal = timeout(StdDuration::from_secs(5), events.recv())
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(matches!(terminal.msg, EventMsg::TurnAborted(_)));
+}
+
+struct RejectUnexpectedActions;
+impl TurnLifecycleContributor for RejectUnexpectedActions {
+    fn on_turn_start<'a>(&'a self, _input: TurnStartInput<'a>) -> ExtensionFuture<'a, ()> {
+        Box::pin(async {
+            panic!("unadmitted start hook");
+        })
+    }
+    fn on_turn_stop<'a>(&'a self, _input: TurnStopInput<'a>) -> ExtensionFuture<'a, ()> {
+        Box::pin(async {
+            panic!("unadmitted stop hook");
+        })
+    }
+    fn on_turn_error<'a>(&'a self, _input: TurnErrorInput<'a>) -> ExtensionFuture<'a, ()> {
+        Box::pin(async {
+            panic!("unadmitted error hook");
+        })
+    }
+}
+impl SessionTask for RejectUnexpectedActions {
+    fn kind(&self) -> TaskKind {
+        TaskKind::Regular
+    }
+    fn span_name(&self) -> &'static str {
+        "session_task.native_denial_test"
+    }
+    async fn run(
+        self: Arc<Self>,
+        _session: Arc<Session>,
+        _ctx: Arc<TurnContext>,
+        _input: Vec<TurnInput>,
+        _cancellation_token: CancellationToken,
+    ) -> SessionTaskResult {
+        panic!("child ran without trusted source handoff");
+    }
+}
+
+#[tokio::test]
+async fn native_child_without_handoff_cannot_run_task_or_lifecycle_actions() {
+    let (mut session, mut turn, events) = make_session_and_context_with_rx().await;
+    Arc::get_mut(&mut turn).unwrap().session_source =
+        SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+            parent_thread_id: ThreadId::new(),
+            depth: 1,
+            agent_path: None,
+            agent_nickname: None,
+            agent_role: None,
+        });
+    let mut builder = codex_extension_api::ExtensionRegistryBuilder::<crate::config::Config>::new();
+    builder.turn_lifecycle_contributor(Arc::new(RejectUnexpectedActions));
+    Arc::get_mut(&mut session).unwrap().services.extensions = Arc::new(builder.build());
+    session
+        .spawn_task(turn, Vec::new(), RejectUnexpectedActions)
+        .await;
+    timeout(StdDuration::from_secs(5), async {
+        loop {
+            if let EventMsg::TurnComplete(event) = events.recv().await.unwrap().msg {
+                assert!(event.error.is_some());
+                break;
+            }
+        }
+    })
+    .await
+    .unwrap();
+}
