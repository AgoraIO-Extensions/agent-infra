diff --git a/codex-rs/utils/pty/src/tests.rs b/codex-rs/utils/pty/src/tests.rs
index b3d732b..a4f2521 100644
--- a/codex-rs/utils/pty/src/tests.rs
+++ b/codex-rs/utils/pty/src/tests.rs
@@ -1604,3 +1604,40 @@ async fn pipe_spawn_no_stdin_can_preserve_inherited_fds() -> anyhow::Result<()>
 
     Ok(())
 }
+
+#[cfg(unix)]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn confirmed_pty_write_waits_for_actual_io_and_denied_input_never_arrives()
+-> anyhow::Result<()> {
+    let env_map: HashMap<String, String> = std::env::vars().collect();
+    let spawned = spawn_pty_process(
+        "/bin/sh",
+        &[
+            "-c".to_string(),
+            "read value; printf '<%s>' \"$value\"".to_string(),
+        ],
+        Path::new("."),
+        &env_map,
+        &None,
+        TerminalSize::default(),
+        &[],
+    )
+    .await?;
+    let (session, output_rx, exit_rx) = combine_spawned_output(spawned);
+    let denied = session
+        .write_confirmed(b"forbidden\n".to_vec(), Box::new(|| false))
+        .await?;
+    assert!(!denied.completed);
+    assert!(denied.started_at.is_none());
+    let allowed = session
+        .write_confirmed(b"allowed\n".to_vec(), Box::new(|| true))
+        .await?;
+    assert!(allowed.completed);
+    assert!(allowed.started_at.is_some());
+    let (output, code) = collect_output_until_exit(output_rx, exit_rx, 5000).await;
+    let output = String::from_utf8_lossy(&output);
+    assert!(!output.contains("forbidden"));
+    assert!(output.contains("<allowed>"));
+    assert_eq!(code, 0);
+    Ok(())
+}
