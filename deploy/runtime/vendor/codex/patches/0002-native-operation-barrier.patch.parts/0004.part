@@ -0,0 +1,579 @@
+use std::collections::HashMap;
+use std::future::pending;
+use std::io;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+
+use codex_protocol::ThreadId;
+use codex_protocol::protocol::HookEventName;
+use codex_protocol::protocol::HookSource;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use codex_utils_absolute_path::test_support::PathBufExt;
+use futures::future::BoxFuture;
+use pretty_assertions::assert_eq;
+use tempfile::tempdir;
+use tokio::sync::Notify;
+use tokio::sync::oneshot;
+
+use super::CommandHookRuntime;
+use super::CommandShell;
+use super::ConfiguredHandler;
+use super::ConfiguredHandlerKind;
+use super::run_command;
+use crate::HookMcpCall;
+use crate::HookMcpExecutor;
+use crate::NativeHookAttempt;
+use crate::NativeHookFactory;
+use crate::NativeHookResult;
+use crate::NativeHookTask;
+use crate::drain_native_hook_tasks;
+use crate::engine::mcp_runner::run_mcp_tool;
+use crate::with_native_hook_factory;
+
+#[derive(Clone, Default)]
+struct RecordingFactory {
+    events: Arc<Mutex<Vec<String>>>,
+    reject_intent: bool,
+    reject_dispatch: bool,
+    reject_started: bool,
+    cancellation: Option<Arc<Notify>>,
+    started_signal: Arc<Notify>,
+    scheduled_count: Arc<AtomicUsize>,
+    drained: Arc<Notify>,
+}
+
+impl RecordingFactory {
+    fn record(&self, event: String) {
+        self.events
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .push(event);
+    }
+
+    fn events(&self) -> Vec<String> {
+        self.events
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .clone()
+    }
+}
+
+struct ScheduledTask {
+    count: Arc<AtomicUsize>,
+    drained: Arc<Notify>,
+}
+impl NativeHookTask for ScheduledTask {}
+impl Drop for ScheduledTask {
+    fn drop(&mut self) {
+        self.count.fetch_sub(1, Ordering::SeqCst);
+        self.drained.notify_waiters();
+    }
+}
+
+impl NativeHookFactory for RecordingFactory {
+    fn scheduled(&self) -> io::Result<Box<dyn NativeHookTask>> {
+        self.scheduled_count.fetch_add(1, Ordering::SeqCst);
+        Ok(Box::new(ScheduledTask {
+            count: Arc::clone(&self.scheduled_count),
+            drained: Arc::clone(&self.drained),
+        }))
+    }
+
+    fn drain(&self) -> BoxFuture<'_, io::Result<()>> {
+        Box::pin(async {
+            loop {
+                let notified = self.drained.notified();
+                tokio::pin!(notified);
+                notified.as_mut().enable();
+                if self.scheduled_count.load(Ordering::SeqCst) == 0 {
+                    return Ok(());
+                }
+                notified.await;
+            }
+        })
+    }
+
+    fn cancelled(&self) -> BoxFuture<'_, ()> {
+        NativeHookAttempt::cancelled(self)
+    }
+
+    fn begin_command(
+        &self,
+        run_id: String,
+        event_name: &'static str,
+    ) -> BoxFuture<'_, io::Result<Arc<dyn NativeHookAttempt>>> {
+        Box::pin(async move {
+            self.record(format!("intent:{event_name}:{run_id}"));
+            if self.reject_intent {
+                return Err(io::Error::other("intent rejected"));
+            }
+            Ok(Arc::new(self.clone()) as Arc<dyn NativeHookAttempt>)
+        })
+    }
+
+    fn execute_mcp<'a>(
+        &'a self,
+        run_id: String,
+        event_name: &'static str,
+        executor: &'a dyn HookMcpExecutor,
+        call: HookMcpCall,
+    ) -> BoxFuture<'a, anyhow::Result<String>> {
+        Box::pin(async move {
+            self.record(format!("mcp:{event_name}:{run_id}"));
+            if self.reject_intent {
+                anyhow::bail!("intent rejected");
+            }
+            executor.execute(call).await
+        })
+    }
+}
+
+impl NativeHookAttempt for RecordingFactory {
+    fn check_dispatch(&self) -> io::Result<()> {
+        self.record("check".to_owned());
+        if self.reject_dispatch {
+            Err(io::Error::other("dispatch rejected"))
+        } else {
+            Ok(())
+        }
+    }
+
+    fn started(&self) -> BoxFuture<'_, io::Result<()>> {
+        Box::pin(async {
+            self.record("started".to_owned());
+            self.started_signal.notify_one();
+            if self.reject_started {
+                Err(io::Error::other("started receipt rejected"))
+            } else {
+                Ok(())
+            }
+        })
+    }
+
+    fn cancelled(&self) -> BoxFuture<'_, ()> {
+        Box::pin(async {
+            match &self.cancellation {
+                Some(cancellation) => cancellation.notified().await,
+                None => pending().await,
+            }
+        })
+    }
+
+    fn finish(&self, result: NativeHookResult) -> BoxFuture<'_, io::Result<()>> {
+        Box::pin(async move {
+            self.record(
+                match result {
+                    NativeHookResult::Completed => "completed",
+                    NativeHookResult::Failed => "failed",
+                    NativeHookResult::Unknown => "unknown",
+                }
+                .to_owned(),
+            );
+            Ok(())
+        })
+    }
+}
+
+fn fixture(cwd: &std::path::Path, command: &str) -> (CommandHookRuntime, ConfiguredHandler) {
+    let (sender, _receiver) = async_channel::unbounded();
+    let runtime = CommandHookRuntime::new(
+        CommandShell {
+            program: "/bin/sh".to_owned(),
+            args: vec!["-c".to_owned()],
+        },
+        Arc::new(std::env::vars_os().collect()),
+        ThreadId::new(),
+        sender,
+    );
+    let handler = ConfiguredHandler {
+        builtin: false,
+        event_name: HookEventName::PreToolUse,
+        matcher: None,
+        timeout_sec: 5,
+        status_message: None,
+        additional_context_limit: Default::default(),
+        source_path: cwd.join("hooks.json").abs().into(),
+        source: HookSource::User,
+        display_order: 2,
+        kind: ConfiguredHandlerKind::Command {
+            command: command.to_owned(),
+            env: HashMap::new(),
+            r#async: false,
+        },
+    };
+    (runtime, handler)
+}
+
+#[tokio::test]
+async fn missing_original_task_context_never_spawns_a_command() {
+    let temp = tempdir().expect("tempdir");
+    let (runtime, handler) = fixture(temp.path(), "touch executed");
+    let result = run_command(
+        &runtime,
+        &handler,
+        "touch executed",
+        &HashMap::new(),
+        "{}",
+        temp.path(),
+    )
+    .await;
+    assert_eq!(
+        result.error.as_deref(),
+        Some("NATIVE_HOOK_EXECUTION_CONTEXT_UNAVAILABLE")
+    );
+    assert!(!temp.path().join("executed").exists());
+}
+
+#[tokio::test]
+async fn rejected_intent_and_expired_dispatch_never_spawn() {
+    for reject_intent in [true, false] {
+        let temp = tempdir().expect("tempdir");
+        let (runtime, handler) = fixture(temp.path(), "touch executed");
+        let factory = Arc::new(RecordingFactory {
+            reject_intent,
+            reject_dispatch: !reject_intent,
+            ..Default::default()
+        });
+        let result = with_native_hook_factory(
+            factory.clone(),
+            run_command(
+                &runtime,
+                &handler,
+                "touch executed",
+                &HashMap::new(),
+                "{}",
+                temp.path(),
+            ),
+        )
+        .await;
+        assert!(result.error.is_some());
+        assert!(!temp.path().join("executed").exists());
+        let mut expected = vec![format!("intent:pre-tool-use:{}", handler.run_id())];
+        if !reject_intent {
+            expected.extend(["check".to_owned(), "failed".to_owned()]);
+        }
+        assert_eq!(factory.events(), expected);
+    }
+}
+
+#[tokio::test]
+async fn real_command_terminal_status_is_recorded_after_spawn() {
+    for (command, outcome) in [("printf result", "completed"), ("exit 7", "failed")] {
+        let temp = tempdir().expect("tempdir");
+        let (runtime, handler) = fixture(temp.path(), command);
+        let factory = Arc::new(RecordingFactory::default());
+        let result = with_native_hook_factory(
+            factory.clone(),
+            run_command(
+                &runtime,
+                &handler,
+                command,
+                &HashMap::new(),
+                "secret hook input",
+                temp.path(),
+            ),
+        )
+        .await;
+        assert!(result.error.is_none());
+        assert_eq!(
+            factory.events(),
+            vec![
+                format!("intent:pre-tool-use:{}", handler.run_id()),
+                "check".to_owned(),
+                "started".to_owned(),
+                outcome.to_owned(),
+            ]
+        );
+    }
+}
+
+#[tokio::test]
+async fn spawn_error_has_no_started_receipt() {
+    let temp = tempdir().expect("tempdir");
+    let (runtime, handler) = fixture(temp.path(), "touch executed");
+    let runtime = runtime.reconfigured(CommandShell {
+        program: temp.path().join("absent-shell").display().to_string(),
+        args: vec![],
+    });
+    let factory = Arc::new(RecordingFactory::default());
+    let result = with_native_hook_factory(
+        factory.clone(),
+        run_command(
+            &runtime,
+            &handler,
+            "touch executed",
+            &HashMap::new(),
+            "{}",
+            temp.path(),
+        ),
+    )
+    .await;
+    assert!(result.error.is_some());
+    assert_eq!(
+        factory.events(),
+        vec![
+            format!("intent:pre-tool-use:{}", handler.run_id()),
+            "check".to_owned(),
+            "failed".to_owned(),
+        ]
+    );
+}
+
+#[tokio::test]
+async fn missing_started_receipt_never_exposes_successful_output() {
+    let temp = tempdir().expect("tempdir");
+    let (runtime, handler) = fixture(temp.path(), "printf secret-output");
+    let factory = Arc::new(RecordingFactory {
+        reject_started: true,
+        ..Default::default()
+    });
+    let result = with_native_hook_factory(
+        factory.clone(),
+        run_command(
+            &runtime,
+            &handler,
+            "printf secret-output",
+            &HashMap::new(),
+            "{}",
+            temp.path(),
+        ),
+    )
+    .await;
+    assert_eq!(result.error.as_deref(), Some("started receipt rejected"));
+    assert!(result.stdout.is_empty());
+    assert_eq!(factory.events().last().map(String::as_str), Some("unknown"));
+}
+
+#[tokio::test]
+async fn async_hook_keeps_the_scheduling_context_after_scope_exits() {
+    let temp = tempdir().expect("tempdir");
+    let (runtime, handler) = fixture(temp.path(), "touch executed");
+    let factory = Arc::new(RecordingFactory::default());
+    let (release, wait) = oneshot::channel();
+    let (done, result) = oneshot::channel();
+    let task_runtime = runtime.clone();
+    let cwd = temp.path().to_owned();
+    with_native_hook_factory(factory.clone(), async {
+        runtime.schedule_async_task(async move {
+            wait.await.expect("release");
+            let output = run_command(
+                &task_runtime,
+                &handler,
+                "touch executed",
+                &HashMap::new(),
+                "{}",
+                &cwd,
+            )
+            .await;
+            done.send(output).expect("done");
+        });
+    })
+    .await;
+    release.send(()).expect("release");
+    assert!(result.await.expect("result").error.is_none());
+    assert!(temp.path().join("executed").exists());
+    assert_eq!(
+        factory.events().last().map(String::as_str),
+        Some("completed")
+    );
+    runtime.shutdown().await;
+}
+
+#[derive(Default)]
+struct Executor(Mutex<Vec<HookMcpCall>>);
+impl HookMcpExecutor for Executor {
+    fn execute(&self, call: HookMcpCall) -> BoxFuture<'_, anyhow::Result<String>> {
+        Box::pin(async move {
+            self.0
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .push(call);
+            Ok("{}".to_owned())
+        })
+    }
+}
+
+#[tokio::test]
+async fn mcp_hook_requires_context_and_preserves_native_run_id() {
+    let temp = tempdir().expect("tempdir");
+    let (_, handler) = fixture(temp.path(), "");
+    let executor = Executor::default();
+    let input = serde_json::Map::new();
+    let result = run_mcp_tool(&executor, &handler, "server", "tool", &input, "{}", None).await;
+    assert!(result.error.is_some());
+    assert!(executor.0.lock().expect("calls").is_empty());
+    let rejected = Arc::new(RecordingFactory {
+        reject_intent: true,
+        ..Default::default()
+    });
+    let result = with_native_hook_factory(
+        rejected,
+        run_mcp_tool(&executor, &handler, "server", "tool", &input, "{}", None),
+    )
+    .await;
+    assert!(result.error.is_some());
+    assert!(executor.0.lock().expect("calls").is_empty());
+    let factory = Arc::new(RecordingFactory::default());
+    let result = with_native_hook_factory(
+        factory.clone(),
+        run_mcp_tool(&executor, &handler, "server", "tool", &input, "{}", None),
+    )
+    .await;
+    assert!(result.error.is_none());
+    assert_eq!(
+        factory.events(),
+        vec![format!("mcp:pre-tool-use:{}", handler.run_id())]
+    );
+    assert_eq!(executor.0.lock().expect("calls").len(), 1);
+}
+
+#[tokio::test]
+async fn cancellation_of_original_task_stops_running_hook() {
+    let temp = tempdir().expect("tempdir");
+    let (runtime, handler) = fixture(temp.path(), "sleep 30; touch late");
+    let cancellation = Arc::new(Notify::new());
+    let factory = Arc::new(RecordingFactory {
+        cancellation: Some(cancellation.clone()),
+        ..Default::default()
+    });
+    let cwd = temp.path().to_owned();
+    let task_factory = factory.clone();
+    let task = tokio::spawn(async move {
+        with_native_hook_factory(
+            task_factory,
+            run_command(
+                &runtime,
+                &handler,
+                "sleep 30; touch late",
+                &HashMap::new(),
+                "{}",
+                &cwd,
+            ),
+        )
+        .await
+    });
+    factory.started_signal.notified().await;
+    cancellation.notify_one();
+    let result = tokio::time::timeout(std::time::Duration::from_secs(2), task)
+        .await
+        .expect("hook must observe cancellation")
+        .expect("task");
+    assert_eq!(
+        result.error.as_deref(),
+        Some("NATIVE_HOOK_EXECUTION_CANCELLED")
+    );
+    assert!(!temp.path().join("late").exists());
+    assert_eq!(factory.events().last().map(String::as_str), Some("unknown"));
+}
+
+#[tokio::test]
+async fn unsupported_legacy_notify_never_spawns() {
+    let temp = tempdir().expect("tempdir");
+    let thread_id = ThreadId::new();
+    let payload = crate::HookPayload {
+        session_id: thread_id,
+        cwd: AbsolutePathBuf::try_from(temp.path()).expect("absolute path"),
+        client: None,
+        triggered_at: chrono::Utc::now(),
+        hook_event: crate::HookEvent::AfterAgent {
+            event: crate::HookEventAfterAgent {
+                thread_id,
+                turn_id: "original-turn".to_owned(),
+                input_messages: vec![],
+                last_assistant_message: None,
+            },
+        },
+    };
+    let marker = temp.path().join("legacy-executed");
+    let hook = crate::legacy_notify::notify_hook(
+        vec!["/usr/bin/touch".to_owned(), marker.display().to_string()],
+        Arc::new(std::env::vars_os().collect()),
+    );
+    let response = hook.execute(&payload).await;
+    let crate::HookResult::FailedContinue(error) = response.result else {
+        panic!("legacy notify must be explicitly unsupported");
+    };
+    assert_eq!(error.to_string(), "NATIVE_LEGACY_NOTIFY_UNSUPPORTED");
+    assert!(!marker.exists());
+}
+
+#[tokio::test]
+async fn original_task_drain_waits_for_queued_and_running_hooks() {
+    let temp = tempdir().expect("tempdir");
+    let (runtime, _) = fixture(temp.path(), "");
+    let capacity = Arc::clone(&runtime.lock_state().concurrency_limit);
+    let held = capacity
+        .acquire_many_owned(super::MAX_CONCURRENT_ASYNC_HOOKS as u32)
+        .await
+        .expect("hold all session hook capacity");
+    let factory = Arc::new(RecordingFactory::default());
+    let (started, received) = oneshot::channel();
+    let (finish, finishing) = oneshot::channel();
+    with_native_hook_factory(factory.clone(), async {
+        runtime.schedule_async_task(async move {
+            started.send(()).expect("started");
+            finishing.await.expect("finish");
+        });
+    })
+    .await;
+    assert_eq!(factory.scheduled_count.load(Ordering::SeqCst), 1);
+    let drain = with_native_hook_factory(factory.clone(), drain_native_hook_tasks());
+    tokio::pin!(drain);
+    assert!(
+        tokio::time::timeout(std::time::Duration::from_millis(20), &mut drain)
+            .await
+            .is_err()
+    );
+    drop(held);
+    received.await.expect("queued task starts");
+    assert!(
+        tokio::time::timeout(std::time::Duration::from_millis(20), &mut drain)
+            .await
+            .is_err()
+    );
+    finish.send(()).expect("finish");
+    tokio::time::timeout(std::time::Duration::from_secs(2), drain)
+        .await
+        .expect("drained")
+        .expect("accounting");
+    assert_eq!(factory.scheduled_count.load(Ordering::SeqCst), 0);
+    runtime.shutdown().await;
+}
+
+#[tokio::test]
+async fn cancelled_queued_original_task_drains_without_session_capacity() {
+    let temp = tempdir().expect("tempdir");
+    let (runtime, _) = fixture(temp.path(), "");
+    let capacity = Arc::clone(&runtime.lock_state().concurrency_limit);
+    let held = capacity
+        .acquire_many_owned(super::MAX_CONCURRENT_ASYNC_HOOKS as u32)
+        .await
+        .expect("hold all session hook capacity");
+    let cancellation = Arc::new(Notify::new());
+    let factory = Arc::new(RecordingFactory {
+        cancellation: Some(cancellation.clone()),
+        ..Default::default()
+    });
+    let (started, received) = oneshot::channel();
+    with_native_hook_factory(factory.clone(), async {
+        runtime.schedule_async_task(async move {
+            let _ = started.send(());
+        });
+    })
+    .await;
+    assert_eq!(factory.scheduled_count.load(Ordering::SeqCst), 1);
+    cancellation.notify_one();
+    tokio::time::timeout(
+        std::time::Duration::from_secs(2),
+        with_native_hook_factory(factory.clone(), drain_native_hook_tasks()),
+    )
+    .await
+    .expect("cancelled queue must drain")
+    .expect("accounting");
+    assert!(received.await.is_err());
+    assert_eq!(factory.scheduled_count.load(Ordering::SeqCst), 0);
+    drop(held);
+    runtime.shutdown().await;
+}
