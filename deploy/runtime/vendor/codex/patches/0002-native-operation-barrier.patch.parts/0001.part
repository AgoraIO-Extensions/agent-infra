diff --git a/codex-rs/apply-patch/src/native_dispatch.rs b/codex-rs/apply-patch/src/native_dispatch.rs
new file mode 100644
index 0000000..7eef4fb
--- /dev/null
+++ b/codex-rs/apply-patch/src/native_dispatch.rs
@@ -0,0 +1,33 @@
+//! Private vendor callbacks around actual patch filesystem adapter operations.
+use std::future::Future;
+use std::io;
+use std::pin::Pin;
+use std::sync::Arc;
+
+/// The core-owned permit stays outside patch input and child process state.
+/// A receipt confirms adapter dispatch, not that a failed operation was side-effect free.
+pub trait NativePatchDispatch: Send + Sync {
+    fn check_dispatch(&self) -> io::Result<()>;
+    fn dispatched(&self) -> Pin<Box<dyn Future<Output = io::Result<()>> + Send + '_>>;
+}
+
+tokio::task_local! { static CURRENT: Arc<dyn NativePatchDispatch>; }
+
+pub async fn with_native_patch_dispatch<T>(
+    barrier: Arc<dyn NativePatchDispatch>,
+    work: impl Future<Output = T>,
+) -> T {
+    CURRENT.scope(barrier, work).await
+}
+
+pub(crate) async fn run<T>(work: impl Future<Output = io::Result<T>>) -> io::Result<T> {
+    let barrier = CURRENT.try_with(Arc::clone).ok();
+    if let Some(barrier) = &barrier {
+        barrier.check_dispatch()?;
+    }
+    let result = work.await;
+    if let Some(barrier) = barrier {
+        barrier.dispatched().await?;
+    }
+    result
+}
