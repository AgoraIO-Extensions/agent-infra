+++ b/codex-rs/app-server-transport/src/outgoing_message.rs
@@ -57,3 +57,22 @@ impl QueuedOutgoingMessage {
         }
     }
 }
+
+impl OutgoingMessage {
+    /// Native vendor receipt, kept outside serialized app-server messages.
+    pub fn native_dynamic_dispatch(
+        &self,
+    ) -> Result<Option<codex_core::NativeDynamicDispatch>, &'static str> {
+        match self {
+            Self::Request(ServerRequest::DynamicToolCall { params, .. }) => {
+                codex_core::native_dynamic_dispatch(
+                    &params.thread_id,
+                    &params.turn_id,
+                    &params.call_id,
+                )
+                .map(Some)
+            }
+            _ => Ok(None),
+        }
+    }
+}
