diff --git a/codex-rs/core/src/native_dynamic_dispatch.rs b/codex-rs/core/src/native_dynamic_dispatch.rs
new file mode 100644
index 0000000..cd3dfa0
--- /dev/null
+++ b/codex-rs/core/src/native_dynamic_dispatch.rs
@@ -0,0 +1,72 @@
+//! Private in-process handoff from dynamic tool registration to actual client write.
+use crate::native_operation_barrier::Attempt;
+use crate::native_operation_barrier::BarrierError;
+use std::collections::HashMap;
+use std::sync::Mutex;
+use std::sync::OnceLock;
+
+type Pending = HashMap<(String, String, String), Attempt>;
+
+fn pending() -> &'static Mutex<Pending> {
+    static PENDING: OnceLock<Mutex<Pending>> = OnceLock::new();
+    PENDING.get_or_init(Mutex::default)
+}
+
+pub(crate) struct Registration((String, String, String));
+impl Drop for Registration {
+    fn drop(&mut self) {
+        if let Ok(mut pending) = pending().lock() {
+            pending.remove(&self.0);
+        }
+    }
+}
+
+pub(crate) fn register(attempt: &Attempt) -> Result<Registration, BarrierError> {
+    let identity = attempt.identity();
+    let key = (
+        identity.session_id.clone(),
+        identity.turn_id.clone(),
+        identity.call_id.clone(),
+    );
+    let mut pending = pending().lock().map_err(|_| BarrierError)?;
+    if pending.len() >= 1024 || pending.contains_key(&key) {
+        return Err(BarrierError);
+    }
+    pending.insert(key.clone(), attempt.clone());
+    Ok(Registration(key))
+}
+
+/// Internal Rust-only receipt handle; never serialized into app-server messages.
+#[doc(hidden)]
+#[derive(Clone, Debug)]
+pub struct NativeDynamicDispatch(Attempt);
+
+/// Resolves only the original core registration. Missing registrations fail closed.
+#[doc(hidden)]
+pub fn native_dynamic_dispatch(
+    thread: &str,
+    turn: &str,
+    call: &str,
+) -> Result<NativeDynamicDispatch, &'static str> {
+    pending()
+        .lock()
+        .map_err(|_| "NATIVE_OPERATION_BARRIER_UNAVAILABLE")?
+        .get(&(thread.to_owned(), turn.to_owned(), call.to_owned()))
+        .cloned()
+        .map(NativeDynamicDispatch)
+        .ok_or("NATIVE_OPERATION_BARRIER_UNAVAILABLE")
+}
+
+impl NativeDynamicDispatch {
+    pub fn check_dispatch(&self) -> Result<(), &'static str> {
+        self.0
+            .check_dispatch()
+            .map_err(|_| "NATIVE_OPERATION_BARRIER_UNAVAILABLE")
+    }
+    pub async fn dispatched(&self) -> Result<(), &'static str> {
+        self.0
+            .started()
+            .await
+            .map_err(|_| "NATIVE_OPERATION_BARRIER_UNAVAILABLE")
+    }
+}
diff --git a/codex-rs/core/src/native_hook_dispatch.rs b/codex-rs/core/src/native_hook_dispatch.rs
new file mode 100644
index 0000000..7d5794d
--- /dev/null
+++ b/codex-rs/core/src/native_hook_dispatch.rs
@@ -0,0 +1,220 @@
+//! Native hook identity is captured once from the admitted original task.
+use std::collections::HashMap;
+use std::future::Future;
+use std::io;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::OnceLock;
+use std::sync::Weak;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+
+use codex_hooks::HookMcpCall;
+use codex_hooks::HookMcpExecutor;
+use codex_hooks::NativeHookAttempt;
+use codex_hooks::NativeHookFactory;
+use codex_hooks::NativeHookResult;
+use codex_hooks::NativeHookTask;
+use futures::future::BoxFuture;
+use tokio_util::sync::CancellationToken;
+use uuid::Uuid;
+
+use crate::native_operation_barrier::Attempt;
+use crate::native_operation_barrier::Identity;
+use crate::native_operation_barrier::McpFactory;
+use crate::native_operation_barrier::Outcome;
+use crate::native_operation_barrier::Reason;
+
+struct HookFactory {
+    session_id: String,
+    turn_id: String,
+    cancelled: CancellationToken,
+    tasks: Option<Arc<HookTasks>>,
+}
+
+#[derive(Default)]
+struct HookTasks {
+    pending: AtomicUsize,
+    changed: tokio::sync::Notify,
+}
+
+type SourceKey = (String, String);
+fn task_scopes() -> &'static Mutex<HashMap<SourceKey, Weak<HookTasks>>> {
+    static SCOPES: OnceLock<Mutex<HashMap<SourceKey, Weak<HookTasks>>>> = OnceLock::new();
+    SCOPES.get_or_init(Mutex::default)
+}
+
+fn context_error() -> io::Error {
+    io::Error::other("NATIVE_HOOK_EXECUTION_CONTEXT_UNAVAILABLE")
+}
+
+impl HookTasks {
+    async fn drain(&self) {
+        loop {
+            let changed = self.changed.notified();
+            tokio::pin!(changed);
+            changed.as_mut().enable();
+            if self.pending.load(Ordering::Acquire) == 0 {
+                return;
+            }
+            changed.await;
+        }
+    }
+}
+
+struct HookTaskGuard(Arc<HookTasks>);
+impl NativeHookTask for HookTaskGuard {}
+impl Drop for HookTaskGuard {
+    fn drop(&mut self) {
+        self.0.pending.fetch_sub(1, Ordering::AcqRel);
+        self.0.changed.notify_waiters();
+    }
+}
+
+pub(crate) async fn drain_native_hook_context(thread_id: &str, turn_id: &str) -> io::Result<()> {
+    let tasks = task_scopes()
+        .lock()
+        .map_err(|_| context_error())?
+        .get(&(thread_id.into(), turn_id.into()))
+        .and_then(Weak::upgrade);
+    if let Some(tasks) = tasks {
+        tasks.drain().await;
+    }
+    Ok(())
+}
+
+pub(crate) async fn with_native_hook_context<T>(
+    session_id: String,
+    turn_id: String,
+    cancelled: CancellationToken,
+    work: impl Future<Output = T>,
+) -> T {
+    let tasks = task_scopes().lock().ok().and_then(|mut scopes| {
+        scopes.retain(|_, scope| scope.strong_count() > 0);
+        let key = (session_id.clone(), turn_id.clone());
+        if let Some(tasks) = scopes.get(&key).and_then(Weak::upgrade) {
+            return Some(tasks);
+        }
+        if scopes.len() >= 1024 {
+            return None;
+        }
+        let tasks = Arc::new(HookTasks::default());
+        scopes.insert(key, Arc::downgrade(&tasks));
+        Some(tasks)
+    });
+    codex_hooks::with_native_hook_factory(
+        Arc::new(HookFactory {
+            session_id,
+            turn_id,
+            cancelled,
+            tasks,
+        }),
+        work,
+    )
+    .await
+}
+
+impl HookFactory {
+    fn identity(&self, run_id: String, tool_name: String) -> Identity {
+        Identity {
+            session_id: self.session_id.clone(),
+            turn_id: self.turn_id.clone(),
+            call_id: run_id,
+            attempt_ref: Uuid::new_v4(),
+            tool_name,
+            parent_attempt_ref: None,
+        }
+    }
+}
+
+impl NativeHookFactory for HookFactory {
+    fn scheduled(&self) -> io::Result<Box<dyn NativeHookTask>> {
+        let tasks = self.tasks.as_ref().ok_or_else(context_error)?;
+        tasks
+            .pending
+            .fetch_update(Ordering::AcqRel, Ordering::Acquire, |count| {
+                (count < 1024).then_some(count + 1)
+            })
+            .map_err(|_| context_error())?;
+        Ok(Box::new(HookTaskGuard(Arc::clone(tasks))))
+    }
+
+    fn drain(&self) -> BoxFuture<'_, io::Result<()>> {
+        Box::pin(async {
+            self.tasks.as_ref().ok_or_else(context_error)?.drain().await;
+            Ok(())
+        })
+    }
+
+    fn cancelled(&self) -> BoxFuture<'_, ()> {
+        Box::pin(self.cancelled.cancelled())
+    }
+
+    fn begin_command(
+        &self,
+        run_id: String,
+        event_name: &'static str,
+    ) -> BoxFuture<'_, io::Result<Arc<dyn NativeHookAttempt>>> {
+        Box::pin(async move {
+            let attempt = Attempt::begin(
+                self.identity(run_id, format!("hook_command:{event_name}")),
+                self.cancelled.clone(),
+            )
+            .await
+            .map_err(io::Error::other)?;
+            Ok(Arc::new(HookAttempt {
+                attempt,
+                cancelled: self.cancelled.clone(),
+            }) as Arc<dyn NativeHookAttempt>)
+        })
+    }
+
+    fn execute_mcp<'a>(
+        &'a self,
+        run_id: String,
+        event_name: &'static str,
+        executor: &'a dyn HookMcpExecutor,
+        call: HookMcpCall,
+    ) -> BoxFuture<'a, anyhow::Result<String>> {
+        Box::pin(codex_rmcp_client::with_native_mcp_factory(
+            Arc::new(McpFactory {
+                identity: self.identity(run_id, format!("hook_mcp:{event_name}")),
+                cancelled: self.cancelled.clone(),
+            }),
+            executor.execute(call),
+        ))
+    }
+}
+
+struct HookAttempt {
+    attempt: Attempt,
+    cancelled: CancellationToken,
+}
+
+impl NativeHookAttempt for HookAttempt {
+    fn check_dispatch(&self) -> io::Result<()> {
+        self.attempt.check_dispatch().map_err(io::Error::other)
+    }
+
+    fn started(&self) -> BoxFuture<'_, io::Result<()>> {
+        Box::pin(async { self.attempt.started().await.map_err(io::Error::other) })
+    }
+
+    fn cancelled(&self) -> BoxFuture<'_, ()> {
+        Box::pin(self.cancelled.cancelled())
+    }
+
+    fn finish(&self, result: NativeHookResult) -> BoxFuture<'_, io::Result<()>> {
+        Box::pin(async move {
+            let (outcome, reason) = match result {
+                NativeHookResult::Completed => (Outcome::Completed, None),
+                NativeHookResult::Failed => (Outcome::Failed, Some(Reason::ExecutionFailed)),
+                NativeHookResult::Unknown => (Outcome::Unknown, Some(Reason::ResultUnconfirmed)),
+            };
+            self.attempt
+                .finish(outcome, reason)
+                .await
+                .map_err(io::Error::other)
+        })
+    }
+}
diff --git a/codex-rs/core/src/native_operation_barrier.rs b/codex-rs/core/src/native_operation_barrier.rs
new file mode 100644
index 0000000..60413a1
--- /dev/null
+++ b/codex-rs/core/src/native_operation_barrier.rs
@@ -0,0 +1,732 @@
+//! Agent Infra vendor change: mandatory native-attempt callback on an inherited
+//! anonymous socket. No command hook, public app-server method, or agent loop.
+use std::future::Future;
+use std::sync::Arc;
+use std::sync::OnceLock;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+use std::time::SystemTime;
+use std::time::UNIX_EPOCH;
+
+use serde::Deserialize;
+use serde::Serialize;
+use tokio::io::AsyncReadExt;
+use tokio::io::AsyncWriteExt;
+use tokio::io::BufReader;
+use tokio::sync::Mutex;
+use tokio_util::sync::CancellationToken;
+use uuid::Uuid;
+
+use crate::native_sources::SourceOwner;
+
+const MAX_FRAME_BYTES: usize = 16_384;
+const EXCHANGE_TIMEOUT: Duration = Duration::from_secs(5);
+const FAILURE: &str = "NATIVE_OPERATION_BARRIER_UNAVAILABLE";
+static CHANNEL_POISONED: AtomicBool = AtomicBool::new(false);
+
+pub(crate) fn channel_poisoned() -> bool {
+    CHANNEL_POISONED.load(Ordering::Acquire)
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) struct BarrierError;
+
+impl std::fmt::Display for BarrierError {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter.write_str(FAILURE)
+    }
+}
+
+impl std::error::Error for BarrierError {}
+
+#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(crate) struct Identity {
+    pub session_id: String,
+    pub turn_id: String,
+    pub call_id: String,
+    #[serde(deserialize_with = "canonical_uuid")]
+    pub attempt_ref: Uuid,
+    pub tool_name: String,
+    #[serde(
+        default,
+        deserialize_with = "optional_canonical_uuid",
+        skip_serializing_if = "Option::is_none"
+    )]
+    pub parent_attempt_ref: Option<Uuid>,
+}
+
+impl Identity {
+    fn valid(&self) -> bool {
+        [
+            &self.session_id,
+            &self.turn_id,
+            &self.call_id,
+            &self.tool_name,
+        ]
+        .into_iter()
+        .all(|value| {
+            !value.is_empty()
+                && value.len() <= 1024
+                && value.chars().count() <= 256
+                && !value.chars().any(char::is_control)
+        })
+    }
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(rename_all = "snake_case")]
+enum Phase {
+    Intent,
+    Started,
+    Outcome,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub(crate) enum Outcome {
+    Completed,
+    Failed,
+    Unknown,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub(crate) enum Reason {
+    AuthorizationDenied,
+    AuthorizationUnavailable,
+    CancelledBeforeDispatch,
+    ExecutionFailed,
+    ExecutionCancelled,
+    DispatchUnconfirmed,
+    ResultUnconfirmed,
+}
+
+#[derive(Clone, Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+struct Request {
+    schema_version: u8,
+    request_id: Uuid,
+    phase: Phase,
+    identity: Identity,
+    occurred_at: u64,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    permit_id: Option<Uuid>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    outcome: Option<Outcome>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    reason: Option<Reason>,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Response {
+    schema_version: u8,
+    #[serde(deserialize_with = "canonical_uuid")]
+    request_id: Uuid,
+    phase: Phase,
+    identity: Identity,
+    decision: String,
+    #[serde(default, deserialize_with = "optional_canonical_uuid")]
+    permit_id: Option<Uuid>,
+    #[serde(default, deserialize_with = "present")]
+    expires_at: Option<u64>,
+    #[serde(default, deserialize_with = "present")]
+    reason: Option<String>,
+    #[serde(default, deserialize_with = "present")]
+    source_owner: Option<SourceOwner>,
+}
+
+// Missing optional fields are allowed; explicit null is not part of the wire schema.
+pub(crate) fn present<'de, D, T>(deserializer: D) -> Result<Option<T>, D::Error>
+where
+    D: serde::Deserializer<'de>,
+    T: Deserialize<'de>,
+{
+    T::deserialize(deserializer).map(Some)
+}
+
+pub(crate) fn canonical_uuid<'de, D>(deserializer: D) -> Result<Uuid, D::Error>
+where
+    D: serde::Deserializer<'de>,
+{
+    let text = String::deserialize(deserializer)?;
+    let uuid = Uuid::parse_str(&text).map_err(serde::de::Error::custom)?;
+    if uuid.hyphenated().to_string() != text {
+        return Err(serde::de::Error::custom("noncanonical UUID"));
+    }
+    Ok(uuid)
+}
+
+fn optional_canonical_uuid<'de, D>(deserializer: D) -> Result<Option<Uuid>, D::Error>
+where
+    D: serde::Deserializer<'de>,
+{
+    canonical_uuid(deserializer).map(Some)
+}
+
+impl Response {
+    fn validate(&self, request: &Request, now: u64) -> Result<(), BarrierError> {
+        if self.schema_version != 1
+            || self.request_id != request.request_id
+            || self.phase != request.phase
+            || self.identity != request.identity
+            || !self.identity.valid()
+        {
+            return Err(BarrierError);
+        }
+        let valid = match (request.phase, self.decision.as_str()) {
+            (Phase::Intent, "permit") => {
+                self.permit_id.is_some()
+                    && self.source_owner.as_ref().is_some_and(SourceOwner::valid)
+                    && self.reason.is_none()
+                    && self
+                        .expires_at
+                        .is_some_and(|expires| expires > now && expires <= now.saturating_add(5000))
+            }
+            (Phase::Intent, "deny") => {
+                self.permit_id.is_none()
+                    && self.source_owner.is_none()
+                    && self.expires_at.is_none()
+                    && matches!(
+                        self.reason.as_deref(),
+                        Some(
+                            "authorization_denied"
+                                | "authorization_unavailable"
+                                | "persistence_unavailable"
+                        )
+                    )
+            }
+            (Phase::Started | Phase::Outcome, "ack") => {
+                self.permit_id.is_none()
+                    && self.expires_at.is_none()
+                    && self.reason.is_none()
+                    && self.source_owner.is_none()
+            }
+            _ => false,
+        };
+        if valid { Ok(()) } else { Err(BarrierError) }
+    }
+}
+
+pub(crate) fn now_ms() -> Result<u64, BarrierError> {
+    let now = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_err(|_| BarrierError)?;
+    let value = u64::try_from(now.as_millis()).map_err(|_| BarrierError)?;
+    if value == 0 || value > 9_007_199_254_740_991 {
+        return Err(BarrierError);
+    }
+    Ok(value)
+}
+
+#[cfg(unix)]
+mod socket {
+    use std::os::fd::BorrowedFd;
+    use std::os::fd::FromRawFd;
+    use std::os::unix::net::UnixStream;
+    use std::sync::OnceLock;
+
+    static SOCKET: OnceLock<Result<UnixStream, ()>> = OnceLock::new();
+
+    // Called synchronously at CLI entry, before arg0 dispatch, runtime bootstrap,
+    // snapshot helpers, plugins, or ordinary hooks can spawn any child.
+    pub(super) fn initialize() {
+        SOCKET.get_or_init(|| {
+            // SAFETY: only inspect inherited fd 3 until it is validated. Take
+            // ownership once, under OnceLock. Invalid/unowned fds are not closed.
+            unsafe {
+                let flags = libc::fcntl(3, libc::F_GETFD);
+                if flags < 0 || libc::fcntl(3, libc::F_SETFD, flags | libc::FD_CLOEXEC) < 0 {
+                    return Err(());
+                }
+                let mut address: libc::sockaddr_storage = std::mem::zeroed();
+                let mut address_length = std::mem::size_of_val(&address) as libc::socklen_t;
+                if libc::getsockname(3, (&raw mut address).cast(), &raw mut address_length) != 0
+                    || i32::from(address.ss_family) != libc::AF_UNIX
+                {
+                    return Err(());
+                }
+                let mut kind: libc::c_int = 0;
+                let mut kind_length = std::mem::size_of_val(&kind) as libc::socklen_t;
+                if libc::getsockopt(
+                    3,
+                    libc::SOL_SOCKET,
+                    libc::SO_TYPE,
+                    (&raw mut kind).cast(),
+                    &raw mut kind_length,
+                ) != 0
+                    || kind != libc::SOCK_STREAM
+                {
+                    return Err(());
+                }
+                // std accounts for Darwin's padded unnamed sockaddr length and
+                // distinguishes Linux abstract names from anonymous socketpairs.
+                let inspection = UnixStream::from(
+                    BorrowedFd::borrow_raw(3)
+                        .try_clone_to_owned()
+                        .map_err(|_| ())?,
+                );
+                if !inspection.local_addr().map_err(|_| ())?.is_unnamed()
+                    || !inspection.peer_addr().map_err(|_| ())?.is_unnamed()
+                {
+                    return Err(());
+                }
+                let stream = UnixStream::from_raw_fd(3);
+                stream.set_nonblocking(true).map_err(|_| ())?;
+                Ok(stream)
+            }
+        });
+    }
+
+    pub(super) fn stream() -> Result<tokio::net::UnixStream, ()> {
+        // Never initialize lazily: that could allow an earlier child to inherit
+        // the control endpoint. A non-CLI entrypoint must initialize explicitly.
+        let stream = SOCKET.get().ok_or(())?.as_ref().map_err(|_| ())?;
+        tokio::net::UnixStream::from_std(stream.try_clone().map_err(|_| ())?).map_err(|_| ())
+    }
+}
+
+pub fn native_operation_barrier_info() -> &'static str {
+    include_str!("native_operation_barrier_manifest.json")
+}
+
+/// Internal CLI bootstrap only; no public app-server protocol addition.
+pub fn initialize_native_operation_barrier() {
+    #[cfg(unix)]
+    socket::initialize();
+}
+
+#[cfg(unix)]
+struct Transport {
+    stream: Mutex<BufReader<tokio::net::UnixStream>>,
+    poisoned: AtomicBool,
+}
+
+#[cfg(unix)]
+struct InFlightExchange<'a> {
+    poisoned: &'a AtomicBool,
+    complete: bool,
+}
+
+#[cfg(unix)]
+impl Drop for InFlightExchange<'_> {
+    fn drop(&mut self) {
+        if !self.complete {
+            self.poisoned.store(true, Ordering::Release);
+            CHANNEL_POISONED.store(true, Ordering::Release);
+        }
+    }
+}
+
+#[cfg(unix)]
+impl Transport {
+    #[allow(
+        clippy::await_holding_invalid_type,
+        reason = "The bounded private socket exchange must serialize each complete request and receipt"
+    )]
+    async fn exchange<T: Serialize + Sync, R: serde::de::DeserializeOwned>(
+        &self,
+        request: &T,
+        validate: impl Fn(&R, &T, u64) -> Result<(), BarrierError> + Send + Sync,
+    ) -> Result<R, BarrierError> {
+        let exchange = async {
+            let mut stream = self.stream.lock().await;
+            if self.poisoned.load(Ordering::Acquire) {
+                return Err(BarrierError);
+            }
+            let mut request_bytes = serde_json::to_vec(request).map_err(|_| BarrierError)?;
+            request_bytes.push(b'\n');
+            if request_bytes.len() > MAX_FRAME_BYTES {
+                return Err(BarrierError);
+            }
+            // A cancelled caller may have partially written or consumed a frame.
+            // Poison before releasing the serialized socket, including task abort.
+            let mut in_flight = InFlightExchange {
+                poisoned: &self.poisoned,
+                complete: false,
+            };
+            stream
+                .get_mut()
+                .write_all(&request_bytes)
+                .await
+                .map_err(|_| BarrierError)?;
+            let mut bytes = Vec::new();
+            loop {
+                if bytes.len() >= MAX_FRAME_BYTES {
+                    return Err(BarrierError);
+                }
+                let byte = stream.read_u8().await.map_err(|_| BarrierError)?;
+                bytes.push(byte);
+                if byte == b'\n' {
+                    break;
+                }
+            }
+            let response: R = serde_json::from_slice(&bytes).map_err(|_| BarrierError)?;
+            validate(&response, request, now_ms()?)?;
+            in_flight.complete = true;
+            Ok(response)
+        };
+        let result = tokio::time::timeout(EXCHANGE_TIMEOUT, exchange)
+            .await
+            .map_err(|_| BarrierError)
+            .and_then(|value| value);
+        if result.is_err() {
+            self.poisoned.store(true, Ordering::Release);
+            CHANNEL_POISONED.store(true, Ordering::Release);
+        }
+        if CHANNEL_POISONED.load(Ordering::Acquire) {
+            return Err(BarrierError);
+        }
+        result
+    }
+}
+
+async fn exchange(request: &Request) -> Result<Response, BarrierError> {
+    exchange_validated(request, Response::validate).await
+}
+
+pub(crate) async fn exchange_validated<T: Serialize + Sync, R: serde::de::DeserializeOwned>(
+    request: &T,
+    validate: impl Fn(&R, &T, u64) -> Result<(), BarrierError> + Send + Sync,
+) -> Result<R, BarrierError> {
+    #[cfg(unix)]
+    {
+        static TRANSPORT: OnceLock<Result<Transport, ()>> = OnceLock::new();
+        let transport = TRANSPORT
+            .get_or_init(|| {
+                Ok(Transport {
+                    stream: Mutex::new(BufReader::with_capacity(
+                        MAX_FRAME_BYTES,
+                        socket::stream()?,
+                    )),
+                    poisoned: AtomicBool::new(false),
+                })
+            })
+            .as_ref()
+            .map_err(|_| BarrierError)?;
+        transport.exchange(request, validate).await
+    }
+    #[cfg(not(unix))]
+    {
+        let _ = (request, validate);
+        Err(BarrierError)
+    }
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct Attempt(Arc<AttemptInner>);
+
+#[derive(Debug)]
+struct AttemptInner {
+    identity: Identity,
+    permit_id: Uuid,
+    expires_at: u64,
+    source_owner: SourceOwner,
+    cancelled: CancellationToken,
+    state: Mutex<AttemptState>,
+    started_notification: tokio::sync::Notify,
+}
+
+#[derive(Debug, Default)]
+struct AttemptState {
+    started: bool,
+    finished: bool,
+    background: bool,
+}
+
+tokio::task_local! { static CURRENT: Attempt; }
+
+impl Attempt {
+    pub(crate) async fn begin(
+        identity: Identity,
+        cancelled: CancellationToken,
+    ) -> Result<Self, BarrierError> {
+        if !identity.valid() || cancelled.is_cancelled() {
+            return Err(BarrierError);
+        }
+        let request = Request {
+            schema_version: 1,
+            request_id: Uuid::new_v4(),
+            phase: Phase::Intent,
+            identity: identity.clone(),
+            occurred_at: now_ms()?,
+            permit_id: None,
+            outcome: None,
+            reason: None,
+        };
+        let response = exchange(&request).await?;
+        if response.decision != "permit" {
+            return Err(BarrierError);
+        }
+        let source_owner = response.source_owner.ok_or(BarrierError)?;
+        crate::native_sources::remember_owner(&identity, &source_owner)?;
+        let attempt = Self(Arc::new(AttemptInner {
+            identity,
+            permit_id: response.permit_id.ok_or(BarrierError)?,
+            expires_at: response.expires_at.ok_or(BarrierError)?,
+            source_owner,
+            cancelled,
+            state: Mutex::new(AttemptState::default()),
+            started_notification: tokio::sync::Notify::new(),
+        }));
+        if attempt.check_dispatch().is_err() {
+            let reason = if attempt.0.cancelled.is_cancelled() {
+                Reason::CancelledBeforeDispatch
+            } else {
+                Reason::AuthorizationUnavailable
+            };
+            attempt.finish(Outcome::Failed, Some(reason)).await?;
+            return Err(BarrierError);
+        }
+        Ok(attempt)
+    }
+
+    pub(crate) fn identity(&self) -> &Identity {
+        &self.0.identity
+    }
+
+    pub(crate) fn permit_id(&self) -> Uuid {
+        self.0.permit_id
+    }
+
+    pub(crate) fn source_owner(&self) -> &SourceOwner {
+        &self.0.source_owner
+    }
+
+    pub(crate) async fn check_source_submission(&self) -> Result<(), BarrierError> {
+        let state = self.0.state.lock().await;
+        if state.finished
+            || self.0.cancelled.is_cancelled()
+            || CHANNEL_POISONED.load(Ordering::Acquire)
+        {
+            return Err(BarrierError);
+        }
+        if state.started {
+            Ok(())
+        } else {
+            self.check_dispatch()
+        }
+    }
+
+    pub(crate) fn check_dispatch(&self) -> Result<(), BarrierError> {
+        if CHANNEL_POISONED.load(Ordering::Acquire)
+            || self.0.cancelled.is_cancelled()
+            || now_ms()? >= self.0.expires_at
+        {
+            return Err(BarrierError);
+        }
+        Ok(())
+    }
+
+    pub(crate) async fn scope<T>(&self, work: impl Future<Output = T>) -> T {
+        CURRENT.scope(self.clone(), work).await
+    }
+
+    pub(crate) async fn started(&self) -> Result<(), BarrierError> {
+        self.started_at(SystemTime::now()).await
+    }
+
+    #[allow(
+        clippy::await_holding_invalid_type,
+        reason = "The private attempt state remains serialized until the bounded started receipt is durable"
+    )]
+    pub(crate) async fn started_at(&self, timestamp: SystemTime) -> Result<(), BarrierError> {
+        let occurred_at = u64::try_from(
+            timestamp
+                .duration_since(UNIX_EPOCH)
+                .map_err(|_| BarrierError)?
+                .as_millis(),
+        )
+        .map_err(|_| BarrierError)?;
+        let mut state = self.0.state.lock().await;
+        if state.finished {
+            return Err(BarrierError);
+        }
+        if state.started {
+            return Ok(());
+        }
+        let request = Request {
+            schema_version: 1,
+            request_id: Uuid::new_v4(),
+            phase: Phase::Started,
+            identity: self.0.identity.clone(),
+            occurred_at,
+            permit_id: Some(self.0.permit_id),
+            outcome: None,
+            reason: None,
+        };
+        exchange(&request).await?;
+        state.started = true;
+        self.0.started_notification.notify_waiters();
+        Ok(())
+    }
+
+    pub(crate) async fn await_started_receipt(&self) -> Result<(), BarrierError> {
+        tokio::time::timeout(EXCHANGE_TIMEOUT, async {
+            let notified = self.0.started_notification.notified();
+            tokio::pin!(notified);
+            notified.as_mut().enable();
+            if !self.0.state.lock().await.started {
+                notified.await;
+            }
+            if self.0.state.lock().await.started {
+                Ok(())
+            } else {
+                Err(BarrierError)
+            }
+        })
+        .await
+        .map_err(|_| BarrierError)?
+    }
+
+    pub(crate) async fn background(&self) {
+        self.0.state.lock().await.background = true;
+    }
+
+    #[allow(
+        clippy::await_holding_invalid_type,
+        reason = "The private attempt state remains serialized until the bounded terminal receipt is durable"
+    )]
+    pub(crate) async fn finish(
+        &self,
+        outcome: Outcome,
+        reason: Option<Reason>,
+    ) -> Result<(), BarrierError> {
+        let mut state = self.0.state.lock().await;
+        if state.finished {
+            return Ok(());
+        }
+        let request = Request {
+            schema_version: 1,
+            request_id: Uuid::new_v4(),
+            phase: Phase::Outcome,
+            identity: self.0.identity.clone(),
+            occurred_at: now_ms()?,
+            permit_id: Some(self.0.permit_id),
+            outcome: Some(outcome),
+            reason,
+        };
+        exchange(&request).await?;
+        state.finished = true;
+        Ok(())
+    }
+
+    pub(crate) async fn finish_runtime(&self, success: bool) -> Result<(), BarrierError> {
+        let started = {
+            let state = self.0.state.lock().await;
+            if state.finished || state.background {
+                return Ok(());
+            }
+            state.started
+        };
+        let outcome = if success && started {
+            Outcome::Completed
+        } else if started {
+            Outcome::Unknown
+        } else {
+            Outcome::Failed
+        };
+        let reason = match outcome {
+            Outcome::Completed => None,
+            Outcome::Failed => Some(Reason::ExecutionFailed),
+            Outcome::Unknown => Some(Reason::DispatchUnconfirmed),
+        };
+        self.finish(outcome, reason).await?;
+        if success && !started {
+            // A missing leaf receipt must never allow successful model consumption.
+            return Err(BarrierError);
+        }
+        Ok(())
+    }
+}
+
+pub(crate) struct McpFactory {
+    pub identity: Identity,
+    pub cancelled: CancellationToken,
+}
+impl codex_rmcp_client::NativeMcpFactory for McpFactory {
+    fn begin(
+        &self,
+    ) -> std::pin::Pin<
+        Box<
+            dyn Future<Output = std::io::Result<Arc<dyn codex_rmcp_client::NativeMcpAttempt>>>
+                + Send
+                + '_,
+        >,
+    > {
+        Box::pin(async {
+            let mut identity = self.identity.clone();
+            identity.attempt_ref = Uuid::new_v4();
+            let attempt = Attempt::begin(identity, self.cancelled.clone())
+                .await
+                .map_err(std::io::Error::other)?;
+            Ok(Arc::new(attempt) as Arc<dyn codex_rmcp_client::NativeMcpAttempt>)
+        })
+    }
+}
+impl codex_rmcp_client::NativeMcpAttempt for Attempt {
+    fn check_dispatch(&self) -> std::io::Result<()> {
+        Attempt::check_dispatch(self).map_err(std::io::Error::other)
+    }
+    fn started(&self) -> std::pin::Pin<Box<dyn Future<Output = std::io::Result<()>> + Send + '_>> {
+        Box::pin(async { self.started().await.map_err(std::io::Error::other) })
+    }
+    fn finish(
+        &self,
+        result: codex_rmcp_client::NativeMcpResult,
+    ) -> std::pin::Pin<Box<dyn Future<Output = std::io::Result<()>> + Send + '_>> {
+        Box::pin(async move {
+            let (outcome, reason) = match result {
+                codex_rmcp_client::NativeMcpResult::Completed => {
+                    self.await_started_receipt()
+                        .await
+                        .map_err(std::io::Error::other)?;
+                    (Outcome::Completed, None)
+                }
+                codex_rmcp_client::NativeMcpResult::CancelledBeforeDispatch => {
+                    (Outcome::Failed, Some(Reason::CancelledBeforeDispatch))
+                }
+                codex_rmcp_client::NativeMcpResult::Failed => {
+                    self.await_started_receipt()
+                        .await
+                        .map_err(std::io::Error::other)?;
+                    (Outcome::Failed, Some(Reason::ExecutionFailed))
+                }
+                codex_rmcp_client::NativeMcpResult::UnconfirmedResponse => {
+                    self.await_started_receipt()
+                        .await
+                        .map_err(std::io::Error::other)?;
+                    (Outcome::Unknown, Some(Reason::ResultUnconfirmed))
+                }
+                codex_rmcp_client::NativeMcpResult::Unknown => {
+                    (Outcome::Unknown, Some(Reason::ResultUnconfirmed))
+                }
+            };
+            self.finish(outcome, reason)
+                .await
+                .map_err(std::io::Error::other)
+        })
+    }
+}
+
+impl codex_apply_patch::NativePatchDispatch for Attempt {
+    fn check_dispatch(&self) -> std::io::Result<()> {
+        Attempt::check_dispatch(self).map_err(std::io::Error::other)
+    }
+
+    fn dispatched(
+        &self,
+    ) -> std::pin::Pin<Box<dyn Future<Output = std::io::Result<()>> + Send + '_>> {
+        Box::pin(async { self.started().await.map_err(std::io::Error::other) })
+    }
+}
+
+pub(crate) fn current() -> Result<Attempt, BarrierError> {
+    CURRENT.try_with(Clone::clone).map_err(|_| BarrierError)
+}
