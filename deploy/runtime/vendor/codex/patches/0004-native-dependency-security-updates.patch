+                HickoryDnsResolver::builder()
+                    .with_options(resolver::config::ResolverOpts::default())
+                    .try_build()
+            });
+        match result {
+            Ok(resolver) => Some(resolver),
+            Err(err) => {
+                tracing::error!("failed to initialize Hickory DNS: {err}");
+                None
+            }
+        }
