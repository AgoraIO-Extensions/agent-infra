+        let file = std::fs::File::open("/dev/null").expect("valid source descriptor");
+        // pidfd_open is deliberately allowed; pidfd_getfd must still be denied.
+        let raw_pidfd = unsafe { libc::syscall(libc::SYS_pidfd_open, libc::getpid(), 0u32) };
+        assert!(raw_pidfd >= 0, "kernel must support the actual pidfd probe");
+        let pidfd = unsafe { OwnedFd::from_raw_fd(raw_pidfd as i32) };
+        let attributes = PerfEventAttr {
+            kind: 1, // PERF_TYPE_SOFTWARE
+            size: std::mem::size_of::<PerfEventAttr>() as u32,
+            sample_period: 1000,
+            sample_type: (1 << 12) | (1 << 13), // REGS_USER | STACK_USER
+            flags: 1 | (1 << 5) | (1 << 6),     // disabled, exclude_kernel, exclude_hv
+            sample_regs_user: (1 << 33) - 1,    // aarch64 x0..x29, lr, sp, pc
+            sample_stack_user: 64,
+            ..Default::default()
+        };
+        let mut observations = Vec::new();
+        for syscall in [
+            libc::SYS_ptrace,
+            libc::SYS_process_vm_readv,
+            libc::SYS_process_vm_writev,
+            libc::SYS_pidfd_getfd,
+            libc::SYS_perf_event_open,
+        ] {
+            let result = unsafe {
+                if syscall == libc::SYS_ptrace {
+                    libc::syscall(syscall, libc::PTRACE_PEEKDATA, libc::getpid(), 0, 0)
+                } else if syscall == libc::SYS_pidfd_getfd {
+                    libc::syscall(syscall, pidfd.as_raw_fd(), file.as_raw_fd(), 0u32)
+                } else if syscall == libc::SYS_perf_event_open {
+                    libc::syscall(
+                        syscall,
+                        &raw const attributes,
+                        libc::getpid(),
+                        -1i32,
+                        -1i32,
+                        8u64,
+                    )
+                } else {
+                    libc::syscall(
+                        syscall,
+                        libc::getpid(),
+                        &raw const local_vector,
+                        1usize,
+                        &raw const remote_vector,
+                        1usize,
+                        0usize,
+                    )
+                }
+            };
+            observations.push((result, std::io::Error::last_os_error().raw_os_error()));
+        }
+        assert_eq!(observations, vec![(-1, Some(libc::EPERM)); 5]);
+        assert_eq!(local, [0u8; 32]);
+    }
+
+    #[test]
+    fn memory_filter_is_inherited_and_preserves_http_and_stop() {
+        run_child("installed_filter_child");
+    }
+
+    #[test]
+    #[ignore = "isolated child; invoked by memory_filter_is_inherited_and_preserves_http_and_stop"]
+    fn installed_filter_child() {
+        // This sibling predates installation and therefore exercises TSYNC,
+        // not just fork inheritance from the installing thread.
+        let (ready, receive) = mpsc::sync_channel(/*bound*/ 0);
+        let sibling = std::thread::spawn(move || {
+            receive.recv().expect("filter installation completed");
+            assert_memory_syscalls_denied();
+        });
+        install_native_memory_filter().expect("install all-thread memory filter");
+        ready.send(()).expect("release existing sibling");
+        assert_memory_syscalls_denied();
+        sibling.join().expect("existing sibling observes filter");
+        run_child("inherited_filter_child");
+
+        let listener = TcpListener::bind((Ipv4Addr::LOCALHOST, 0)).expect("HTTP listener");
+        let endpoint = listener.local_addr().expect("HTTP endpoint");
+        let server = std::thread::spawn(move || {
+            let (mut stream, _) = listener.accept().expect("accept HTTP request");
+            stream
+                .set_read_timeout(Some(Duration::from_secs(/*secs*/ 5)))
+                .expect("bound HTTP request read");
+            let expected = b"GET / HTTP/1.1\r\nHost: localhost\r\n\r\n";
+            let mut request = vec![0u8; expected.len()];
+            stream.read_exact(&mut request).expect("read HTTP request");
+            assert_eq!(request, expected);
+            stream
+                .write_all(b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok")
+                .expect("write HTTP response");
+        });
+        let mut stream = TcpStream::connect_timeout(&endpoint, Duration::from_secs(/*secs*/ 5))
+            .expect("connect after memory filter");
+        stream
+            .set_read_timeout(Some(Duration::from_secs(/*secs*/ 5)))
+            .expect("bound HTTP response read");
+        stream
+            .write_all(b"GET / HTTP/1.1\r\nHost: localhost\r\n\r\n")
+            .expect("send HTTP request");
+        let mut response = String::new();
+        stream.read_to_string(&mut response).expect("HTTP response");
+        assert_eq!(response, "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok");
+        server.join().expect("HTTP server finished");
+
+        let mut child = Command::new("/bin/sh")
+            .args(["-c", "exec sleep 30"])
+            .spawn()
+            .expect("start tool process");
+        child.kill().expect("stop remains allowed");
+        assert!(!child.wait().expect("reap stopped tool").success());
+    }
+
+    #[test]
+    #[ignore = "fork/exec descendant of installed_filter_child"]
+    fn inherited_filter_child() {
+        assert_memory_syscalls_denied();
+    }
+
+    #[test]
+    fn divergent_thread_filter_rejects_tsync_without_fallback() {
+        run_child("divergent_filter_child");
+    }
+
+    #[test]
+    #[ignore = "isolated child; invoked by divergent_thread_filter_rejects_tsync_without_fallback"]
+    fn divergent_filter_child() {
+        let (ready, receive) = mpsc::sync_channel(/*bound*/ 0);
+        let (release, finished) = mpsc::sync_channel(/*bound*/ 0);
+        let sibling = std::thread::spawn(move || {
+            let filter = seccompiler::SeccompFilter::new(
+                Default::default(),
+                seccompiler::SeccompAction::Allow,
+                seccompiler::SeccompAction::Errno(libc::EPERM as u32),
+                seccompiler::TargetArch::aarch64,
+            )
+            .expect("compile sibling filter");
+            let program: seccompiler::BpfProgram = filter.try_into().expect("sibling BPF");
+            seccompiler::apply_filter(&program).expect("make sibling filter diverge");
+            ready.send(()).expect("signal divergent sibling");
+            finished.recv().expect("release divergent sibling");
+        });
+        receive.recv().expect("sibling filter installed");
+        assert!(install_native_memory_filter().is_err());
+        release
+            .send(())
+            .expect("release sibling after TSYNC rejection");
+        sibling.join().expect("divergent sibling finished");
+    }
+}
