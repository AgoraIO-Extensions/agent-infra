-fn protocol_headers(headers: &HeaderMap) -> Vec<HttpHeader> {
-    headers
-        .iter()
-        .filter_map(|(name, value)| {
-            Some(HttpHeader {
-                name: name.as_str().to_string(),
-                value: std::str::from_utf8(value.as_bytes()).ok()?.to_string(),
-                value_env_var: None,
-            })
