-fn retryable_post_response_status(mcp_method: Option<&str>, status: u16) -> bool {
-    let Ok(status) = StatusCode::from_u16(status) else {
-        return false;
-    };
-    is_retryable_http_status(status)
-        && matches!(
-            mcp_method,
-            Some(
-                DiscoverRequestMethod::VALUE
-                    | "initialize"
-                    | "notifications/initialized"
-                    | "tools/list"
