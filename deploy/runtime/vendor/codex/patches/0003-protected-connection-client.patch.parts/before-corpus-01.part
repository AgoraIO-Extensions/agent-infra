+#[test]
+fn shared_corpus_preserves_v1_operation_frames() {
+    let corpus: serde_json::Value = serde_json::from_str(include_str!(
+        "../../rmcp-client/src/native_connection/callback-v2-corpus.json"
+    ))
+    .unwrap();
+    let mut count = 0;
+    for case in corpus["cases"].as_array().unwrap() {
+        let frame = &case["frame"];
+        if frame["schemaVersion"] != 1 || frame["phase"].as_str().unwrap().starts_with("source-") {
+            continue;
+        }
+        let valid = if frame.get("decision").is_some() {
+            serde_json::from_value::<Response>(frame.clone()).is_ok_and(|response| {
+                let mut request = request();
+                request.request_id = response.request_id;
+                request.identity = response.identity.clone();
+                response.validate(&request, 1_800_000_000_000).is_ok()
+            })
+        } else {
+            serde_json::from_value::<Request>(frame.clone()).is_ok_and(|request| {
+                request.schema_version == 1
+                    && request.identity.valid()
+                    && request.occurred_at > 0
+                    && request.occurred_at <= 9_007_199_254_740_991
+                    && request.connection_request.is_none()
+                    && request.connection_evidence.is_none()
+                    && match request.phase {
+                        Phase::Intent => {
+                            request.permit_id.is_none()
+                                && request.outcome.is_none()
+                                && request.reason.is_none()
+                        }
+                        Phase::Started => {
+                            request.permit_id.is_some()
+                                && request.outcome.is_none()
+                                && request.reason.is_none()
+                        }
+                        Phase::Outcome => {
+                            request.permit_id.is_some()
+                                && match request.outcome {
+                                    Some(Outcome::Completed) => request.reason.is_none(),
+                                    Some(Outcome::Failed) => matches!(
+                                        request.reason,
+                                        Some(
+                                            Reason::AuthorizationDenied
+                                                | Reason::AuthorizationUnavailable
+                                                | Reason::CancelledBeforeDispatch
+                                                | Reason::ExecutionFailed
+                                                | Reason::ExecutionCancelled
+                                        )
+                                    ),
+                                    Some(Outcome::Unknown) => matches!(
+                                        request.reason,
+                                        Some(
+                                            Reason::DispatchUnconfirmed | Reason::ResultUnconfirmed
+                                        )
+                                    ),
+                                    None => false,
+                                }
+                        }
+                    }
+            })
+        };
+        assert_eq!(
+            valid,
+            case["schemaValid"].as_bool().unwrap(),
+            "{}",
+            case["id"]
+        );
+        count += 1;
+    }
+    assert_eq!(count, 8);
+}
diff --git a/codex-rs/core/src/native_process_protection.rs b/codex-rs/core/src/native_process_protection.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/core/src/native_process_protection.rs
@@ -0,0 +1,39 @@
+//! Installed process protection for the private native credential bootstrap.
+//! This is process-local state, never a manifest claim or public RPC input.
+
+use std::io;
+use std::sync::OnceLock;
+
+static INSTALLED: OnceLock<NativeProcessProtection> = OnceLock::new();
+
+/// Protections actually installed by the synchronous CLI launch path.
+/// Neither variant attests to external filesystem, Node, or image acceptance.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum NativeProcessProtection {
+    /// Native hardening and the all-thread aarch64 memory filter succeeded.
+    LinuxAarch64MemoryFilter,
+    /// Native hardening only; Darwin credential isolation is not established.
+    DarwinHardeningOnly,
+}
+
+/// Record successful installation before the CLI creates threads or helpers.
+/// A credential bootstrap must also check its complete platform profile.
+pub fn record_native_process_protection(profile: NativeProcessProtection) -> io::Result<()> {
+    let supported = match profile {
+        NativeProcessProtection::LinuxAarch64MemoryFilter => {
+            cfg!(all(target_os = "linux", target_arch = "aarch64"))
+        }
+        NativeProcessProtection::DarwinHardeningOnly => cfg!(target_os = "macos"),
+    };
+    if !supported || !crate::native_operation_barrier::private_socket_initialized() {
+        return Err(io::Error::other("Native process protection is unavailable"));
+    }
+    INSTALLED
+        .set(profile)
+        .map_err(|_| io::Error::other("Native process protection is already recorded"))
+}
+
+/// Return only the protection installed in this process, not binary capability.
+pub fn native_process_protection() -> Option<NativeProcessProtection> {
+    INSTALLED.get().copied()
+}
