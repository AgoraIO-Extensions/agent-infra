diff --git a/codex-rs/core/src/native_connection_bootstrap.rs b/codex-rs/core/src/native_connection_bootstrap.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/core/src/native_connection_bootstrap.rs
@@ -0,0 +1,130 @@
+//! CLI-only trusted profile and anonymous FD3 Connection bootstrap.
+use codex_rmcp_client::NativeConnectionBootstrap;
+use codex_rmcp_client::NativeConnectionExchange;
+use serde_json::Value;
+use std::io;
+use std::sync::Arc;
+
+struct PrivateBootstrap;
+impl NativeConnectionBootstrap for PrivateBootstrap {
+    fn exchange<'a>(&'a self, request: &'a Value) -> NativeConnectionExchange<'a> {
+        Box::pin(async move {
+            // This path intentionally avoids durable callback fingerprinting,
+            // replay storage, and any Debug/error rendering of token frames.
+            crate::native_operation_barrier::exchange_validated(
+                request,
+                |response: &Value, request, _now| {
+                    if response.get("schemaVersion") != Some(&Value::from(2))
+                        || response.get("phase") != request.get("phase")
+                        || response.get("requestId") != request.get("requestId")
+                        || !match request.get("phase").and_then(Value::as_str) {
+                            Some("connection-bootstrap" | "connection-recovery") => {
+                                response.get("request") == Some(request)
+                            }
+                            Some("connection-evidence") => {
+                                response.get("decision") == Some(&Value::from("ack"))
+                                    && response.get("identity") == request.get("identity")
+                                    && response.get("connectionRequest")
+                                        == request.get("connectionRequest")
+                            }
+                            _ => false,
+                        }
+                    {
+                        return Err(crate::native_operation_barrier::BarrierError);
+                    }
+                    Ok(())
+                },
+            )
+            .await
+            .map_err(|_| io::Error::other("NATIVE_CONNECTION_UNAVAILABLE"))
+        })
+    }
+}
+/// Synchronous CLI bootstrap before Tokio, plugins, or any helper process.
+pub fn initialize_native_connection_from_args() -> io::Result<()> {
+    let mut arguments = std::env::args_os().skip(1);
+    let mut profile = None;
+    while let Some(argument) = arguments.next() {
+        let text = argument.to_str().unwrap_or("");
+        if text == "--agent-infra-connection-profile" {
+            if profile.is_some() {
+                return Err(io::Error::other("NATIVE_CONNECTION_UNAVAILABLE"));
+            }
+            profile = Some(
+                arguments
+                    .next()
+                    .and_then(|value| value.into_string().ok())
+                    .ok_or_else(|| io::Error::other("NATIVE_CONNECTION_UNAVAILABLE"))?,
+            );
+        } else if let Some(value) = text.strip_prefix("--agent-infra-connection-profile=") {
+            if profile.replace(value.to_owned()).is_some() {
+                return Err(io::Error::other("NATIVE_CONNECTION_UNAVAILABLE"));
+            }
+        }
+    }
+    if let Some(profile) = profile {
+        if crate::native_process_protection()
+            != Some(crate::NativeProcessProtection::LinuxAarch64MemoryFilter)
+            || !crate::native_operation_barrier::private_socket_initialized()
+        {
+            return Err(io::Error::other("NATIVE_CONNECTION_ISOLATION_UNAVAILABLE"));
+        }
+        codex_rmcp_client::initialize_native_connection_profile(
+            &profile,
+            Arc::new(PrivateBootstrap),
+        )?;
+    }
+    Ok(())
+}
+
+/// The private recovery command is a separate process mode, before arg0/helper
+/// dispatch. It cannot be combined with a Session, Turn or app-server command.
+pub fn run_native_connection_recovery_from_args() -> io::Result<bool> {
+    let arguments: Vec<_> = std::env::args_os().skip(1).collect();
+    if !recovery_arguments(&arguments)? {
+        return Ok(false);
+    }
+    if crate::native_process_protection()
+        != Some(crate::NativeProcessProtection::LinuxAarch64MemoryFilter)
+        || !crate::native_operation_barrier::private_socket_initialized()
+    {
+        return Err(io::Error::other("NATIVE_CONNECTION_ISOLATION_UNAVAILABLE"));
+    }
+    tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()?
+        .block_on(codex_rmcp_client::run_native_connection_recovery())?;
+    Ok(true)
+}
+fn recovery_arguments(arguments: &[std::ffi::OsString]) -> io::Result<bool> {
+    const MODE: &str = "--agent-infra-connection-recovery";
+    if !arguments.iter().any(|value| value == MODE) {
+        return Ok(false);
+    }
+    let mut mode = false;
+    let mut profile = false;
+    let mut arguments = arguments.iter();
+    while let Some(argument) = arguments.next() {
+        match argument.to_str() {
+            Some(MODE) if !mode => mode = true,
+            Some("--agent-infra-connection-profile") if !profile => {
+                if arguments.next().and_then(|value| value.to_str()).is_none() {
+                    return Err(io::Error::other("NATIVE_CONNECTION_UNAVAILABLE"));
+                }
+                profile = true;
+            }
+            Some(value) if !profile && value.starts_with("--agent-infra-connection-profile=") => {
+                profile = true
+            }
+            _ => return Err(io::Error::other("NATIVE_CONNECTION_UNAVAILABLE")),
+        }
+    }
+    if !mode || !profile {
+        return Err(io::Error::other("NATIVE_CONNECTION_UNAVAILABLE"));
+    }
+    Ok(true)
+}
+
+#[cfg(test)]
+#[path = "native_connection_bootstrap_tests.rs"]
+mod tests;
diff --git a/codex-rs/core/src/native_connection_bootstrap_tests.rs b/codex-rs/core/src/native_connection_bootstrap_tests.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/core/src/native_connection_bootstrap_tests.rs
@@ -0,0 +1,47 @@
+use super::recovery_arguments;
+use std::ffi::OsString;
+
+#[test]
+fn recovery_mode_cannot_enter_a_business_command() {
+    let arguments = |values: &[&str]| {
+        values
+            .iter()
+            .copied()
+            .map(OsString::from)
+            .collect::<Vec<_>>()
+    };
+    assert!(!recovery_arguments(&arguments(&["app-server"])).unwrap());
+    assert!(
+        recovery_arguments(&arguments(&[
+            "--agent-infra-connection-recovery",
+            "--agent-infra-connection-profile",
+            "{}",
+        ]))
+        .unwrap()
+    );
+    for values in [
+        vec!["--agent-infra-connection-recovery"],
+        vec![
+            "--agent-infra-connection-recovery",
+            "--agent-infra-connection-profile",
+        ],
+        vec![
+            "--agent-infra-connection-recovery",
+            "--agent-infra-connection-profile={}",
+            "app-server",
+        ],
+        vec![
+            "--agent-infra-connection-recovery",
+            "--agent-infra-connection-profile={}",
+            "exec",
+            "prompt",
+        ],
+        vec![
+            "--agent-infra-connection-recovery",
+            "--agent-infra-connection-profile={}",
+            "--agent-infra-connection-recovery",
+        ],
+    ] {
+        assert!(recovery_arguments(&arguments(&values)).is_err());
+    }
+}
diff --git a/codex-rs/core/src/native_mcp_dispatch.rs b/codex-rs/core/src/native_mcp_dispatch.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/core/src/native_mcp_dispatch.rs
@@ -0,0 +1,160 @@
+//! MCP-specific private attempts, including original Connection evidence.
+use super::*;
+
+impl codex_rmcp_client::NativeMcpFactory for McpFactory {
+    fn begin_connection(
+        &self,
+        descriptor: serde_json::Value,
+    ) -> std::pin::Pin<
+        Box<
+            dyn Future<Output = std::io::Result<Arc<dyn codex_rmcp_client::NativeMcpAttempt>>>
+                + Send
+                + '_,
+        >,
+    > {
+        Box::pin(async move {
+            let mut identity = self.identity.clone();
+            identity.attempt_ref = Uuid::new_v4();
+            let tool = descriptor
+                .get("toolName")
+                .and_then(serde_json::Value::as_str)
+                .ok_or_else(|| std::io::Error::other(BarrierError))?;
+            if identity.tool_name != format!("connection/{tool}") {
+                return Err(std::io::Error::other(BarrierError));
+            }
+            let attempt =
+                Attempt::begin_with_connection(identity, self.cancelled.clone(), Some(descriptor))
+                    .await
+                    .map_err(std::io::Error::other)?;
+            Ok(Arc::new(attempt) as Arc<dyn codex_rmcp_client::NativeMcpAttempt>)
+        })
+    }
+    fn begin(
+        &self,
+    ) -> std::pin::Pin<
+        Box<
+            dyn Future<Output = std::io::Result<Arc<dyn codex_rmcp_client::NativeMcpAttempt>>>
+                + Send
+                + '_,
+        >,
+    > {
+        Box::pin(async {
+            let mut identity = self.identity.clone();
+            identity.attempt_ref = Uuid::new_v4();
+            let attempt = Attempt::begin(identity, self.cancelled.clone())
+                .await
+                .map_err(std::io::Error::other)?;
+            Ok(Arc::new(attempt) as Arc<dyn codex_rmcp_client::NativeMcpAttempt>)
+        })
+    }
+}
+impl codex_rmcp_client::NativeMcpAttempt for Attempt {
+    #[allow(
+        clippy::await_holding_invalid_type,
+        reason = "Terminal metadata is serialized through its bounded durable receipt"
+    )]
+    fn update_connection_evidence(
+        &self,
+        evidence: serde_json::Value,
+    ) -> std::pin::Pin<Box<dyn Future<Output = std::io::Result<()>> + Send + '_>> {
+        Box::pin(async move {
+            let mut state = self.0.state.lock().await;
+            if !state.finished
+                || self
+                    .0
+                    .connection_request
+                    .as_ref()
+                    .is_none_or(|v| v["toolName"] != "execute_action")
+                || evidence["verification"] != "verified"
+            {
+                return Err(std::io::Error::other(BarrierError));
+            }
+            if state
+                .connection_evidence
+                .as_ref()
+                .is_some_and(|v| v["verification"] == "verified")
+            {
+                return Ok(());
+            }
+            let request = serde_json::json!({"schemaVersion":2,"requestId":Uuid::new_v4(),"phase":"connection-evidence",
+                "identity":self.0.identity,"permitId":self.0.permit_id,"occurredAt":now_ms().map_err(std::io::Error::other)?,
+                "connectionRequest":self.0.connection_request,"connectionEvidence":evidence});
+            exchange_validated(&request, |response: &serde_json::Value, request, _| {
+                if response["schemaVersion"] != 2
+                    || response["phase"] != "connection-evidence"
+                    || response["decision"] != "ack"
+                    || response["requestId"] != request["requestId"]
+                    || response["identity"] != request["identity"]
+                    || response["connectionRequest"] != request["connectionRequest"]
+                {
+                    return Err(BarrierError);
+                }
+                Ok(())
+            })
+            .await
+            .map_err(std::io::Error::other)?;
+            state.connection_evidence = Some(evidence);
+            Ok(())
+        })
+    }
+    fn finish_connection(
+        &self,
+        result: codex_rmcp_client::NativeMcpResult,
+        evidence: Option<serde_json::Value>,
+    ) -> std::pin::Pin<Box<dyn Future<Output = std::io::Result<()>> + Send + '_>> {
+        Box::pin(async move {
+            if self.0.connection_request.is_none() {
+                return Err(std::io::Error::other(BarrierError));
+            }
+            {
+                let mut state = self.0.state.lock().await;
+                if let Some(evidence) = evidence {
+                    state.connection_evidence = Some(evidence);
+                }
+            }
+            <Self as codex_rmcp_client::NativeMcpAttempt>::finish(self, result).await
+        })
+    }
+    fn check_dispatch(&self) -> std::io::Result<()> {
+        Attempt::check_dispatch(self).map_err(std::io::Error::other)
+    }
+    fn started(&self) -> std::pin::Pin<Box<dyn Future<Output = std::io::Result<()>> + Send + '_>> {
+        Box::pin(async { self.started().await.map_err(std::io::Error::other) })
+    }
+    fn finish(
+        &self,
+        result: codex_rmcp_client::NativeMcpResult,
+    ) -> std::pin::Pin<Box<dyn Future<Output = std::io::Result<()>> + Send + '_>> {
+        Box::pin(async move {
+            let (outcome, reason) = match result {
+                codex_rmcp_client::NativeMcpResult::Completed => {
+                    self.await_started_receipt()
+                        .await
+                        .map_err(std::io::Error::other)?;
+                    (Outcome::Completed, None)
+                }
+                codex_rmcp_client::NativeMcpResult::CancelledBeforeDispatch => {
+                    (Outcome::Failed, Some(Reason::CancelledBeforeDispatch))
+                }
+                codex_rmcp_client::NativeMcpResult::Failed => {
+                    self.await_started_receipt()
+                        .await
+                        .map_err(std::io::Error::other)?;
+                    (Outcome::Failed, Some(Reason::ExecutionFailed))
+                }
+                codex_rmcp_client::NativeMcpResult::UnconfirmedResponse => {
+                    self.await_started_receipt()
+                        .await
+                        .map_err(std::io::Error::other)?;
+                    (Outcome::Unknown, Some(Reason::ResultUnconfirmed))
+                }
+                codex_rmcp_client::NativeMcpResult::Unknown => {
+                    (Outcome::Unknown, Some(Reason::ResultUnconfirmed))
+                }
+            };
+            self.finish(outcome, reason)
+                .await
+                .map_err(std::io::Error::other)
+        })
+    }
+}
