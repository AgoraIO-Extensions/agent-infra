diff --git a/codex-rs/linux-sandbox/src/memory.rs b/codex-rs/linux-sandbox/src/memory.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/linux-sandbox/src/memory.rs
@@ -0,0 +1,55 @@
+//! Process-memory restrictions for a private Agent Infra native launch.
+//!
+//! This filter deliberately leaves network and process-control syscalls alone.
+//! The launcher's filesystem isolation and the credential holders' hardening
+//! remain required; seccomp alone is not a complete process boundary.
+
+use codex_protocol::error::Result;
+
+/// Install the inherited memory filter on every existing thread.
+///
+/// Call before accepting credentials or starting helpers. TSYNC errors are
+/// fatal; never retry with a current-thread-only filter. The first profile is
+/// aarch64-only because the pinned seccompiler does not reject the x32 ABI.
+#[cfg(target_arch = "aarch64")]
+pub fn install_native_memory_filter() -> Result<()> {
+    use codex_protocol::error::SandboxErr;
+    use seccompiler::BpfProgram;
+    use seccompiler::SeccompAction;
+    use seccompiler::SeccompFilter;
+    use seccompiler::TargetArch;
+
+    let rules = [
+        libc::SYS_ptrace,
+        libc::SYS_process_vm_readv,
+        libc::SYS_process_vm_writev,
+        libc::SYS_pidfd_getfd,
+        // Do not depend on a container runtime's optional perf restrictions to
+        // prevent register and user-stack sampling of credential holders.
+        libc::SYS_perf_event_open,
+    ]
+    .into_iter()
+    .map(|syscall| (syscall, Vec::new()))
+    .collect();
+    let filter = SeccompFilter::new(
+        rules,
+        SeccompAction::Allow,
+        SeccompAction::Errno(libc::EPERM as u32),
+        TargetArch::aarch64,
+    )
+    .map_err(SandboxErr::from)?;
+    let program: BpfProgram = filter.try_into().map_err(SandboxErr::from)?;
+    seccompiler::apply_filter_all_threads(&program).map_err(SandboxErr::from)?;
+    Ok(())
+}
+
+#[cfg(not(target_arch = "aarch64"))]
+pub fn install_native_memory_filter() -> Result<()> {
+    Err(codex_protocol::error::CodexErr::UnsupportedOperation(
+        "The private native memory profile requires Linux aarch64".to_owned(),
+    ))
+}
+
+#[cfg(test)]
+#[path = "memory_tests.rs"]
+mod tests;
diff --git a/codex-rs/linux-sandbox/src/memory_tests.rs b/codex-rs/linux-sandbox/src/memory_tests.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/linux-sandbox/src/memory_tests.rs
@@ -0,0 +1,227 @@
+#![allow(
+    clippy::expect_used,
+    reason = "Isolated test children must fail at the actual syscall or transport assertion"
+)]
+
+use super::install_native_memory_filter;
+
+#[cfg(not(target_arch = "aarch64"))]
+#[test]
+fn unsupported_architecture_does_not_install_a_partial_profile() {
+    assert!(matches!(
+        install_native_memory_filter(),
+        Err(codex_protocol::error::CodexErr::UnsupportedOperation(_))
+    ));
+}
+
+#[cfg(target_arch = "aarch64")]
+mod aarch64 {
+    use super::install_native_memory_filter;
+    use pretty_assertions::assert_eq;
+    use std::io::Read;
+    use std::io::Write;
+    use std::net::Ipv4Addr;
+    use std::net::TcpListener;
+    use std::net::TcpStream;
+    use std::os::fd::AsRawFd;
+    use std::os::fd::FromRawFd;
+    use std::os::fd::OwnedFd;
+    use std::process::Command;
+    use std::sync::mpsc;
+    use std::time::Duration;
+
+    fn run_child(test: &str) {
+        let selector = format!("memory::tests::aarch64::{test}");
+        let output = Command::new(std::env::current_exe().expect("test executable"))
+            .args(["--exact", &selector, "--ignored", "--test-threads=1"])
+            .output()
+            .expect("run isolated seccomp child");
+        assert!(
+            output.status.success(),
+            "isolated seccomp child failed: {} {}",
+            String::from_utf8_lossy(&output.stdout),
+            String::from_utf8_lossy(&output.stderr),
+        );
+    }
+
+    // Linux's PERF_ATTR_SIZE_VER3 prefix, including user register/stack sampling.
+    #[derive(Default)]
+    #[repr(C)]
+    struct PerfEventAttr {
+        kind: u32,
+        size: u32,
+        config: u64,
+        sample_period: u64,
+        sample_type: u64,
+        read_format: u64,
+        flags: u64,
+        wakeup_events: u32,
+        bp_type: u32,
+        config1: u64,
+        config2: u64,
+        branch_sample_type: u64,
+        sample_regs_user: u64,
+        sample_stack_user: u32,
+        clockid: i32,
+    }
+
+    fn assert_memory_syscalls_denied() {
+        let mut local = [0u8; 32];
+        let mut remote = [0x5au8; 32];
+        let local_vector = libc::iovec {
+            iov_base: local.as_mut_ptr().cast(),
+            iov_len: local.len(),
+        };
+        let remote_vector = libc::iovec {
+            iov_base: remote.as_mut_ptr().cast(),
+            iov_len: remote.len(),
+        };
