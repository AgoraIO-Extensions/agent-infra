      "format": "just fmt; passed with just 1.58.0 and dotslash 0.5.8",
      "nativeProtocolTests": "just test -p codex-core --locked --lib with native and original lifecycle filters; 23 passed, 2436 skipped; two original queue tests repeated after Darwin AF_UNIX validation: 2 passed, 2457 skipped",
      "nativeHooksTests": "just test -p codex-hooks --locked --lib native_barrier_tests; 11 passed, 175 skipped; includes real command spawn/terminal and queued async hook drain/cancellation",
      "nativeCoreLint": "just fix -p codex-core --locked --lib, then just clippy -p codex-core --locked --lib; final check passed including upstream recipe --tests",
      "nativeHooksLint": "just fix -p codex-hooks --locked --lib; passed including upstream recipe --tests",
      "scope": "historical Rust 1.95.0 evidence for patches 0001 and 0002 only; excludes current patches 0003 through 0008"
    }
  },
