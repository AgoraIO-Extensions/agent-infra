FROM node@sha256:3638d9a6fe4030bd716be989438248074489337ba3275657f93595428be4fc03
ARG SOURCE_COMMIT
LABEL org.opencontainers.image.revision=$SOURCE_COMMIT
LABEL org.opencontainers.image.source="https://github.com/AgoraIO-Extensions/agent-infra"
COPY --chown=node:node tests/fixtures/custom-agent-web/signed-server.ts tests/fixtures/custom-agent-web/snapshot-business.ts /app/
LABEL io.agora.agent.runtime.manifest='{"schemaVersion":1,"interactionMode":"self-managed","service":{"port":3003},"health":{"path":"/healthz"}}'
USER node
EXPOSE 3003
ENTRYPOINT ["node", "/app/signed-server.ts"]
