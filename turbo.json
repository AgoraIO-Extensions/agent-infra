{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**"]
		},
		"check-types": {
			"dependsOn": ["^build", "^check-types"]
		},
		"@agent-infra/platform-store#check-types": {
			"dependsOn": ["build", "^build", "^check-types"]
		},
		"test": {
			"dependsOn": ["^test"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"@agent-infra/web#build": {
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*",
				"$TURBO_ROOT$/docs/guides/user-manual.md"
			],
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"@agent-infra/web#check-types": {
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/guides/user-manual.md"],
			"dependsOn": ["^build", "^check-types"]
		}
	}
}
