{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**"]
		},
		"check-types": {
			"dependsOn": ["^build", "^check-types"]
		},
		"@agent-infra/platform-store#check-types": {
			"dependsOn": ["build", "^build", "^check-types"]
		},
		"@agent-infra/test-support#check-types": {
			"dependsOn": ["build", "^build", "^check-types"]
		},
		"test": {
			"dependsOn": ["^test"],
			"env": ["AGENT_INFRA_RUNTIME_INSTALLED_SKILL"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	},
	"globalPassThroughEnv": [
		"CUSTOM_ENTRY_ROLE",
		"HOSTNAME",
		"CUSTOM_ENTRY_ISSUER",
		"CUSTOM_ENTRY_AUDIENCE",
		"CUSTOM_ENTRY_PUBLIC_KEY"
	]
}
