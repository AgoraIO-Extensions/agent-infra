{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**"]
		},
		"check-types": {
			"dependsOn": ["build", "^build", "^check-types"]
		},
		"test": {
			"dependsOn": ["^test"],
			"env": ["AGENT_INFRA_REAL_CODEX_E2E", "PLATFORM_TEST_DATABASE_URL"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
