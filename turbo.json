{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"test": {
			"dependsOn": ["^test"],
			"env": [
				"CONNECTION_TEST_DATABASE_URL",
				"CONNECTION_BOOTSTRAP_TEST_DATABASE_URL",
				"CONNECTION_APPROVAL_TEST_DATABASE_URL",
				"CONNECTION_POLICY_LIFECYCLE_TEST_DATABASE_URL",
				"CONNECTION_CUTOVER_TEST_DATABASE_URL",
				"CONNECTION_RECONNECT_TEST_DATABASE_URL"
			]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
