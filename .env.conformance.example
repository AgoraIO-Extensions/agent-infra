# Copy to .env.conformance.local for local-only verification, or inject the same
# variables from an approved secret source. Never commit the populated file.
DATABASE_URL=postgresql://connection:REPLACE@postgres.example:5432/connection?sslmode=require
CONNECTION_PUBLIC_BASE_URL=https://connection.example.com
# Local conformance may instead use an exact loopback origin such as
# http://127.0.0.1:3002. Non-loopback deployments require HTTPS.
CONNECTION_IDENTITY_KEY=REPLACE_WITH_CANONICAL_BASE64_32_BYTES
CONNECTION_CREDENTIAL_KEY=REPLACE_WITH_CANONICAL_BASE64_32_BYTES
CONNECTION_DIRECT_CONSUMER_ID=consumer-codex
CONNECTION_DIRECT_CONSUMER_NAME=Codex
GITHUB_OAUTH_CLIENT_ID=REPLACE
GITHUB_OAUTH_CLIENT_SECRET=REPLACE

# Jira Server Token Server configuration. Inject secret values from an approved
# secret source; the access token itself is issued and cached by Connection.
JIRA_TOKEN_SERVER_URL=https://oauth.agoralab.co/oauth/token
JIRA_TOKEN_CLIENT_ID=REPLACE
JIRA_TOKEN_CLIENT_SECRET=REPLACE_FROM_SECRET_MANAGER
JIRA_TOKEN_USERNAME=REPLACE
JIRA_TOKEN_PASSWORD=REPLACE_FROM_SECRET_MANAGER

# Optional real Jira E2E credential for the account under test.
# JIRA_USERNAME=REPLACE
# JIRA_PASSWORD=REPLACE_FROM_SECRET_MANAGER

# Approved Agora profile: private-network ldap:// direct bind, with no fallback.
LDAP_URL=ldap://ldap.agoralab.co
LDAP_ISSUER=urn:connection:identity:company-ldap
LDAP_USERS_BASE_DN=ou=users,dc=agora,dc=org
LDAP_SERVICE_BIND_DN=cn=REPLACE,ou=admin,dc=agora,dc=org
LDAP_SERVICE_BIND_PASSWORD=REPLACE_FROM_SECRET_MANAGER
LDAP_USERNAME_ATTRIBUTE=cn
LDAP_UID_ATTRIBUTE=uid
LDAP_EMAIL_ATTRIBUTE=uid
LDAP_DISPLAY_NAME_ATTRIBUTE=sn
# Optional: set both only when the directory's disabled-account mapping is known.
# LDAP_ACTIVE_ATTRIBUTE=REPLACE
# LDAP_ACTIVE_VALUE=REPLACE
LDAP_CONNECT_TIMEOUT_MS=5000
LDAP_OPERATION_TIMEOUT_MS=8000
